<view class="page">
  <view class="card">
    <view class="title">RC8.14 独立测试工程</view>
    <view class="row"><text class="k">环境</text><text class="v">{{stagingEnv}}</text></view>
    <view class="row"><text class="k">身份状态</text><text class="v">{{identityStatus}}</text></view>
    <view class="row" wx:if="{{identityOk}}"><text class="k">openid</text><text class="v">{{openidMasked}}</text></view>
    <view class="row" wx:if="{{identityOk}}"><text class="k">appid</text><text class="v">{{appid}}</text></view>
    <view class="row" wx:if="{{identityOk}}"><text class="k">环境校验</text><text class="v">{{envVerified ? '✅ 匹配 staging' : '⚠ 未匹配'}}</text></view>
  </view>

  <view class="card">
    <view class="title">步骤 1 · 身份自检</view>
    <button class="btn" bindtap="onIdentityCheck" disabled="{{busy}}">身份自检（stagingIdentityProbe）</button>
  </view>

  <view class="card">
    <view class="title">步骤 1b · 普通登录（仅 login）</view>
    <view class="row warn"><text class="v">⚠ 仅执行普通登录（账号 onboarding）。不创建挑战，不改权益/支付。</text></view>
    <button class="btn" bindtap="onLogin" disabled="{{busy || loginBusy || !identityOk}}">登录（login）</button>
    <view class="row" wx:if="{{loginStatus}}"><text class="k">登录状态</text><text class="v">{{loginStatus}}</text></view>
    <view class="row" wx:if="{{loginOk}}"><text class="k">新用户</text><text class="v">{{isNewUser ? '是' : '否'}}</text></view>
    <view class="row" wx:if="{{loginOk}}"><text class="k">会员</text><text class="v">{{membershipLevel}}</text></view>
  </view>

  <view class="card">
    <view class="title">步骤 2 · 挑战链路</view>
    <button class="btn" bindtap="onStart" disabled="{{busy || !identityOk}}">startChallenge</button>
    <view class="row" wx:if="{{startStatus}}"><text class="k">状态</text><text class="v">{{startStatus}}</text></view>
    <view class="row" wx:if="{{startError}}"><text class="k">失败原因</text><text class="v err">{{startError}}</text></view>
    <view class="row"><text class="k">recordId</text><text class="v">{{recordId || '（空）'}}</text></view>

    <button class="btn" bindtap="onGetEvent" disabled="{{busy || !recordId}}">getChallengeEvent</button>
    <view class="row" wx:if="{{eventLabel}}"><text class="k">当前题目</text><text class="v">{{eventLabel}}</text></view>

    <button class="btn btn-wide" bindtap="onSubmit0" disabled="{{busy || !recordId || !lastEvent}}">submitChallengeChoice（提交第 1 题）</button>
    <view class="row" wx:if="{{submitStatus}}"><text class="k">提交</text><text class="v">{{submitStatus}}</text></view>
  </view>

  <view class="card">
    <view class="title">RC8.14 D10 CAS验证</view>
    <view class="row warn"><text class="v">⚠ 仅隔离 staging 环境（非生产）。固定 recordId + 历史 eventId 提交；诊断当日使用，可能改写题目进度。</text></view>
    <view class="row"><text class="k">目标环境</text><text class="v">{{stagingEnv}}</text></view>

    <view class="row"><text class="k">recordId</text>
      <input class="inp" value="{{d10.recordId}}" bindinput="onD10RecordIdInput" placeholder="CR..." /></view>
    <view class="row"><text class="k">eventId</text>
      <input class="inp" value="{{d10.eventId}}" bindinput="onD10EventIdInput" placeholder="CE012" /></view>
    <view class="row"><text class="k">choiceKey</text>
      <picker mode="selector" range="{{d10.choiceOptions}}" value="{{d10.choiceIndex}}" bindchange="onD10ChoiceChange">
        <view class="picker">{{d10.choiceKey}} ▾</view>
      </picker></view>

    <button class="btn btn-wide" bindtap="onD10Submit" disabled="{{busy || d10.inFlight}}">提交指定选择（SUBMIT_SPECIFIED_CHOICE）</button>
    <button class="btn btn-wide" bindtap="onD10GetEvent" disabled="{{busy || d10.inFlight}}">查当前事件（GET_CURRENT_EVENT · 只读）</button>

    <view class="row"><text class="k">提交前</text><text class="v">{{stagingEnv}} / {{d10.recordId}} / {{d10.eventId}} / {{d10.choiceKey}}</text></view>
    <view class="row" wx:if="{{d10.submitText}}"><text class="k">提交响应</text><text class="v pre">{{d10.submitText}}</text></view>
    <view class="row" wx:if="{{d10.getText}}"><text class="k">GET响应</text><text class="v pre">{{d10.getText}}</text></view>
  </view>

  <view class="card">
    <view class="title">RC8.14 D11 真实并发CAS测试</view>
    <view class="row warn"><text class="v">⚠ 仅隔离 staging（非生产）。同一 recordId + 当前未答 eventId，两个不同 choiceKey 并发提交；只应一个成功。诊断当日使用，会改写题目进度。</text></view>
    <view class="row"><text class="k">目标环境</text><text class="v">{{stagingEnv}}</text></view>
    <view class="row"><text class="k">身份状态</text><text class="v">{{identityStatus}}</text></view>

    <view class="row"><text class="k">recordId</text>
      <input class="inp" value="{{d11.recordId}}" bindinput="onD11RecordIdInput" placeholder="CR..." /></view>
    <view class="row"><text class="k">eventId</text>
      <input class="inp" value="{{d11.eventId}}" bindinput="onD11EventIdInput" placeholder="GAME015" /></view>
    <view class="row"><text class="k">choice A</text>
      <input class="inp" value="{{d11.choiceA}}" bindinput="onD11ChoiceAInput" maxlength="1" placeholder="A" /></view>
    <view class="row"><text class="k">choice B</text>
      <input class="inp" value="{{d11.choiceB}}" bindinput="onD11ChoiceBInput" maxlength="1" placeholder="B" /></view>

    <button class="btn btn-wide" bindtap="onD11VerifyTarget" disabled="{{busy || d11.inFlight || d11.verifying || !identityOk}}">VERIFY_TARGET（校验当前未答事件）</button>
    <view class="row" wx:if="{{d11.verifyText}}"><text class="k">校验</text><text class="v pre">{{d11.verifyText}}</text></view>
    <view class="row" wx:if="{{d11.target}}"><text class="k">目标</text><text class="v">idx={{d11.target.currentEventIndex}} · choices={{d11.target.choiceKeys[0]}}/{{d11.target.choiceKeys[1]}} ✅</text></view>

    <button class="btn btn-wide" bindtap="onD11Run" disabled="{{busy || d11.inFlight || !d11.target}}">RUN_TWO_CONCURRENT_CHOICES（并发提交 A+B）</button>
    <view class="row" wx:if="{{d11.runText}}"><text class="k">执行</text><text class="v">{{d11.runText}}</text></view>
    <view class="row" wx:if="{{d11.respAText}}"><text class="k">响应 A</text><text class="v pre">{{d11.respAText}}</text></view>
    <view class="row" wx:if="{{d11.respBText}}"><text class="k">响应 B</text><text class="v pre">{{d11.respBText}}</text></view>

    <button class="btn btn-wide" bindtap="onD11GetEvent" disabled="{{busy || d11.inFlight}}">GET_CURRENT_EVENT（只读读回）</button>
    <view class="row" wx:if="{{d11.getText}}"><text class="k">GET响应</text><text class="v pre">{{d11.getText}}</text></view>
  </view>

  <view class="card">
    <view class="title">RC8.14 D12-R5B.4 · 8 路真实并发（单批次）</view>
    <view class="row warn"><text class="v">⚠ 仅隔离 staging（非生产）。并发派发 8 个 startChallenge(mode=challenge)：不 await 前序、不提交答案、不 replay、不重试。仅允许唯一一次批次（执行后锁定）。</text></view>
    <view class="row"><text class="k">目标环境</text><text class="v">{{stagingEnv}}</text></view>
    <view class="row"><text class="k">身份状态</text><text class="v">{{identityStatus}}</text></view>
    <button class="btn btn-wide" bindtap="onEightWayRun" disabled="{{busy || eight.running || eight.done || !identityOk}}">RUN_EIGHT_WAY_START（单次 8 路并发 startChallenge）</button>
    <view class="row" wx:if="{{eight.summaryText}}"><text class="k">汇总</text><text class="v pre">{{eight.summaryText}}</text></view>
    <view class="row" wx:if="{{eight.perReqText}}"><text class="k">逐请求</text><text class="v pre">{{eight.perReqText}}</text></view>
  </view>

  <view class="card">
    <view class="title">RC8.14 D12 R6D · Day1–Day3 受控验收（OWNER-ASSISTED）</view>
    <view class="row warn"><text class="v">⚠ 仅隔离 staging（非生产）。固定 recordId，逐步：取当前题 → 手动选择 → 单次提交。绝不自动选择/自动提交/自动重试；不调用 startChallenge；不支付、不改权益。</text></view>
    <view class="row"><text class="k">目标环境</text><text class="v">{{stagingEnv}}</text></view>
    <view class="row"><text class="k">身份状态</text><text class="v">{{identityStatus}}</text></view>

    <view class="row"><text class="k">recordId</text>
      <input class="inp" value="{{day3.recordId}}" bindinput="onD3RecordIdInput" placeholder="CR..." /></view>
    <view class="row"><text class="k">步骤</text>
      <picker mode="selector" range="{{['Day1 CE012','Day2 GAME015','Day3 CE011']}}" value="{{day3.slotIndex}}" bindchange="onD3SlotChange">
        <view class="picker">{{day3.slots[day3.slotIndex].n}} · {{day3.slots[day3.slotIndex].eventId}} ▾</view>
      </picker></view>

    <button class="btn btn-wide" bindtap="onD3Fetch" disabled="{{busy || day3.busy || !identityOk}}">取当前题（getChallengeEvent · 只读）</button>
    <view class="row" wx:if="{{day3.fetchText}}"><text class="k">取题</text><text class="v pre">{{day3.fetchText}}</text></view>
    <view class="row warn" wx:if="{{day3.phase === 'mismatch'}}"><text class="v">⚠ 不匹配：服务端返回的题目与所选步骤不一致。已隐藏选项并阻止提交（0 请求）。请核对进度或改用正确步骤。</text></view>
    <view class="row warn" wx:if="{{day3.phase === 'blocked'}}"><text class="v">⛔ 付费边界：needPayment=true / locked=true。服务端未下发题目；提交已禁用；不触发支付、不授予权益。</text></view>

    <block wx:if="{{day3.event}}">
      <view class="row"><text class="k">当前题</text><text class="v">{{day3.event.eventId}} · Day {{day3.event.day}}</text></view>
      <view class="row"><text class="k">题干</text><text class="v">{{day3.event.title}}</text></view>
      <view class="row"><text class="k">选择</text><text class="v">已选：{{day3.selected || '（未选，请手动点选）'}}</text></view>
      <button wx:for="{{day3.event.choices}}" wx:key="key" class="btn btn-wide"
        bindtap="onD3Select" data-key="{{item.key}}" disabled="{{busy || day3.busy}}">{{item.key}} · {{item.text}}</button>
      <button class="btn btn-wide" bindtap="onD3Submit" disabled="{{busy || day3.busy || !day3.selected || day3.phase !== 'choose'}}">提交所选（单次 · 需确认）</button>
    </block>
    <view class="row" wx:if="{{day3.submitText}}"><text class="k">提交响应</text><text class="v pre">{{day3.submitText}}</text></view>
  </view>

  <view class="card">
    <view class="title">C1–C10</view>
    <button class="btn" bindtap="goRunner" disabled="{{busy || !identityOk}}">进入 C1–C10 Runner</button>
  </view>

  <view class="card">
    <view class="title">log（含时区）</view>
    <view wx:for="{{log}}" wx:key="index" class="logline">{{item}}</view>
  </view>
</view>
