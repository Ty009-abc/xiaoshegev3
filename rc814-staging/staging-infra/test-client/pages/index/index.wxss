.page { padding: 24rpx; }
.card { background: #111827; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; color: #93c5fd; }
.row { display: flex; margin: 8rpx 0; }
.k { width: 160rpx; color: #9ca3af; flex-shrink: 0; }
.v { flex: 1; word-break: break-all; color: #e5e7eb; }
.err { color: #fca5a5; }

/* Buttons: fixed height, single-line content that shrinks to fit — no overflow */
.btn {
  margin: 12rpx 0;
  background: #2563eb;
  color: #fff;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  padding: 0 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  border-radius: 12rpx;
}
/* wider button for the long submit label — keeps text inside the box */
.btn-wide { font-size: 26rpx; }
.btn[disabled] { background: #374151; color: #9ca3af; }

.logline { font-size: 22rpx; color: #d1d5db; word-break: break-all; margin: 4rpx 0; }
.warn { background: #7c2d12; border-radius: 8rpx; padding: 8rpx 12rpx; }
.pre { white-space: pre-wrap; font-size: 22rpx; color: #a7f3d0; }
.inp { flex: 1; background: #1f2937; color: #e5e7eb; border-radius: 8rpx; height: 64rpx; line-height: 64rpx; padding: 0 12rpx; font-size: 24rpx; }
.picker { background: #1f2937; color: #e5e7eb; border-radius: 8rpx; height: 64rpx; line-height: 64rpx; padding: 0 16rpx; min-width: 120rpx; }
.sechead { margin-top: 20rpx; margin-bottom: 6rpx; padding: 6rpx 10rpx; background: #1f2937; border-left: 6rpx solid #2563eb; border-radius: 6rpx; color: #bfdbfe; font-size: 26rpx; font-weight: 600; }
