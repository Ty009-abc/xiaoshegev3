.page { padding: 24rpx; }
.card { background: #111827; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; color: #93c5fd; }
.row { display: flex; margin: 8rpx 0; }
.k { width: 160rpx; color: #9ca3af; }
.v { flex: 1; word-break: break-all; }
button { margin: 12rpx 0; background: #2563eb; color: #fff; }
.logline { font-size: 22rpx; color: #d1d5db; word-break: break-all; margin: 4rpx 0; }
