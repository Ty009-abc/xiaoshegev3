# ═══════════════════════════════════════════════════════════════
# .env.ci — 小程序 CI/CD 环境变量（不含默认值）
# 
# 使用方式：
#   cp .env.ci.example .env.ci
#   填写实际值
#   source .env.ci
#   bash ci/before-upload.sh --preview
#   bash ci/before-upload.sh --upload --ver 6.5.1 --desc "..."
#
# ⚠️  .env.ci 已在 .gitignore，不会提交到 Git
# ═══════════════════════════════════════════════════════════════

# 小程序 AppID（必填）
WX_APPID=

# CI 上传密钥路径 — 从微信后台「开发管理→开发设置→小程序代码上传密钥」下载
# 密钥文件本身不应放在项目目录内，建议放 ~/.openclaw/media/inbound/
WX_PRIVATE_KEY_PATH=

# 可选：版本号前缀（如 v6.5，留空自动用 YYYY.MM.DD 格式）
WX_VERSION_PREFIX=

# 可选：默认描述信息
WX_DEFAULT_DESC=
