# ═══════════════════════════════════════════════════════════════
# 珠澳小事哥 · 认知操作系统 v3.0
# 云函数环境变量模板
# ═══════════════════════════════════════════════════════════════
#
# 使用方式：
#   1. 复制此文件为 .env (不要提交到 git)
#   2. 填入真实值
#   3. 在微信云开发控制台 → 云函数 → 逐个配置环境变量
#   4. 或通过 cloudbaserc.json → envVariables 批量部署
#
# ⚠️ 此文件不包含任何真实密钥，仅作占位模板。

# ── AI 大模型 ──
AI_API_KEY=<your_deepseek_or_openai_api_key>
AI_API_URL=https://api.deepseek.com/v1/chat/completions
# 新模型映射（优先使用）
AI_MODEL_FLASH=v4-flash
AI_MODEL_PRO=v4-pro
# 旧 env 兼容（可选，新部署跳过此项）
# AI_MODEL=deepseek-chat

# ── 管理员 ──
# 多个 openid 用逗号分隔
ADMIN_OPENIDS=oXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX,oYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# ── 微信支付 V3（env 变量名与 common/payment.js 一致）──
WXPAY_MCHID=1747400090
WXPAY_APPID=wxd441fbf3b9f10aa3
WXPAY_API_V3_KEY=<your_32char_api_v3_key>
WXPAY_SERIAL_NO=<your_certificate_serial_number>
WXPAY_PRIVATE_KEY=<your_private_key_pem_content_with_n_for_newlines>
WXPAY_NOTIFY_URL=https://fanshex.com/payCallback

# ── 小程序 ──
APPID=wxd441fbf3b9f10aa3
CLOUDBASE_ENV_ID=fanshex-d2g0adgv7dfbc9bdc
