/**
 * typography.wxss — 字体系统
 * 基于 PingFang SC，统一五级阶梯
 */

/* ═══ 标题 ═══ */
.t-h1 {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-primary);
}
.t-h2 {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-primary);
}
.t-h3 {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

/* ═══ 正文 ═══ */
.t-body {
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.7;
  color: var(--text-primary);
}
.t-body-secondary {
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* ═══ 辅助 ═══ */
.t-caption {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* ═══ 标签 ═══ */
.t-tag {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
}

/* ═══ 数字 ═══ */
.t-number-lg {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.t-number {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

/* ═══ 强调 ═══ */
.t-highlight {
  color: var(--accent-gold);
  font-weight: 600;
}
.t-danger {
  color: var(--danger);
}
.t-ai {
  color: var(--accent-ai);
}
