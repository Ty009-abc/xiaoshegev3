#
# 使用方式：
#   cp .env.deploy.example .env.deploy
#   编辑 .env.deploy 填入真实值
#   然后执行 scripts/set-env.sh 批量设置云函数环境变量

# ── AI 大模型（DeepSeek）──
AI_API_KEY=sk-your-deepseek-api-key
AI_API_BASE_URL=https://api.deepseek.com/v1
# 新模型映射
AI_MODEL_FLASH=v4-flash
AI_MODEL_PRO=v4-pro

# ── Embedding 向量模型 ──
EMBEDDING_API_KEY=sk-your-deepseek-api-key
EMBEDDING_MODEL=deepseek-embedding
EMBEDDING_API_BASE=https://api.deepseek.com/v1

# ── 微信支付 V3 ──
WXPAY_MCHID=1747400090
WXPAY_APPID=wxd441fbf3b9f10aa3
WXPAY_API_V3_KEY=your-wechat-pay-api-v3-key
WXPAY_SERIAL_NO=your-certificate-serial-number
WXPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour...private...key...lines...\n-----END PRIVATE KEY-----
