/* cognitive-shock-detail v1.0 — 独立详情页 */

page {
  --bg: #F7F8FC;
  --card-bg: #FFFFFF;
  --text-primary: #111827;
  --text-secondary: #667085;
  --text-tertiary: #98A2B3;
  --border-light: #EAECF0;
  --border-card: #EEF0F4;
  --purple: #6C5CE7;
  --core-red: #ff3b3b;
  --action-bar-h: 120rpx;

  background: var(--bg);
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
  padding-bottom: calc(var(--action-bar-h) + 60rpx + env(safe-area-inset-bottom));
}

/* ═══ 自定义导航栏 ═══ */
.custom-navbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--bg);
  width: 100%;
}

.navbar-inner {
  display: flex;
  align-items: flex-start;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-top: 4rpx;
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding-top: 2rpx;
}

.nav-placeholder {
  width: 80rpx;
  flex-shrink: 0;
}

/* ═══ 海报遮罩 — 页面根级，z-index 2000 ═══ */
.poster-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
  overflow-y: auto;
  padding: 40rpx 0 160rpx;
}

.poster-backdrop.show {
  opacity: 1;
  pointer-events: auto;
}

.poster-image {
  width: 90%;
  max-width: 660rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 48rpx rgba(255, 45, 85, 0.35);
}

.poster-actions-fab {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.pa-btn {
  padding: 18rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  line-height: 1.4;
}

.pa-btn.pa-save {
  background: #7b5cff;
  color: #fff;
}

.pa-btn.pa-share {
  background: #ff2d55;
  color: #fff;
}

.pa-btn::after {
  border: none;
}

/* ═══ 详情头部 ═══ */
.detail-header {
  padding: 24rpx 32rpx 20rpx;
}

.dh-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dh-date {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.dh-badge {
  font-size: 22rpx;
  color: #ff2d55;
  background: #FFF1F3;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-left: 14rpx;
}

.dh-subtitle {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
}

/* ═══ 暴击内容卡 ═══ */
.shock-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 0 32rpx 20rpx;
  border: 1rpx solid var(--border-card);
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.025);
}

.shock-card--core {
  border-color: #FFDEE5;
  background: #FFFAFB;
}

.shock-card--logic {
  border-color: #FFE8D6;
  background: #FFFBF7;
}

.shock-card--reverse {
  border-color: #FFF3D6;
  background: #FFFDF7;
}

.shock-card--action {
  border-color: #D6FFE8;
  background: #F7FFFA;
}

.sc-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.shock-card--core .sc-label { color: var(--core-red); border-bottom-color: #FFE5EB; }
.shock-card--logic .sc-label { color: #ff6b3d; border-bottom-color: #FFF0E6; }
.shock-card--reverse .sc-label { color: #ff9f1a; border-bottom-color: #FFF6E6; }
.shock-card--action .sc-label { color: #16B364; border-bottom-color: #E6FFF0; }

.sc-content {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 2.0;
  white-space: pre-line;
  word-break: break-all;
}

.sc-content--core {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.8;
}

/* ═══ 维度标签 ═══ */
.dimensions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 4rpx 32rpx 24rpx;
}

.dim-tag {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: #F3F4F6;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

/* ═══ 底部操作栏 ═══ */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(248, 249, 252, 0.96);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #EAECF0;
  box-sizing: border-box;
}

.ab-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  white-space: nowrap;
  line-height: 1.4;
}

.ab-btn::after { border: none; }

.ab-btn--collect {
  background: #FFF7ED;
  color: #D97706;
}

.ab-btn--poster {
  background: #EDE9FE;
  color: #6C5CE7;
}

.ab-btn--go {
  background: linear-gradient(135deg, #7F56D9, #53389E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(127,86,217,0.3);
}

.ab-btn[disabled] { opacity: 0.6; }
