@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   growth-panel — 双主题进度条卡片
   dark (home默认) / light (profile)
   ══════════════════════════════════════ */

/* ── 暗色默认 (home) ── */
.growth-container {
  background: #141B2D;
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.18);
  position: relative;
  overflow: hidden;
}
.growth-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg,transparent,rgba(139,92,246,0.15),transparent);
}

/* ── 亮色 (profile) ── */
.light-theme {
  background: #FFFFFF !important;
  border-radius: 28rpx !important;
  padding: 32rpx !important;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.015) !important;
  border: 1rpx solid #F2F4F7 !important;
  margin-bottom: 32rpx !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
.light-theme::before {
  display: none;
}

/* ═══════════════════════════════
   等级头部
   ═══════════════════════════════ */
.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.current-level-info {
  display: flex;
  align-items: center;
}

.lv-tag {
  font-size: 22rpx;
  font-weight: bold;
  color: #FFFFFF;
  background: linear-gradient(135deg,#8B5CF6,#4F7DFF);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  box-shadow: 0 0 16rpx rgba(139,92,246,0.30);
}
.light-theme .lv-tag {
  background: #7F56D9;
  box-shadow: none;
}

.lv-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #D0D5E0;
}
.light-theme .lv-name {
  color: #101828;
}

.next-level-tips {
  font-size: 24rpx;
  color: #8890A8;
}
.light-theme .next-level-tips {
  color: #667085;
}

/* ═══════════════════════════════
   进度条
   ═══════════════════════════════ */
.progress-wrapper {
  width: 100%;
}

.progress-bar-bg {
  width: 100%;
  height: 16rpx;
  background: #181f33;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.light-theme .progress-bar-bg {
  background: #F2F4F7;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B5CF6, #4F7DFF);
  border-radius: 8rpx;
  box-shadow: 0 0 12rpx rgba(139,92,246,0.30);
  transition: width 0.4s cubic-bezier(0.22,0.61,0.36,1);
}
.light-theme .progress-bar-fill {
  background: linear-gradient(90deg, #9E77ED, #7F56D9);
  box-shadow: none;
}

.progress-data-labels {
  display: flex;
  justify-content: space-between;
  color: #5A6078;
  font-size: 22rpx;
}
.light-theme .progress-data-labels {
  color: #98A2B3;
}
