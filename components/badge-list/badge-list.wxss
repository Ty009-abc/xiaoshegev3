@import '../../styles/tokens.wxss';
.badges-wrap{display:flex;flex-wrap:wrap;gap:var(--sp-16);}
.badge{display:flex;flex-direction:column;align-items:center;gap:var(--sp-8);padding:var(--sp-16) var(--sp-24);background:var(--bg-secondary);border-radius:var(--radius-tag);min-width:120rpx;text-align:center;position:relative;overflow:hidden;}
.badge.unlocked{border:1rpx solid var(--accent-gold-border);}
.badge.locked{opacity:0.4;}
.b-icon{font-size:36rpx;}
.b-name{font-size:20rpx;color:var(--text-secondary);}
.b-lock{font-size:20rpx;position:absolute;top:8rpx;right:8rpx;}
.no-badges{font-size:var(--font-caption);color:var(--text-tertiary);padding:var(--sp-24);text-align:center;width:100%;}
