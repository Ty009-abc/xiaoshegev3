@import '../../styles/tokens.wxss';
.think-wrap{display:flex;align-items:center;justify-content:center;gap:var(--sp-16);padding:var(--sp-32) var(--sp-24);animation:fadeSlideUp var(--dur-normal) var(--ease-out) forwards;}
.think-icon{font-size:36rpx;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:0.4;transform:scale(0.95);}50%{opacity:1;transform:scale(1.05);}}
.think-dots{display:flex;gap:8rpx;}
.td{width:12rpx;height:12rpx;border-radius:50%;background:#8B5CF6;animation:bounce 1.4s infinite;opacity:0.3;}
.td:nth-child(2){animation-delay:0.2s;}
.td:nth-child(3){animation-delay:0.4s;}
@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:0.3;}40%{transform:translateY(-10rpx);opacity:1;}}
.think-text{font-size:var(--font-caption);color:#C6B1FF;}
