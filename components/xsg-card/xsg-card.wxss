@import '../../styles/tokens.wxss';
/* xsg-card — 玻璃卡片 */
.card{background:#141B2D;border:1rpx solid rgba(255,255,255,0.05);border-radius:var(--radius-card);padding:var(--sp-32);margin-bottom:var(--sp-16);box-shadow:0 8rpx 32rpx rgba(0,0,0,0.18);transition:all var(--dur-fast) var(--ease-out);position:relative;overflow:hidden;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:1rpx;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.03),transparent);}
.card.clickable:active{background:#1a2235;}
.card-premium{border-color:rgba(139,92,246,0.25);box-shadow:0 0 28rpx rgba(139,92,246,0.08);}
.card-ai{border-color:rgba(139,92,246,0.20);}
.card-action{border-color:rgba(79,125,255,0.20);}

/* ═══ 亮色模式 ═══ */
.card-light{background:#FFFFFF!important;border:1px solid #F2F4F7!important;border-radius:28rpx!important;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.015)!important;padding:32rpx!important;margin-bottom:24rpx!important;}
.card-light::before{display:none;}
.card-light.clickable:active{background:#F9FAFB!important;}
.card-light .card-title{color:#101828!important;font-size:30rpx!important;font-weight:600!important;}

.card-title{font-size:var(--font-h3);font-weight:700;color:var(--text-primary);margin-bottom:var(--sp-8);}
