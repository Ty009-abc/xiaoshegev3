@import '../../styles/tokens.wxss';
.tag{display:inline-flex;align-items:center;padding:4rpx 16rpx;border-radius:var(--radius-tag);font-size:22rpx;font-weight:500;white-space:nowrap;}
.tag-gold{color:#F5C16C;background:rgba(245,193,108,0.12);border:1rpx solid rgba(245,193,108,0.20);}
.tag-ai{color:#C6B1FF;background:rgba(139,92,246,0.12);border:1rpx solid rgba(139,92,246,0.18);}
.tag-blue{color:#93C5FD;background:rgba(79,125,255,0.12);border:1rpx solid rgba(79,125,255,0.18);}
.tag-green{color:#22C55E;background:rgba(34,197,94,0.12);border:1rpx solid rgba(34,197,94,0.18);}
.tag-pink{color:#F9A8D4;background:rgba(236,72,153,0.12);border:1rpx solid rgba(236,72,153,0.18);}
