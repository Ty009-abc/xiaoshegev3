@import '../../styles/tokens.wxss';
.empty-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--sp-64) var(--sp-32);}
.empty-icon{font-size:72rpx;margin-bottom:var(--sp-16);}
.empty-title{font-size:var(--font-body);color:var(--text-tertiary);margin-bottom:var(--sp-8);text-align:center;}
.empty-desc{font-size:var(--font-caption);color:var(--text-muted);text-align:center;margin-bottom:var(--sp-24);}
.empty-btn{margin-top:var(--sp-8);}
.empty-btn::after{border:none;}
