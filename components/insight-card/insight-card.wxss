@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   insight-card — 灰白质感 (light mode)
   v4.2: 全量解除所有容器高度限制
   ══════════════════════════════════════ */

/* ── 根卡片容器：强行突破任何潜在父级高度限制 ── */
.card {
  display: block !important;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  box-sizing: border-box !important;
  background: #FFFFFF;
  border: 1rpx solid #eaecf0;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  padding-bottom: 48rpx !important;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  transition: all 280ms;
}
.card:active { background: #F9FAFB; }

.badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.badge-icon { font-size: 28rpx; }
.badge-text {
  font-size: 24rpx;
  color: #6941C6;
  font-weight: 600;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #101828;
  margin-bottom: 12rpx;
}

.content {
  display: block !important;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
  white-space: pre-line;
  padding-bottom: 32rpx !important;
  box-sizing: border-box !important;
  font-size: 28rpx;
  color: #344054;
  line-height: 1.8;
}
.content.clamped {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  max-height: none;
  padding-bottom: 0;
}

.expand-hint {
  font-size: 24rpx;
  color: #7F56D9;
  margin-top: 12rpx;
}

/* ── 反方向推理 ── */
.reverse {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #FFF5F5;
  border-radius: 16rpx;
  border-left: 3rpx solid #FF6B6B;
}
.reverse-title {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.reverse-text {
  display: block !important;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  padding-bottom: 24rpx !important;
  box-sizing: border-box !important;
  font-size: 24rpx;
  color: #344054;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 今日行动 ── */
.action-section {
  margin-top: 24rpx;
  padding: 16rpx;
  background: #FFFBEB;
  border-radius: 16rpx;
}
.action-label {
  display: block;
  font-size: 24rpx;
  color: #B45309;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.action-text {
  display: block !important;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  padding-bottom: 16rpx !important;
  box-sizing: border-box !important;
  font-size: 24rpx;
  color: #344054;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 标签 ── */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
