@import '../../styles/tokens.wxss';
.gen-wrap{position:fixed;inset:0;background:#050612;display:flex;align-items:center;justify-content:center;z-index:3000;}
.gen-card{text-align:center;padding:var(--sp-48);}
.gen-icon{font-size:80rpx;display:block;margin-bottom:var(--sp-32);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:0.4;transform:scale(0.95);}50%{opacity:1;transform:scale(1.05);}}
.gen-dots{display:flex;gap:10rpx;justify-content:center;margin-bottom:var(--sp-24);}
.gd{width:14rpx;height:14rpx;border-radius:50%;background:#8B5CF6;animation:bounce 1.4s infinite;opacity:0.3;}
.gd:nth-child(2){animation-delay:0.2s;}
.gd:nth-child(3){animation-delay:0.4s;}
@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:0.3;}40%{transform:translateY(-12rpx);opacity:1;}}
.gen-text{font-size:var(--font-body);color:#C6B1FF;display:block;margin-bottom:var(--sp-32);min-height:48rpx;}
.gen-bar-wrap{width:400rpx;height:6rpx;background:#181f33;border-radius:3rpx;overflow:hidden;margin:0 auto var(--sp-12);}
.gen-bar{height:100%;background:linear-gradient(90deg,#8B5CF6,#C6B1FF);border-radius:3rpx;transition:width 0.4s var(--ease-out);}
.gen-pct{font-size:var(--font-caption);color:var(--text-tertiary);}
