@import '../../styles/tokens.wxss';
.loading-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--sp-48);}
.dots{display:flex;gap:10rpx;margin-bottom:var(--sp-16);}
.dot{width:14rpx;height:14rpx;border-radius:50%;background:#8B5CF6;animation:bounce 1.4s infinite;opacity:0.3;}
.dot:nth-child(2){animation-delay:0.2s;}
.dot:nth-child(3){animation-delay:0.4s;}
@keyframes bounce{0%,80%,100%{transform:translateY(0);opacity:0.3;}40%{transform:translateY(-12rpx);opacity:1;}}
.loading-text{font-size:var(--font-caption);color:var(--text-tertiary);}
