.v2-page {
  min-height: 100vh;
  background: #f7f7fb;
  padding: 24rpx;
  box-sizing: border-box;
}
.v2-denied, .v2-done {
  padding: 120rpx 40rpx;
  text-align: center;
}
.v2-denied-title, .v2-done-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2333;
}
.v2-denied-sub, .v2-done-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #8a90a6;
}
.v2-done-note, .v2-footer-note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #b0b4c5;
}
.v2-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.v2-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2333;
}
.v2-progress {
  font-size: 24rpx;
  color: #7f56d9;
}
.v2-question {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.v2-q-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2333;
  line-height: 1.5;
}
.v2-options {
  margin-top: 16rpx;
}
.v2-option {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e8eaf0;
  border-radius: 12rpx;
  background: #fafbfd;
}
.v2-option-active {
  border-color: #7f56d9;
  background: #f3efff;
}
.v2-option-letter {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #eceef4;
  color: #5a6078;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.v2-option-active .v2-option-letter {
  background: #7f56d9;
  color: #fff;
}
.v2-option-text {
  font-size: 26rpx;
  color: #3a3f52;
}
.v2-footer {
  margin-top: 32rpx;
  text-align: center;
}
.v2-submit {
  background: #7f56d9;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
.v2-submit-disabled {
  background: #c9c2e6;
}
