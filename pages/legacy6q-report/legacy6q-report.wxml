<!--
  pages/legacy6q-report/legacy6q-report.wxml
  RC8.8_STAGE2_R5 — 2026-07-11 legacy 6Q result UI fed by a READY report.
  No loading skeletons: every card is populated before reveal (opacity only).
  可见顺序：01 致命一句话 → 02 核心问题 → 03 系统困局 → 04 翻身路径 → 05 行动建议（Card01 red hero）。
-->
<view class="page">
  <xsg-navbar title="认知翻身报告" showBack light />

  <!-- ═══ §10 emergency state only (missing/invalid handoff) — never five empty cards ═══ -->
  <view class="report-emergency" wx:if="{{error}}">
    <text class="em-title">报告没有完成</text>
    <text class="em-sub">{{error}}</text>
    <button class="em-btn" bindtap="onRetry">重新推演</button>
  </view>

  <!-- ═══ 5模块（完整内容 → 逐卡揭晓） ═══ -->
  <block wx:else>
    <view class="report-blocks">
      <block wx:for="{{sections}}" wx:key="key">
        <!-- RC8.8_STAGE2_RESULT_CARD_LIGHT_THEME: tone-* 仅切换配色；class 顺序 / 结构 / 几何不变 -->
        <view class="section-card tone-{{item.key}} {{item.key === 'fatal' ? 'red-card' : ''}} {{item.revealed ? 'revealed' : 'pre-reveal'}}">
          <view class="section-header">
            <text class="section-badge badge-{{item.key}} {{item.key === 'fatal' ? 'bg-red' : ''}}">{{index + 1}}</text>
            <text class="section-title {{item.key === 'fatal' ? 'text-red' : ''}}">{{item.label}}</text>
          </view>

          <view class="section-body">
            <text class="real-text {{item.key === 'fatal' ? 'fatal-text' : ''}} fade-in" user-select="true">
              {{item.key === 'fatal' ? '💀 ' : ''}}{{item.text}}
            </text>
          </view>
        </view>
      </block>
    </view>

    <!-- ═══ 底部操作区 ═══
         三层结构：主操作（保存/分享）→ 接下来去哪儿（3入口）→ 次级（重做诊断）
         卡片内容 / 海报逻辑 / 后端 / 分享能力均不变。 -->
    <view class="bottom-bar">
      <view class="compliance-tips">
        系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出！
      </view>

      <!-- B. 主操作区：一行双列等宽 -->
      <view class="action-buttons">
        <button class="btn-save-poster" bindtap="generatePoster" loading="{{posterGenerating}}">
          {{posterGenerating ? '淬炼中...' : '保存海报'}}
        </button>
        <button class="btn-share" open-type="share">分享好友</button>
      </view>

      <!-- C/D. 下一步承接区：标题 + 一行三列入口 -->
      <view class="next-section">
        <view class="next-title">接下来去哪儿</view>
        <view class="next-entries">
          <view class="entry-card" hover-class="entry-card-hover" hover-stay-time="80" bindtap="goWorldRules">
            <text class="entry-icon">🌍</text>
            <text class="entry-label">世界规则</text>
          </view>
          <view class="entry-card" hover-class="entry-card-hover" hover-stay-time="80" bindtap="goCognitionDaily">
            <text class="entry-icon">⚡</text>
            <text class="entry-label">每日认知</text>
          </view>
          <view class="entry-card" hover-class="entry-card-hover" hover-stay-time="80" bindtap="goAskXiaoshige">
            <text class="entry-icon">💬</text>
            <text class="entry-label">直接问小事哥</text>
          </view>
        </view>
      </view>

      <!-- E. 次级操作：重做诊断（降权保留） -->
      <button class="btn-retry" bindtap="onRetry">重做诊断</button>
    </view>
  </block>

  <!-- ═══ Canvas 海报（旧版API / 750 x 动态高） ═══ -->
  <canvas canvas-id="posterCanvas" style="width:750px;height:2200px;position:fixed;left:-9999px;top:-9999px;"></canvas>
</view>
