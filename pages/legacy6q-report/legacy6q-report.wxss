/* pages/legacy6q-report/legacy6q-report.wxss
   RC8.8_STAGE2_R5 — 2026-07-11 legacy 6Q result UI (dark), READY content.
   Progressive Reveal + Poster Share. Contrast with the LIGHT thinking page is part
   of the experience — this page stays dark.

   RC8.8_STAGE2_RESULT_PAGE_LIGHT_GRADIENT_BACKGROUND — ONLY the outer page
   background changed: soft-white → pale ice-blue vertical gradient. Card layout,
   typography, spacing, colors, poster and report logic are UNTOUCHED. */

.page {
  /* §2 outer background: soft white → pale ice-blue vertical gradient.
     §3 solid fallback first, then the gradient image (covers the whole page
     because min-height is 100vh and the root view grows with content). */
  background: #EEF5FD;
  background-image: linear-gradient(
    180deg,
    #FFFFFF 0%,
    #F8FAFD 38%,
    #EEF5FD 68%,
    #DCEBFB 100%
  );
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* §6 顶部导航接入渐变：去掉深色导航块，标题/返回键改为浅底深字。
   仅颜色改变 —— 标题、返回键、微信胶囊的位置均不变。 */
.page .navbar {
  background: transparent;
}
.page .nav-title {
  color: #101828;
}
.page .back-icon {
  color: #667085;
}

/* ═══ 报告板块容器 ═══ */
.report-blocks {
  padding: 30rpx 30rpx 0;
}

/* ═══ 板块卡片 ═══ */
.section-card {
  background: #191F2E;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.section-card.red-card {
  background: rgba(255, 59, 48, 0.06);
  border: 1rpx solid rgba(255, 59, 48, 0.15);
}

/* ═══ 标题行 ═══ */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-badge {
  background: #7B57FF;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bg-red { background: #FF3B30 !important; }

.section-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
}
.text-red { color: #FF453A !important; }

/* ═══ 正文 ═══ */
.section-body { min-height: 60rpx; }

.real-text {
  font-size: 26rpx;
  color: #D0D5E0;
  line-height: 1.7;
  display: block;
}
.fatal-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #FF453A !important;
}

/* ═══ 逐卡揭晓（内容已就绪，仅控制透明度；NO loading placeholder） ═══ */
.pre-reveal { opacity: 0; }
.revealed { opacity: 1; }
.fade-in {
  animation: revealFade 0.5s ease-out;
}
@keyframes revealFade {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ═══ 底部操作区 ═══ */
.bottom-bar {
  padding: 0 32rpx 48rpx;
}

.compliance-tips {
  font-size: 22rpx;
  color: #6E758A;
  text-align: center;
  padding: 40rpx 0 32rpx;
}

/* ── 双按钮行 ── */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 16rpx 32rpx;
}

/* 紫蓝渐变发光：保存海报 */
.btn-save-poster {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #7B57FF 0%, #5E45E0 50%, #3B82F6 100%);
  box-shadow: 0 8rpx 32rpx rgba(123, 87, 255, 0.35), 0 0 60rpx rgba(59, 130, 246, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-save-poster::after { border: none; }
.btn-save-poster:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 透明玻璃描边：分享好友 */
.btn-share {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #A78BFA;
  background: rgba(123, 87, 255, 0.08);
  border: 2rpx solid rgba(123, 87, 255, 0.25);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-share::after { border: none; }
.btn-share:active {
  background: rgba(123, 87, 255, 0.15);
  border-color: rgba(123, 87, 255, 0.4);
}

/* ── 重做诊断 ── */
.btn-retry {
  width: 320rpx;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #22293D;
  color: #A0A5B5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}
.btn-retry::after { border: none; }

/* ═══ §10 emergency state ═══ */
.report-emergency {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30vh 60rpx 0;
}
.em-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF453A;
  margin-bottom: 18rpx;
}
.em-sub {
  font-size: 26rpx;
  color: #8A90A6;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}
.em-btn {
  width: 320rpx;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #7B57FF 0%, #5E45E0 50%, #3B82F6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.em-btn::after { border: none; }
