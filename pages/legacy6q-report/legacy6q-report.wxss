/* pages/legacy6q-report/legacy6q-report.wxss
   RC8.8_STAGE2_R5 — 2026-07-11 legacy 6Q result UI, READY content.
   Progressive Reveal + Poster Share.

   RC8.8_STAGE2_RESULT_PAGE_LIGHT_GRADIENT_BACKGROUND — outer .page background is a
   soft-white → pale ice-blue vertical gradient (UNCHANGED by this task).

   RC8.8_STAGE2_RESULT_CARD_LIGHT_THEME — the five report cards are now ONE unified
   LIGHT theme: near-white tinted background + thin colored border + dark ink text,
   with each card keeping its identity via number badge / icon / thin colored border.
   COLOR / THEME ONLY — every geometry value (margin, padding, width, min-height,
   border-radius, font-size, line-height, card order) is byte-identical to the dark
   version. Poster + report logic untouched. */

.page {
  /* §2 outer background: soft white → pale ice-blue vertical gradient. */
  background: #EEF5FD;
  background-image: linear-gradient(
    180deg,
    #FFFFFF 0%,
    #F8FAFD 38%,
    #EEF5FD 68%,
    #DCEBFB 100%
  );
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部导航接入渐变（仅颜色；标题 / 返回键 / 胶囊位置均不变） */
.page .navbar {
  background: transparent;
}
.page .nav-title {
  color: #101828;
}
.page .back-icon {
  color: #667085;
}

/* ═══ 报告板块容器 ═══ */
.report-blocks {
  padding: 30rpx 30rpx 0;
}

/* ═══ 板块卡片 —— LIGHT THEME（以下几何值全部保持原值） ═══ */
.section-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(16, 24, 40, 0.06);
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.06);
}

/* 身份 = 极浅底色 + 细彩边（不再使用深色填充表达身份） */
.section-card.tone-core       { background: rgba(250, 248, 255, 0.94); border-color: rgba(123, 92, 246, 0.25); } /* 02 紫 */
.section-card.tone-trap       { background: rgba(247, 251, 255, 0.94); border-color: rgba(59, 130, 246, 0.25); }  /* 03 蓝 */
.section-card.tone-turnaround { background: rgba(255, 250, 242, 0.94); border-color: rgba(245, 158, 11, 0.28); } /* 04 琥珀 */
.section-card.tone-advice     { background: rgba(246, 253, 249, 0.94); border-color: rgba(34, 197, 94, 0.25); }  /* 05 绿 */

/* Card01 致命一句话 —— 保留红色 hero 身份，底色转为非常浅的粉红 */
.section-card.red-card,
.section-card.tone-fatal {
  background: rgba(255, 244, 245, 0.92);
  border: 1rpx solid rgba(255, 59, 59, 0.30);
}

/* ═══ 标题行 ═══ */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-badge {
  background: #7B57FF;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.section-badge.badge-core       { background: #7B5CF6 !important; } /* 02 紫 */
.section-badge.badge-trap       { background: #3B82F6 !important; } /* 03 蓝 */
.section-badge.badge-turnaround { background: #F59E0B !important; } /* 04 琥珀 */
.section-badge.badge-advice     { background: #22C55E !important; } /* 05 绿 */
.bg-red { background: #FF3B30 !important; }                          /* 01 红 */

.section-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #101828;
}
.text-red { color: #FF3B3B !important; }

/* ═══ 正文 ═══ */
.section-body { min-height: 60rpx; }

.real-text {
  font-size: 26rpx;
  color: #344054;
  line-height: 1.7;
  display: block;
}
.fatal-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #FF3B3B !important;
}

/* ═══ 逐卡揭晓（内容已就绪，仅控制透明度；NO loading placeholder） ═══ */
.pre-reveal { opacity: 0; }
.revealed { opacity: 1; }
.fade-in {
  animation: revealFade 0.5s ease-out;
}
@keyframes revealFade {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ═══ 底部操作区（仅配色适配浅色底；尺寸 / 结构不变） ═══ */
.bottom-bar {
  padding: 0 32rpx 48rpx;
}

.compliance-tips {
  font-size: 22rpx;
  color: #667085;
  text-align: center;
  padding: 40rpx 0 32rpx;
}

/* ── 双按钮行 ── */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 16rpx 32rpx;
}

/* 紫蓝渐变发光：保存海报（深底浅字，浅色页上安全） */
.btn-save-poster {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #7B57FF 0%, #5E45E0 50%, #3B82F6 100%);
  box-shadow: 0 8rpx 32rpx rgba(123, 87, 255, 0.35), 0 0 60rpx rgba(59, 130, 246, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-save-poster::after { border: none; }
.btn-save-poster:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 玻璃描边：分享好友（浅色页上改用深紫字 + 浅紫底，保证可读性） */
.btn-share {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4EE6;
  background: rgba(123, 87, 255, 0.10);
  border: 2rpx solid rgba(123, 87, 255, 0.30);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}
.btn-share::after { border: none; }
.btn-share:active {
  background: rgba(123, 87, 255, 0.16);
  border-color: rgba(123, 87, 255, 0.45);
}

/* ── 重做诊断 ── */
.btn-retry {
  width: 320rpx;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.92);
  color: #667085;
  border: 1rpx solid rgba(16, 24, 40, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}
.btn-retry::after { border: none; }

/* ═══ §10 emergency state ═══ */
.report-emergency {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30vh 60rpx 0;
}
.em-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF3B3B;
  margin-bottom: 18rpx;
}
.em-sub {
  font-size: 26rpx;
  color: #667085;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}
.em-btn {
  width: 320rpx;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #7B57FF 0%, #5E45E0 50%, #3B82F6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.em-btn::after { border: none; }
