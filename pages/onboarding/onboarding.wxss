@import '../../styles/tokens.wxss';
/* ═══════════════════════════════════════════════════
   pages/onboarding — UI 规格对齐（文案冻结 / 仅视觉与交互）
   顶部品牌 → 主视觉+文案 → 分页器+跳过/CTA
   ═══════════════════════════════════════════════════ */

/* ── 安全区归属：本页自行持有底部安全区，抵消 app.wxss 全局 page 的一次应用 ── */
page {
  padding-bottom: 0;
}

/* ── 全局背景：浅色纵向渐变（无暗底，非纯白） ── */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(
    180deg,
    #FFFFFF 0%,
    #F8FAFD 45%,
    #F3F7FC 72%,
    #EEF4FF 100%
  );
}

/* ── 每页一层极淡径向光晕：只换 glow 色，不换底色 ── */
.bg-glow {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}
.page-p1 .bg-glow {
  background: radial-gradient(circle at 50% 42%, rgba(64, 145, 255, 0.10) 0%, rgba(64, 145, 255, 0) 60%);
}
.page-p2 .bg-glow {
  background: radial-gradient(circle at 50% 42%, rgba(255, 178, 71, 0.11) 0%, rgba(255, 178, 71, 0) 60%);
}
.page-p3 .bg-glow {
  background: radial-gradient(circle at 50% 42%, rgba(255, 91, 108, 0.09) 0%, rgba(255, 91, 108, 0) 60%);
}
.page-p4 .bg-glow {
  background: radial-gradient(circle at 50% 42%, rgba(42, 201, 116, 0.10) 0%, rgba(42, 201, 116, 0) 60%);
}

/* ── 页面专属极淡装饰（默认隐藏，仅对应页显示） ── */
.deco {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  opacity: 0;
  transition: opacity 320ms ease-out;
}
.page-p2 .deco-2,
.page-p3 .deco-3 {
  opacity: 1;
}
/* P2 — 两条极淡轨道圆弧（强化“世界模型”，无地图/网格；整体缩小并进一步退入背景） */
.orbit {
  position: absolute;
  left: 50%;
  top: 40%;
  border-radius: 50%;
  border: 2rpx solid #F2A93B;
  opacity: 0.05;
}
.arc-a {
  width: 458rpx;
  height: 458rpx;
  margin-left: -229rpx;
  margin-top: -229rpx;
}
.arc-b {
  width: 563rpx;
  height: 378rpx;
  margin-left: -282rpx;
  margin-top: -189rpx;
  transform: rotate(-18deg);
}
/* P3 — 放大镜后一圈极淡红色晕染 */
.lens-tint {
  position: absolute;
  left: 50%;
  top: 40%;
  width: 340rpx;
  height: 340rpx;
  margin-left: -170rpx;
  margin-top: -170rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 91, 108, 0.16) 0%, rgba(255, 91, 108, 0) 70%);
  opacity: 0.09;
}

/* ── 顶部安全区 / 极轻品牌（顶部安全区仅此一处；右侧 228rpx 胶囊避让） ── */
.top-brand {
  flex: none;
  display: flex;
  align-items: center;
  height: 56rpx;
  box-sizing: content-box;
  padding: calc(32rpx + env(safe-area-inset-top)) 228rpx 0 48rpx;
}
.brand-symbol {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: radial-gradient(circle at 34% 30%, #FFFFFF 0%, var(--accent) 78%);
  box-shadow: 0 4rpx 14rpx rgba(16, 24, 40, 0.08);
  transition: background 320ms ease-out;
}
.brand-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #7F8A9A;
  letter-spacing: 1rpx;
}

/* ── 原生 swiper（左/右滑动） ── */
.swiper {
  flex: 1;
  min-height: 0;
}

/* ── 单页：flex 居中（视觉中心略高于屏幕正中） ── */
.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  transform: translateY(-1vh);
}

/* ── 中央主视觉：外层柔光 + 中层半透明圆盘 + 内层 emoji ── */
.visual {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}
.visual-glow {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.45;
  background: radial-gradient(circle, var(--accent) 0%, rgba(255, 255, 255, 0) 70%);
}
/* 收束页光晕略强 ~15% */
.page-p4 .visual-glow {
  opacity: 0.52;
}
.visual-halo {
  position: absolute;
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.92) 0%,
    rgba(255, 255, 255, 0.34) 72%,
    rgba(255, 255, 255, 0) 100%
  );
}
.visual-shadow {
  position: absolute;
  bottom: 4rpx;
  width: 152rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(16, 24, 40, 0.16);
  filter: blur(14rpx);
}
.visual-emoji {
  position: relative;
  font-size: 140rpx;
  line-height: 1;
  filter: drop-shadow(0 10rpx 26rpx rgba(16, 24, 40, 0.16));
}

/* ── z-index 契约（装饰在下，内容在中，底部控件在上） ── */
.bg-glow { z-index: 0; }
.deco { z-index: 0; }
.visual-emoji { z-index: 2; }
.slide-title { position: relative; z-index: 3; }
.slide-body { position: relative; z-index: 3; }
.footer { position: relative; z-index: 4; }

/* ── 安全默认：内容基线态必须可见（不依赖动画） ── */
.slide .visual-emoji,
.slide .slide-title,
.slide .slide-body {
  opacity: 1;
  visibility: visible;
  transform: none;
}

/* ── 字体层级 ── */
.slide-title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.25;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--accent);
  transition: color 320ms ease-out;
}
.slide-body {
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  color: #101828;
  font-size: 32rpx;
  line-height: 1.65;
}
.para {
  display: block;
}

/* ── 入场动画（仅活跃页，每页播放一次；平静、稳定、克制）
   安全默认：内容默认可见（不设 base opacity:0）。
   动画仅在 is-active 时叠加一次性入场；即使动画被丢弃，内容仍可见。 ── */
.slide.is-active .visual-emoji {
  animation: obEmoji 280ms ease-out 0ms both;
}
.slide.is-active .slide-title {
  animation: obTitle 260ms ease-out 80ms both;
}
.slide.is-active .slide-body {
  animation: obBody 280ms ease-out 160ms both;
}

@keyframes obEmoji {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}
@keyframes obTitle {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes obBody {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── 固定底部：分页 + 次级/主要 CTA（底部安全区仅此一处应用） ── */
.footer {
  flex: none;
  padding: 0 48rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: obFooter 220ms ease-out 220ms both;
}
@keyframes obFooter {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 分页器：跨页固定 */
.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  margin-bottom: 32rpx;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D0D5DD;
  margin: 0 6rpx;
  transition: width 300ms ease-out, background 300ms ease-out,
    border-radius 300ms ease-out;
}
.dot-active {
  width: 28rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

/* 次级 / 主要 CTA 槽位等高，切换不跳动 */
.action-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
}

/* 跳过 — 轻幽灵胶囊（文案冻结） */
.skip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  min-width: 140rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(16, 24, 40, 0.05);
  color: #344054;
  font-size: 30rpx;
  font-weight: 500;
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}
.skip:active {
  transform: scale(0.98);
  opacity: 0.75;
}

/* 最终主 CTA — 全宽渐变胶囊（文案冻结） */
.cta-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  border-radius: 52rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
  background: linear-gradient(135deg, #6941C6 0%, #7F56D9 48%, #2583FF 100%);
  box-shadow: 0 16rpx 36rpx rgba(105, 65, 198, 0.15);
}
.cta-btn::after {
  border: none;
}
.cta-btn:active {
  transform: scale(0.985);
}
