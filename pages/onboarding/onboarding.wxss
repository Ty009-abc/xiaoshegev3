@import '../../styles/tokens.wxss';
/* ═══════════════════════════════════
   pages/onboarding — 引导页升级
   ═══════════════════════════════════ */
.page { height: 100vh; background: var(--bg-primary); display: flex; flex-direction: column; }
.swiper { flex: 1; }
.slide { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 var(--sp-64); }
.slide-emoji { font-size: 120rpx; margin-bottom: var(--sp-48); filter: drop-shadow(0 0 40rpx rgba(245,193,108,0.15)); }
.slide-title { font-weight: 800; text-align: center; margin-bottom: var(--sp-32); line-height: 1.3; }
.slide-body { font-size: var(--font-body); color: var(--text-secondary); text-align: center; line-height: 2; white-space: pre-line; }
.footer { text-align: center; padding: 20rpx var(--sp-48) 80rpx; margin-bottom: 60rpx; }
.skip { font-size: var(--font-body); color: var(--text-tertiary); padding: var(--sp-24); }
.cta-btn { width: 100%; height: 96rpx; line-height: 96rpx; border-radius: var(--radius-btn); font-size: 34rpx; font-weight: 700; color: var(--text-inverse); background: linear-gradient(135deg, var(--accent-gold), #D89A3B); border: none; }
.cta-btn::after { border: none; }
.cta-btn:active { transform: scale(0.98); }
