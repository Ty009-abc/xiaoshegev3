<!-- challenge-play — v3.13 双模式
     mode=challenge: 原有 30 天挑战 (DB 驱动)
     mode=diagnostic: v2 6 题问卷 (纯前端 + AI 直连) -->
<view class="page">
  <xsg-navbar title="{{mode==='diagnostic' ? '翻身策略诊断' : '认知挑战'}}" light />

  <!-- ═════ диагностический 模式 ═════ -->
  <block wx:if="{{mode==='diagnostic'}}">
    <!-- 人格指示条 -->
    <view class="d-personality-bar" wx:if="{{dQ.personality}}">
      <text class="dp-emoji">{{dQ.personality.emoji}}</text>
      <text class="dp-name">{{dQ.personality.name}}视角已激活</text>
    </view>

    <!-- 进度条 -->
    <view class="d-progress-section">
      <view class="d-progress-track">
        <view class="d-progress-fill" style="width:{{dQ.percent}}%"></view>
      </view>
      <text class="d-progress-text">问题 {{dQ.idx+1}} / {{dQ.total}}</text>
    </view>

    <!-- 题目卡片 -->
    <view class="d-card">
      <view class="d-back-row" wx:if="{{dQ.idx>0}}">
        <text class="d-back-btn" bindtap="onDPrev">← 上一题</text>
      </view>

      <view class="d-q-header">
        <text class="d-q-num">{{dQ.idx+1}}</text>
        <text class="d-q-title">{{['你今年几岁？','你现在的职业是？','具体是什么职业？','你的月收入是多少？','你目前的可支配存款？','你目前的负债情况？','你每月固定支出大约多少？','你每天有多少小时可自由支配？','你最可能变现的能力是什么？','你当前最核心的目标是？','你能承受的最大失败成本？'][dQ.idx]}}</text>
      </view>

      <text class="d-q-subtitle">{{dQ.label || ['年龄决定你的牌桌大小和时间窗口','职业是你在牌桌上的筹码形式','例如：厨师、销售、程序员、律师、外卖骑手','收入=认知在这个世界的兑现速度','这决定了你的安全垫厚度','负债决定了你翻身的紧迫度','用于计算真实的月度现金流','决定你能分配多少时间给第二曲线','这是你翻身的核心武器','目标不同，策略完全不同','建立你的风险边界'][dQ.idx]}}</text>

      <view class="d-input-area">
        <!-- picker type questions (Q2,4,5,6,8,9,10,11) -->
        <block wx:if="{{dQ.idx===1||dQ.idx===3||dQ.idx===4||dQ.idx===5||dQ.idx===7||dQ.idx===8||dQ.idx===9||dQ.idx===10}}">
          <view class="d-picker-wrap">
            <text class="d-picker-display" wx:if="{{dQ.answers[dQ.idx]}}">{{dQ.answers[dQ.idx]}}</text>
            <text class="d-picker-display d-picker-placeholder" wx:else>请选择</text>
          </view>
          <picker mode="selector" range="{{['请选择','上班族','个体经营','企业主','自由职业','专业技能职业','学生','待业','其他','','3000以下','3000–6000','6000–1万','1万–2万','2万–5万','5万以上','','1万元以下','1–5万元','5–10万元','10–30万元','30–100万元','100万元以上','','无负债','轻度负债（<月收入3倍）','中度负债（月收入3-12倍）','重度负债（>月收入12倍）','','几乎为0','1小时以内','1–2小时','2–4小时','4小时以上','','专业技术（编程/设计/技术类）','销售/市场/带货','内容创作（写/拍/剪/播）','管理/运营','人脉资源','资金','暂无明确能力','','增加副业收入','尝试转行','创业/开店','清理负债','积累第一桶金','建立个人事业','提升认知','','不能接受任何损失','小额（几千元）','中等（几万元）','较大（几十万以上）']}}" bindchange="onDPickerChange" value="{{dQ.answers[dQ.idx]}}">
            <button class="d-picker-btn">选择</button>
          </picker>
        </block>
        <!-- occupation detail: text input -->
        <block wx:elif="{{dQ.idx===2}}">
          <input type="text" placeholder="请输入具体职业" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.answers[dQ.idx]}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="50" />
        </block>
        <!-- age: number input -->
        <block wx:elif="{{dQ.idx===0}}">
          <input type="number" placeholder="请输入数字" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.answers[dQ.idx]}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="3" />
        </block>
        <!-- monthly expense: number input -->
        <block wx:elif="{{dQ.idx===6}}">
          <input type="number" placeholder="请输入数字（元）" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.answers[dQ.idx]}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="10" />
        </block>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="d-action">
      <button class="d-btn-next" hover-class="d-btn-hover" bindtap="onDNext"
        disabled="{{!dQ.canNext}}" loading="{{dQ.submitting}}">
        {{dQ.idx===dQ.total-1?'生成翻身策略 ⚡':'下一题 →'}}
      </button>
      <text class="d-kb-hint" wx:if="{{dQ.idx===0||dQ.idx===2||dQ.idx===6}}" style="{{dQ.canNext?'opacity:1':'opacity:0'}}">按键盘「完成」键继续</text>
    </view>
  </block>

  <!-- ═════ challenge 模式 (原有) ═════ -->
  <block wx:else>
    <xsg-loading text="加载下一题..." wx:if="{{loading}}" />
    <block wx:else>
      <challenge-progress current="{{progress.current}}" total="{{progress.total}}" day="{{progress.day}}" class="anim-fade-in" />

      <view class="event-area {{animOut?'slide-out-left':''}} {{animIn?'slide-in-right':''}}" wx:if="{{event}}">
        <xsg-card>
          <xsg-tag text="{{event.category||'决策题'}}" type="ai" />
          <view class="event-title mt-16">{{event.title}}</view>
          <view class="event-desc mt-12">{{event.description}}</view>
        </xsg-card>
      </view>

      <view class="choices-area {{animOut?'slide-out-left':''}} {{animIn?'slide-in-right':''}}" wx:if="{{event}}">
        <challenge-choice wx:for="{{event.choices}}" wx:key="key"
          choiceKey="{{item.key}}" text="{{item.text}}"
          selected="{{selectedKey===item.key}}" submitted="{{submitted}}"
          bind:select="onSelect" />
      </view>

      <xsg-button type="primary" text="{{submitted?'你的选择已记录 ✓':'确认选择'}}" disabled="{{!selectedKey||submitted}}" bind:tapbutton="onSubmit" />

      <xsg-empty icon="🏁" title="诊断完成" desc="10题诊断已结束，查看你的翻身策略报告" btnText="查看报告" wx:if="{{end}}" bind:tap="goResult" />
    </block>
  </block>
</view>
