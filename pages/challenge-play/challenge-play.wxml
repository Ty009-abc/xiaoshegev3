<!-- challenge-play — v3.14 产品化UI
     mode=challenge: 30天挑战 (DB驱动)
     mode=diagnostic: 10题问卷 -->
<view class="page">
  <xsg-navbar title="{{mode==='diagnostic' ? '翻身策略诊断' : '认知挑战'}}" light />

  <!-- ═════ diagnostic 模式 ═════ -->
  <block wx:if="{{mode==='diagnostic'}}">
    <view class="d-personality-bar" wx:if="{{dQ.personality}}">
      <text class="dp-emoji">{{dQ.personality.emoji}}</text>
      <text class="dp-name">{{dQ.personality.name}}视角已激活</text>
    </view>

    <view class="d-progress-section">
      <view class="d-progress-track">
        <view class="d-progress-fill" style="width:{{dQ.percent}}%"></view>
      </view>
      <text class="d-progress-text">问题 {{dQ.idx+1}} / {{dQ.total}}</text>
    </view>

    <view class="d-card">
      <view class="d-back-row" wx:if="{{dQ.idx>0}}">
        <text class="d-back-btn" bindtap="onDPrev">← 上一题</text>
      </view>

      <view class="d-q-header">
        <text class="d-q-num">{{dQ.idx+1}}</text>
        <text class="d-q-title">{{currentQuestion.title}}</text>
      </view>

      <text class="d-q-subtitle">{{dQ.label || currentQuestion.subtitle}}</text>

      <view class="d-input-area">
        <block wx:if="{{currentQuestion.type==='picker+input'}}">
          <view class="d-picker-wrap">
            <text class="d-picker-display" wx:if="{{dQ.selectedPick}}">{{dQ.selectedPick}}</text>
            <text class="d-picker-display d-picker-placeholder" wx:else>{{currentQuestion.options[0] || '请选择'}}</text>
          </view>
          <picker mode="selector" range="{{currentQuestion.options}}" bindchange="onDPickerChange">
            <button class="d-picker-btn">选择</button>
          </picker>
          <input wx:if="{{dQ.selectedPick}}" type="text" placeholder="{{currentQuestion.detailPlaceholder || '请输入具体职业'}}" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.detailText}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="50" />
        </block>
        <block wx:elif="{{currentQuestion.type==='picker+multi'}}">
          <view class="d-multi-row">
            <view class="d-picker-wrap">
              <text class="d-picker-display" wx:if="{{dQ.selectedPick}}">{{dQ.selectedPick}}</text>
              <text class="d-picker-display d-picker-placeholder" wx:else>{{currentQuestion.options[0] || '请选择'}}</text>
            </view>
            <picker mode="selector" range="{{currentQuestion.options}}" bindchange="onDPickerChange">
              <button class="d-picker-btn">选择</button>
            </picker>
          </view>
          <view class="d-multi-divider"></view>
          <text class="d-multi-label">{{currentQuestion.extraLabel || '额外选择'}}</text>
          <view class="d-multi-row">
            <view class="d-picker-wrap">
              <text class="d-picker-display" wx:if="{{dQ.extraPick}}">{{dQ.extraPick}}</text>
              <text class="d-picker-display d-picker-placeholder" wx:else>{{currentQuestion.extraOptions[0] || '请选择'}}</text>
            </view>
            <picker mode="selector" range="{{currentQuestion.extraOptions}}" bindchange="onDExtraPickerChange">
              <button class="d-picker-btn">选择</button>
            </picker>
          </view>
        </block>
        <block wx:elif="{{currentQuestion.type==='picker'}}">
          <view class="d-picker-wrap">
            <text class="d-picker-display" wx:if="{{dQ.selectedPick}}">{{dQ.selectedPick}}</text>
            <text class="d-picker-display d-picker-placeholder" wx:else>请选择</text>
          </view>
          <picker mode="selector" range="{{currentQuestion.options}}" bindchange="onDPickerChange">
            <button class="d-picker-btn">选择</button>
          </picker>
        </block>
        <block wx:elif="{{currentQuestion.inputType==='number'}}">
          <input type="number" placeholder="{{currentQuestion.placeholder || '请输入'}}" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.answers[currentQuestion.key] || ''}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="{{currentQuestion.maxlength || 10}}" />
        </block>
        <block wx:else>
          <input type="text" placeholder="{{currentQuestion.placeholder || '请输入'}}" placeholder-class="d-placeholder" bindinput="onDInput" value="{{dQ.answers[currentQuestion.key] || ''}}" focus="{{true}}" confirm-type="next" bindconfirm="onDNext" maxlength="{{currentQuestion.maxlength || 50}}" />
        </block>
      </view>
    </view>

    <view class="d-action">
      <button class="d-btn-next" hover-class="d-btn-hover" bindtap="onDNext" disabled="{{!dQ.canNext}}" loading="{{dQ.submitting}}">
        {{dQ.idx===dQ.total-1?'生成翻身策略 ⚡':'下一题 →'}}
      </button>
      <text class="d-kb-hint" wx:if="{{currentQuestion.type==='input'}}" style="{{dQ.canNext?'opacity:1':'opacity:0'}}">按键盘「完成」键继续</text>
    </view>
  </block>

  <!-- ═════ challenge 模式 ═════ -->
  <block wx:else>

    <!-- 锁定卡 -->
    <block wx:if="{{challengeLocked}}">
      <view class="lock-wrapper">
        <view class="lock-icon-wrap">
          <text class="lock-icon-text">🔒</text>
        </view>
        <text class="lock-title">免费体验已完成</text>
        <text class="lock-desc">你已完成3道认知挑战\n解锁完整30天挑战，继续建立九维认知模型</text>

        <button class="btn-primary-action" bindtap="onUnlock" hover-class="btn-press">解锁完整挑战</button>
        <button class="btn-secondary-action" bindtap="onGoHome" hover-class="btn-press">返回首页</button>
      </view>
    </block>

    <!-- 加载失败 -->
    <block wx:elif="{{loadFailed && !event && !end}}">
      <view class="lock-wrapper">
        <view class="lock-icon-wrap" style="background:#FEF2F2;">
          <text class="lock-icon-text">⚠️</text>
        </view>
        <text class="lock-title" style="color:#c0392b;">下一题加载失败</text>
        <text class="lock-desc" style="color:#667085;">请检查网络后重试</text>
        <button class="btn-primary-action" bindtap="onRetry" hover-class="btn-press">重试加载</button>
      </view>
    </block>

    <!-- 加载中 -->
    <xsg-loading text="加载下一题..." wx:elif="{{loading}}" />

    <!-- 正常答题 -->
    <block wx:elif="{{event}}">
      <!-- 进度条 -->
      <view class="progress-card anim-fade-in">
        <view class="progress-top">
          <view class="progress-left">
            <text class="progress-day-label">Day {{progress.day}}</text>
            <text class="progress-sub-label">今日认知决策</text>
          </view>
          <view class="progress-right">
            <text class="progress-count">{{progress.current}}</text>
            <text class="progress-divider">/</text>
            <text class="progress-total">{{progress.total}}</text>
          </view>
        </view>
        <view class="progress-bar">
          <view class="progress-fill" style="width:{{progress.current/progress.total*100}}%"></view>
        </view>
      </view>

      <!-- 题目卡 -->
      <view class="question-card {{animOut?'slide-out-left':''}} {{animIn?'slide-in-right':''}}">
        <text class="q-tag">{{event.category||'决策题'}}</text>
        <text class="q-title">{{event.title}}</text>
        <text class="q-desc">{{event.description}}</text>
      </view>

      <!-- 选项列表 -->
      <view class="choice-list {{animOut?'slide-out-left':''}} {{animIn?'slide-in-right':''}}">
        <view
          class="choice-item {{item.key===selectedKey?'selected':''}} {{submitted&&item.key!==selectedKey?'dimmed':''}}"
          wx:for="{{event.choices}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onChoiceTap"
        >
          <view class="choice-key {{item.key===selectedKey?'selected':''}}">{{item.key}}</view>
          <text class="choice-text">{{item.text}}</text>
        </view>
      </view>

      <!-- 确认按钮 -->
      <view class="confirm-section anim-fade-in">
        <button
          class="confirm-btn {{(!selectedKey||submitted)?'disabled':''}}"
          hover-class="confirm-btn-hover"
          bindtap="onSubmit"
          disabled="{{!selectedKey||submitted}}"
        >
          {{submitted?'✓ 你的选择已记录':'确认选择'}}
        </button>
      </view>
    </block>

    <xsg-empty icon="🏁" title="诊断完成" desc="10题诊断已结束，查看你的翻身策略报告" btnText="查看报告" wx:if="{{end}}" bind:tap="goResult" />
  </block>
</view>
