/* ══════════════════════════════════════
   pages/challenge-play — v3.14 产品化UI
   ══════════════════════════════════════ */

page { background: #F6F7FB; }

.page {
  min-height: 100vh;
  padding: 0 28rpx 64rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 85% 10%, rgba(124,77,255,.08), transparent 38%), #F6F7FB;
  color: #121827;
}

/* ═══════════ 动画 ═══════════ */
.anim-fade-in { animation: fadeIn 0.35s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
.slide-out-left { animation: slideOutLeft 0.3s ease forwards; }
.slide-in-right { animation: slideInRight 0.3s ease forwards; }
@keyframes slideOutLeft { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(-40rpx); } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(40rpx); } to { opacity: 1; transform: translateX(0); } }

/* ═══════════ 进度条 ═══════════ */
.progress-card {
  margin-top: 20rpx;
  padding: 26rpx 30rpx 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 32rpx rgba(21,28,51,.06);
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-left {
  display: flex;
  flex-direction: column;
}

.progress-day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #121827;
}

.progress-sub-label {
  font-size: 22rpx;
  color: #8E98A8;
  margin-top: 2rpx;
}

.progress-right {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.progress-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #7953F2;
}

.progress-divider {
  font-size: 28rpx;
  color: #C6CDD8;
  margin: 0 2rpx;
}

.progress-total {
  font-size: 24rpx;
  color: #8E98A8;
}

.progress-bar {
  height: 10rpx;
  background: #EEF0F5;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7953F2, #4E7CFF);
  transition: width .4s ease;
}

/* ═══════════ 题目卡 ═══════════ */
.question-card {
  margin-top: 28rpx;
  padding: 36rpx 34rpx 40rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 14rpx 42rpx rgba(21,28,51,.07);
}

.q-tag {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: #F2ECFF;
  color: #7452E8;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.q-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #121827;
  margin-bottom: 16rpx;
}

.q-desc {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: #667085;
}

/* ═══════════ 选项列表 ═══════════ */
.choice-list {
  margin-top: 28rpx;
}

.choice-item {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7EAF0;
  border-radius: 22rpx;
  box-sizing: border-box;
  transition: all .2s ease;
}

.choice-item.selected {
  background: #F4F0FF;
  border-color: #7953F2;
  box-shadow: 0 8rpx 24rpx rgba(121,83,242,.13);
}

.choice-item.dimmed {
  opacity: .55;
}

.choice-key {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #EEF0F5;
  color: #475467;
  font-size: 26rpx;
  font-weight: 700;
}

.choice-key.selected {
  background: #7953F2;
  color: #FFFFFF;
}

.choice-text {
  flex: 1;
  min-width: 0;
  color: #253044;
  font-size: 31rpx;
  line-height: 1.6;
  word-break: break-word;
}

/* ═══════════ 确认按钮 ═══════════ */
.confirm-section {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.confirm-btn {
  width: 100%;
  height: 104rpx;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, #7B55F5, #4E7CFF);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(92,91,238,.24);
}

.confirm-btn::after { border: none; }

.confirm-btn.disabled {
  background: #E7EAF0 !important;
  color: #98A2B3 !important;
  box-shadow: none !important;
}

.confirm-btn-hover {
  transform: scale(.97);
  opacity: .88;
}

/* ═══════════ 锁定卡 / 错误卡 ═══════════ */
.lock-wrapper {
  margin-top: 60rpx;
  padding: 64rpx 40rpx 48rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 46rpx rgba(21,28,51,.08);
  text-align: center;
}

.lock-icon-wrap {
  display: inline-flex;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F2ECFF;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.lock-icon-text {
  font-size: 44rpx;
}

.lock-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #121827;
  margin-bottom: 18rpx;
}

.lock-desc {
  display: block;
  font-size: 30rpx;
  color: #667085;
  line-height: 1.75;
  white-space: pre-line;
  margin-bottom: 36rpx;
}

/* ═══════════ 锁定页按钮 ═══════════ */
.btn-primary-action {
  width: 100%;
  height: 100rpx;
  border-radius: 52rpx;
  background: linear-gradient(90deg, #7B55F5, #4E7CFF);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 30rpx rgba(92,91,238,.24);
}

.btn-primary-action::after { border: none; }

.btn-secondary-action {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #D9DDE6;
  color: #475467;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary-action::after { border: none; }

.btn-press {
  transform: scale(.97);
  opacity: .9;
}

/* ═══════════ diagnostic ═══════════ */
.d-personality-bar {
  display:flex; align-items:center; gap:12rpx;
  padding:24rpx 32rpx; margin:0 8rpx;
  background:#F5F3FF; border-radius:20rpx;
}
.dp-emoji { font-size:36rpx; }
.dp-name { font-size:26rpx; color:#7F56D9; font-weight:600; }

.d-progress-section {
  display:flex; align-items:center; gap:16rpx;
  padding:32rpx 8rpx 16rpx;
}
.d-progress-track {
  flex:1; height:8rpx; background:#E5E7EB; border-radius:999rpx; overflow:hidden;
}
.d-progress-fill {
  height:100%; border-radius:999rpx;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  transition:width 0.4s ease;
}
.d-progress-text { font-size:24rpx; color:#667085; white-space:nowrap; }

.d-card {
  margin:0 4rpx 24rpx; background:#FFF;
  border-radius:28rpx; padding:32rpx;
  box-shadow:0 4rpx 20rpx rgba(0,0,0,0.04);
}
.d-back-row { margin-bottom:16rpx; }
.d-back-btn { font-size:26rpx; color:#7F56D9; font-weight:600; }

.d-q-header { display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx; }
.d-q-num {
  width:52rpx; height:52rpx; border-radius:50%;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  color:#FFF; font-size:26rpx; font-weight:700;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.d-q-title { font-size:32rpx; font-weight:700; color:#101828; }
.d-q-subtitle { font-size:25rpx; color:#667085; display:block; margin-bottom:32rpx; line-height:1.6; min-height:40rpx; }

.d-input-area {
  background:#F9FAFB; border-radius:20rpx; padding:24rpx; min-height:120rpx;
}
.d-input-area input,.d-input-area textarea {
  width:100%; font-size:30rpx; color:#101828; background:transparent;
  min-height:72rpx; line-height:1.6;
}
.d-placeholder { color:#D0D5DD; }
.d-input-hint { padding:8rpx 0 0; text-align:right; font-size:22rpx; color:#A0A0B0; }

.d-picker-wrap {
  background:#FFF; border:1rpx solid #E5E7EB; border-radius:16rpx;
  padding:20rpx; margin-bottom:16rpx;
}
.d-picker-display { font-size:30rpx; color:#111827; }
.d-picker-placeholder { color:#D0D5DD; }
.d-picker-btn {
  display:inline-block; padding:12rpx 24rpx; background:#F5F3FF;
  color:#7F56D9; border-radius:999rpx; font-size:26rpx; font-weight:600;
  border:none;
}
.d-picker-btn::after { border:none; }

.d-action { padding:0 32rpx; display:flex; flex-direction:column; align-items:center; gap:8rpx; }
.d-btn-next {
  width:100%; height:96rpx; border-radius:999rpx;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  color:#FFF; font-size:33rpx; font-weight:700;
  border:none; display:flex; align-items:center; justify-content:center;
}
.d-btn-next::after { border:none; }
.d-btn-next[disabled] { opacity:0.4; }
.d-btn-hover { opacity:0.85; }
.d-kb-hint { font-size:22rpx; color:#A0A0B0; transition:opacity 0.3s; }

/* ═══════════ 旧样式兼容 ═══════════ */
.event-area { margin-top: 4rpx; }
.choices-area { margin-top: 4rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-12 { margin-top: 12rpx; }
