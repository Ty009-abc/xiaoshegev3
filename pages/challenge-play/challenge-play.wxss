/* ══════════════════════════════════════
   pages/challenge-play — 浅色主题
   ══════════════════════════════════════ */

page {
  background: #F5F7FB;
}

.challenge-page {
  min-height: 100vh;
  background: #F5F7FB;
  color: #111827;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FB;
}

/* ═══════════ 动画 ═══════════ */
.anim-fade-in { animation: fadeIn 0.35s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
.slide-out-left { animation: slideOutLeft 0.3s ease forwards; }
.slide-in-right { animation: slideInRight 0.3s ease forwards; }
@keyframes slideOutLeft { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(-40rpx); } }
@keyframes slideInRight { from { opacity: 0; transform: translateX(40rpx); } to { opacity: 1; transform: translateX(0); } }

/* ═══════════ 内容区域 ═══════════ */
.event-area {
  padding: 24rpx 32rpx 0;
}
.choices-area {
  padding: 8rpx 32rpx 0;
}
.mt-16 { margin-top: 16rpx; }
.mt-12 { margin-top: 12rpx; }

/* ═══════════ 题目卡片文本 ═══════════ */
.event-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.5;
}
.event-desc {
  font-size: 28rpx;
  font-weight: 400;
  color: #4B5563;
  line-height: 1.75;
}

/* ═══════════ 锁定卡 ═══════════ */
.lock-card {
  margin: 32rpx 32rpx 16rpx;
}
.lock-card-icon {
  text-align: center;
  font-size: 80rpx;
  padding: 32rpx 0 16rpx;
}
.lock-card-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}
.lock-card-desc {
  text-align: center;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  white-space: pre-line;
}
.lock-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 32rpx;
}

/* ═══════════ diagnostic 6题问卷 ═══════════ */
.d-personality-bar {
  display:flex; align-items:center; gap:12rpx;
  padding:24rpx 32rpx; margin:0 32rpx;
  background:#F5F3FF; border-radius:20rpx;
}
.dp-emoji { font-size:36rpx; }
.dp-name { font-size:26rpx; color:#7F56D9; font-weight:600; }

.d-progress-section {
  display:flex; align-items:center; gap:16rpx;
  padding:32rpx 32rpx 16rpx;
}
.d-progress-track {
  flex:1; height:8rpx; background:#E5E7EB; border-radius:999rpx; overflow:hidden;
}
.d-progress-fill {
  height:100%; border-radius:999rpx;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  transition:width 0.4s ease;
}
.d-progress-text { font-size:24rpx; color:#667085; white-space:nowrap; }

.d-card {
  margin:0 32rpx 24rpx; background:#FFF;
  border-radius:28rpx; padding:32rpx;
  box-shadow:0 4rpx 20rpx rgba(0,0,0,0.04);
}
.d-back-row { margin-bottom:16rpx; }
.d-back-btn { font-size:26rpx; color:#7F56D9; font-weight:600; }

.d-q-header { display:flex; align-items:center; gap:16rpx; margin-bottom:16rpx; }
.d-q-num {
  width:52rpx; height:52rpx; border-radius:50%;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  color:#FFF; font-size:26rpx; font-weight:700;
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.d-q-title { font-size:32rpx; font-weight:700; color:#101828; }
.d-q-subtitle { font-size:25rpx; color:#667085; display:block; margin-bottom:32rpx; line-height:1.6; min-height:40rpx; }

.d-input-area {
  background:#F9FAFB; border-radius:20rpx; padding:24rpx; min-height:120rpx;
}
.d-input-area input,.d-input-area textarea {
  width:100%; font-size:30rpx; color:#101828; background:transparent;
  min-height:72rpx; line-height:1.6;
}
.d-placeholder { color:#D0D5DD; }
.d-input-hint { padding:8rpx 0 0; text-align:right; font-size:22rpx; color:#A0A0B0; }

.d-picker-wrap {
  background:#FFF; border:1rpx solid #E5E7EB; border-radius:16rpx;
  padding:20rpx; margin-bottom:16rpx;
}
.d-picker-display { font-size:30rpx; color:#111827; }
.d-picker-placeholder { color:#D0D5DD; }
.d-picker-btn {
  display:inline-block; padding:12rpx 24rpx; background:#F5F3FF;
  color:#7F56D9; border-radius:999rpx; font-size:26rpx; font-weight:600;
  border:none;
}
.d-picker-btn::after { border:none; }

.d-action { padding:0 32rpx; display:flex; flex-direction:column; align-items:center; gap:8rpx; }
.d-btn-next {
  width:100%; height:96rpx; border-radius:999rpx;
  background:linear-gradient(135deg,#7F56D9,#53389E);
  color:#FFF; font-size:33rpx; font-weight:700;
  border:none; display:flex; align-items:center; justify-content:center;
}
.d-btn-next::after { border:none; }
.d-btn-next[disabled] { opacity:0.4; }
.d-btn-hover { opacity:0.85; }
.d-kb-hint { font-size:22rpx; color:#A0A0B0; transition:opacity 0.3s; }
