<!-- invite — v4 紧急视觉修复：深色通铺 + 高对比文字 + 吸底按钮 -->
<view class="page page-enter">
  <xsg-navbar title="邀请好友" showBack />

  <view class="hero anim-fade-in">
    <text class="h-icon">🎁</text>
    <text class="h-title">和好友一起升级世界模型</text>
    <text class="h-desc">每次邀请，你们都变得更接近真实世界的规则</text>
  </view>

  <!-- 已邀请数据 -->
  <view class="stat-card anim-fade-in">
    <view class="stat-row">
      <text class="sr-num">{{inviteCount}}</text>
      <text class="sr-label">已邀请</text>
    </view>
  </view>

  <!-- 邀请奖励阶梯 -->
  <view class="reward-card anim-fade-in">
    <text class="section-title">邀请奖励</text>
    <view class="reward-list">
      <view class="reward {{item.achieved?'done':''}}" wx:for="{{rewards}}" wx:key="threshold">
        <text class="rw-icon">{{item.achieved?'✅':item.icon}}</text>
        <text class="rw-desc">邀请{{item.threshold}}人 · {{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 底部吸底按钮 -->
  <view class="actions anim-fade-in anim-delay-1">
    <button class="btn-invite" open-type="share">邀请好友 →</button>
  </view>
</view>
