/* ══════════════════════════════════════
   pages/invite — v4 紧急视觉修复
   硬编码高对比度 × 全页深色通铺 × 吸底按钮
   ══════════════════════════════════════ */

/* ── 外层容器：强制全页深色背景，消灭断层露白 ── */
.page {
  min-height: 100vh !important;
  background-color: #121620 !important;
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
  padding-top: calc(32rpx + env(safe-area-inset-top));
}

/* ═════════════════════════
   Hero 头部
   ═════════════════════════ */
.hero {
  text-align: center;
  padding: 48rpx 0 40rpx;
}

.h-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.h-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.h-desc {
  font-size: 26rpx;
  color: #8890A8;
}

/* ═════════════════════════
   已邀请数据卡片
   ═════════════════════════ */
.stat-card {
  background: #1E2433;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.stat-row {
  text-align: center;
}

.sr-num {
  font-size: 64rpx;
  font-weight: 900;
  color: #FFD700;
  display: block;
  letter-spacing: 4rpx;
}

.sr-label {
  font-size: 26rpx;
  color: #D0D5E0;
  margin-top: 8rpx;
  display: block;
}

/* ═════════════════════════
   邀请奖励卡片
   ═════════════════════════ */
.reward-card {
  background: #1E2433;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  display: block;
}

.reward-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reward {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.reward:last-child {
  border-bottom: none;
}

.rw-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.rw-desc {
  font-size: 28rpx;
  color: #D0D5E0;
  font-weight: 500;
}

/* 已达成奖励高亮 */
.reward.done .rw-desc {
  color: #FFD700;
  font-weight: 700;
}

/* ═════════════════════════
   底部按钮区域 — 吸底
   ═════════════════════════ */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #121620;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.btn-invite {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A2E;
  background: linear-gradient(135deg, #FFD700, #F0A500);
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(255, 215, 0, 0.3);
}
.btn-invite::after {
  border: none;
}
.btn-invite:active {
  transform: scale(0.97);
}
