/* world-rules v6.2 — 世界规则探索系统 · 浅色极简 */

page {
  --bg: #F7F8FC;
  --card-bg: #FFFFFF;
  --text-primary: #111827;
  --text-secondary: #667085;
  --text-tertiary: #98A2B3;
  --text-inactive: #B5B9C5;
  --border-light: #EAECF0;
  --border-card: #EEF0F4;

  background: var(--bg);
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ═══ 自定义导航栏 — 浅色极简 ═══ */
.custom-navbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--bg);
  width: 100%;
}

.navbar-inner {
  display: flex;
  align-items: flex-start;
  padding: 0 32rpx;
  /* navBarHeight 由 js 计算包含 bottom padding */
}

.nav-left {
  width: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding-top: 4rpx;
}

.back-icon {
  font-size: 40rpx;
  color: var(--text-primary);
}

.nav-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.nav-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
}

.nav-placeholder {
  width: 80rpx;
  flex-shrink: 0;
}

/* ═══ Hero 探索总览 ═══ */
.hero-section {
  padding: 16rpx 32rpx 24rpx;
}

.hero-main {
  background: var(--card-bg);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-light);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.hero-progress {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.hero-bar-wrap {
  width: 200rpx;
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 4rpx;
  margin-top: 12rpx;
  overflow: hidden;
}

.hero-bar {
  height: 100%;
  background: linear-gradient(90deg, #6366F1, #8B5CF6);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.hero-percent {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

.hero-right {
  flex-shrink: 0;
  margin-left: 24rpx;
}

.hero-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #F5F3FF, #EEF2FF);
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  border: 1rpx solid #E0D9FE;
}

.hero-action-icon {
  font-size: 24rpx;
  color: #7C4DFF;
}

.hero-action-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6C5CE7;
  margin-top: 4rpx;
}

.hero-action-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ═══ 世界模型地图 ═══ */
.model-map {
  padding: 0 32rpx 20rpx;
}

.model-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.model-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.model-cell {
  background: var(--card-bg);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-light);
  border-left-width: 6rpx;
  padding: 18rpx 20rpx;
}

.model-cell-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.model-cell-icon {
  font-size: 34rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.model-cell-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #111827;
}

.model-cell-count {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.model-cell-bar-wrap {
  height: 6rpx;
  background: #F3F4F6;
  border-radius: 3rpx;
  overflow: hidden;
}

.model-cell-bar {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* ═══ 横向滚动分类胶囊 ═══ */
.cat-bar-wrap {
  width: 100%;
  background: var(--bg);
  padding: 8rpx 0 16rpx;
}

.cat-bar {
  display: inline-flex;
  flex-wrap: nowrap;
  white-space: nowrap;
  padding: 0 32rpx;
}

.cat-capsule {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--card-bg);
  border: 1rpx solid var(--border-light);
  border-radius: 999rpx;
  white-space: nowrap;
  transition: all 0.15s ease;
}

.cat-icon {
  margin-right: 4rpx;
  font-size: 22rpx;
}

.cat-capsule.active {
  background: #111827;
  border-color: #111827;
  color: #FFFFFF;
  font-weight: 600;
}

/* ═══ 规则卡片 ═══ */
.rule-list {
  padding: 0 32rpx 0;
  width: 100%;
  box-sizing: border-box;
}

.rule-card {
  position: relative;
  background: var(--card-bg);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-card);
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.03);
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* 左侧分类色标 */
.rule-card::after {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
}

/* ═══ 分类色标 ═══ */
.category-wealth::after        { background: #F2B84B; }
.category-mindset::after       { background: #8B5CF6; }
.category-system::after        { background: #4F7CFF; }
.category-probability::after   { background: #16B364; }
.category-cognition::after     { background: #EC4899; }
.category-business::after      { background: #F97316; }
.category-leverage::after      { background: #06B6D4; }
.category-risk::after          { background: #EF4444; }
.category-human::after         { background: #8B5CF6; }
.category-decision::after      { background: #6366F1; }
.category-capital::after       { background: #D4A017; }
.category-info::after          { background: #22D3EE; }
.category-longterm::after      { background: #84CC16; }
.category-network::after       { background: #A855F7; }

/* 头部：编号 + 分类标签 + 已读状态 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.card-num {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-inactive);
  letter-spacing: 1rpx;
  margin-right: 10rpx;
}

.card-cat-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

/* 分类小标签色彩 */
.cat-tag-wealth       { background: #FFF7ED; color: #F2B84B; }
.cat-tag-mindset      { background: #F5F3FF; color: #8B5CF6; }
.cat-tag-system       { background: #EFF4FF; color: #4F7CFF; }
.cat-tag-probability  { background: #ECFDF5; color: #16B364; }
.cat-tag-cognition    { background: #FDF2F8; color: #EC4899; }
.cat-tag-business     { background: #FFF7ED; color: #F97316; }
.cat-tag-leverage     { background: #ECFEFF; color: #06B6D4; }
.cat-tag-risk         { background: #FEF2F2; color: #EF4444; }
.cat-tag-decision     { background: #EEF2FF; color: #6366F1; }
.cat-tag-capital      { background: #FFFDF5; color: #D4A017; }
.cat-tag-info         { background: #ECFEFF; color: #22D3EE; }
.cat-tag-longterm     { background: #F7FEE7; color: #84CC16; }
.cat-tag-network      { background: #FAF5FF; color: #A855F7; }

/* 已读状态 */
.card-status {
  margin-left: auto;
  font-size: 20rpx;
  color: #16B364;
  font-weight: 500;
}

/* 标题 — 视觉核心 */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

/* Tags 降噪 — 纯文字连接 */
.card-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.rule-tag {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.tag-dot {
  font-size: 22rpx;
  color: var(--text-inactive);
  margin: 0 6rpx;
}

.tag-arrow {
  font-size: 26rpx;
  color: var(--text-inactive);
  margin-left: 12rpx;
  font-weight: 300;
}

.card-tags-empty {
  justify-content: flex-end;
}

/* 加载更多 */
.load-more {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.no-more {
  color: #D1D5DB;
}

xsg-empty {
  margin-top: 80rpx;
}
