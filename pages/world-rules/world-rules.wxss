/* ══════════════════════════════════════
   world-rules — v4.1 文字可见性紧急修复
   亮色卡片 × 深色文字 × 无截断全自适应
   ══════════════════════════════════════ */
@import '../../styles/tokens.wxss';

.page {
  background: #F4F5F7;
  padding: var(--sp-24);
  padding-top: calc(var(--sp-24) + env(safe-area-inset-top));
  min-height: 100vh;
}

/* ═══════════════════════════════════
   胶囊导航栏 — 横向滚动
   ═══════════════════════════════════ */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.cat-bar {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.cat-tag {
  display: inline-block;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #4A525E;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  transition: all 220ms ease;
  letter-spacing: 1rpx;
}

.cat-tag.active {
  color: #FFFFFF;
  font-weight: 700;
  background: linear-gradient(135deg, #7F56D9, #53389E);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(127, 86, 217, 0.35);
  letter-spacing: 2rpx;
  transform: scale(1.04);
}

/* ═══════════════════════════════════
   规则列表容器
   ═══════════════════════════════════ */
.rules-list {
  padding-top: 24rpx;
}

/* ═══════════════════════════════════
   规则卡片 — 亮色底 + 深色文字
   ═══════════════════════════════════ */
.rule-card {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 200ms ease;
  box-sizing: border-box;
  height: auto;
  max-height: none;
  overflow: visible;
  word-break: break-all;
}

.rule-card:active {
  background: #F9FAFB;
  border-color: #D0D5DD;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* ── 卡片顶部 编号 + 分类标签 ── */
.rule-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rule-card-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #7F56D9;
  letter-spacing: 2rpx;
  background: #F5F3FF;
  padding: 6rpx 18rpx;
  border-radius: 888rpx;
}

.rule-card-cat {
  font-size: 22rpx;
  font-weight: 600;
  color: #B45309;
  background: #FFF7ED;
  padding: 6rpx 20rpx;
  border-radius: 888rpx;
  letter-spacing: 1rpx;
}

/* ── 核心标题：强制深黑色 ── */
.rule-card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1F26 !important;
  line-height: 1.4;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

/* ── 正文内容：强制深灰色 ── */
.rule-card-summary {
  font-size: 26rpx;
  color: #4A525E !important;
  line-height: 1.8;
  margin-bottom: 12rpx;
  display: block;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 反方向推理 ── */
.rule-card-reverse {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #FFF5F5;
  border-left: 3rpx solid #FF6B6B;
  border-radius: 0 12rpx 12rpx 0;
}

.rule-card-reverse-label {
  font-size: 22rpx;
  color: #DC3545;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.rule-card-reverse-text {
  font-size: 24rpx;
  color: #4A525E !important;
  line-height: 1.7;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 行动建议 ── */
.rule-card-action {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: #FFFBF0;
  border-radius: 12rpx;
}

.rule-card-action-label {
  font-size: 22rpx;
  color: #B45309;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.rule-card-action-text {
  font-size: 24rpx;
  color: #4A525E !important;
  line-height: 1.7;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
}

/* ── 维度标签 ── */
.rule-card-dims {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.rule-card-dim {
  font-size: 20rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 4rpx 16rpx;
  border-radius: 888rpx;
  border: 1rpx solid #E5E7EB;
}

/* ── 分割线 ── */
.rule-card-divider {
  height: 1rpx;
  background: #E5E7EB;
  margin: 20rpx 0 0;
}
