/* world-rules — v5 沉浸式规则探索 */

.wr-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.wr-nav-left { width: 80rpx; }
.wr-nav-icon { font-size: 36rpx; color: var(--t1); }
.wr-nav-title { font-size: 34rpx; font-weight: 700; color: var(--t1); }
.wr-nav-right { width: 80rpx; text-align: right; }
.wr-nav-share { font-size: 36rpx; }

.wr-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}

.wr-num-badge {
  background: var(--bg2);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: var(--t2);
}

.wr-cat-tag {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #92400e;
}

.wr-card-hero {
  margin: 0 24rpx;
  background: var(--bg-base);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.wr-card-hero.slide-left {
  transform: translateX(-60rpx);
  opacity: 0;
}

.wr-card-hero.slide-right {
  transform: translateX(60rpx);
  opacity: 0;
}

.wr-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--t1);
  display: block;
}

.wr-divider {
  height: 1rpx;
  background: var(--border-light);
  margin: 28rpx 0;
}

.wr-section {
  margin-bottom: 28rpx;
}

.wr-section-head {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--t2);
  margin-bottom: 12rpx;
}

.wr-section-body {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--t1);
  display: block;
}

.wr-reverse {
  padding: 24rpx;
  background: var(--bg2);
  border-radius: 20rpx;
}

.wr-action {
  padding: 24rpx;
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
  border-radius: 20rpx;
}

.wr-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-top: 8rpx;
}

.wr-counter {
  font-size: 26rpx;
  color: var(--t3);
}

.wr-btn-next {
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 40rpx;
  border-radius: 48rpx;
  border: none;
}

.wr-btn-hover {
  opacity: 0.85;
}
