@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   world-rules — v4 全面视觉重构
   胶囊导航 × 枪钢卡片 × 无截断全自适应
   ══════════════════════════════════════ */

.page {
  background: var(--bg-primary);
  padding: var(--sp-24);
  padding-top: calc(var(--sp-24) + env(safe-area-inset-top));
  min-height: 100vh;
}

/* ═══════════════════════════════════
   🎯 胶囊导航栏 — 横向滚动
   ═══════════════════════════════════ */
.cat-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: var(--sp-12);
}

.cat-bar {
  display: inline-flex;
  gap: var(--sp-16);
  padding: var(--sp-8) 0 var(--sp-8);
}

.cat-tag {
  display: inline-block;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: #8890A8;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  transition: all 220ms ease;
  letter-spacing: 1rpx;
}

/* 激活态 — 紫色渐变高亮胶囊 */
.cat-tag.active {
  color: #FFFFFF;
  font-weight: 700;
  background: linear-gradient(135deg, #7F56D9, #53389E);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(127, 86, 217, 0.35);
  letter-spacing: 2rpx;
  transform: scale(1.04);
}

/* ═══════════════════════════════════
   🎯 规则列表容器
   ═══════════════════════════════════ */
.rules-list {
  padding-top: var(--sp-24);
}

/* ═══════════════════════════════════
   🎯 规则卡片 — Guns & Rules 质感
   ═══════════════════════════════════ */
.rule-card {
  position: relative;
  background: linear-gradient(180deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 2rpx 8rpx rgba(0,0,0,0.15),
    0 0 1rpx rgba(255,255,255,0.04);
  transition: all 200ms ease;
  box-sizing: border-box;
  /* 完全自适应 — 无固定高度/行数限制 */
  height: auto;
  max-height: none;
  overflow: visible;
  word-break: break-all;
}

.rule-card:active {
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.10);
  box-shadow:
    0 4rpx 16rpx rgba(0,0,0,0.20),
    0 0 2rpx rgba(255,255,255,0.06);
}

/* ── 卡片顶部 编号 + 分类标签 ── */
.rule-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rule-card-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #7F56D9;
  letter-spacing: 2rpx;
  background: rgba(127, 86, 217, 0.12);
  padding: 6rpx 18rpx;
  border-radius: 888rpx;
}

.rule-card-cat {
  font-size: 22rpx;
  font-weight: 500;
  color: #F5C14C;
  background: rgba(245, 193, 76, 0.10);
  padding: 6rpx 20rpx;
  border-radius: 888rpx;
  letter-spacing: 1rpx;
}

/* ── 核心标题 ── */
.rule-card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.4;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

/* ── 正文内容 — 完全自适应，绝不截断 ── */
.rule-card-summary {
  font-size: 26rpx;
  color: #D0D5E0;
  line-height: 1.8;
  margin-bottom: 12rpx;
  /* 物理保证不截断 */
  display: block;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 反方向推理 ── */
.rule-card-reverse {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 107, 107, 0.08);
  border-left: 3rpx solid #FF6B6B;
  border-radius: 0 12rpx 12rpx 0;
}

.rule-card-reverse-label {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.rule-card-reverse-text {
  font-size: 24rpx;
  color: #D0D5E0;
  line-height: 1.7;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
  white-space: pre-line;
}

/* ── 行动建议 ── */
.rule-card-action {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  background: rgba(245, 193, 76, 0.08);
  border-radius: 12rpx;
}

.rule-card-action-label {
  font-size: 22rpx;
  color: #F5C14C;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.rule-card-action-text {
  font-size: 24rpx;
  color: #D0D5E0;
  line-height: 1.7;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  word-break: break-all;
}

/* ── 维度标签 ── */
.rule-card-dims {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.rule-card-dim {
  font-size: 20rpx;
  color: #8890A8;
  background: rgba(255, 255, 255, 0.04);
  padding: 4rpx 16rpx;
  border-radius: 888rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* ── 分割线 ── */
.rule-card-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.04);
  margin: 20rpx 0 0;
}
