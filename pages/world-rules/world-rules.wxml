<!-- world-rules — v5 沉浸式规则探索（单卡导航） -->
<view class="page page-enter">
  <!-- 规则探索卡片 -->
  <block wx:if="{{currentRule}}">
    <view class="wr-navbar">
      <view class="wr-nav-left" bindtap="onPrev">
        <text class="wr-nav-icon">←</text>
      </view>
      <text class="wr-nav-title">规则探索</text>
      <view class="wr-nav-right">
        <text class="wr-nav-share" bindtap="onSharePoster">📤</text>
      </view>
    </view>

    <!-- 编号 + 分类标签 -->
    <view class="wr-meta-row">
      <view class="wr-num-badge">第{{currentIndex+1}}条</view>
      <view class="wr-cat-tag">{{currentRule.category || '世界运行规则'}}</view>
    </view>

    <!-- 主卡：大标题 -->
    <view class="wr-card wr-card-hero {{animating}}">
      <text class="wr-hero-title">{{currentRule.title || currentRule.core_strike || ''}}</text>
      <view class="wr-divider"></view>

      <!-- 🎯 规则解读卡 -->
      <view class="wr-section">
        <view class="wr-section-head">🎯 规则解读</view>
        <text class="wr-section-body">{{currentRule.summary || currentRule.logic_dissection || '暂未加载'}}</text>
      </view>

      <!-- 🔄 反方向推理卡 -->
      <view class="wr-section wr-reverse" wx:if="{{currentRule.detail || currentRule.reverse_inference}}">
        <view class="wr-section-head">🔄 反方向推理</view>
        <text class="wr-section-body">{{currentRule.detail || currentRule.reverse_inference}}</text>
      </view>

      <!-- 🎬 行动建议卡 -->
      <view class="wr-section wr-action" wx:if="{{currentRule.action || currentRule.action_advice}}">
        <view class="wr-section-head">🎬 行动建议</view>
        <text class="wr-section-body">{{currentRule.action || currentRule.action_advice}}</text>
      </view>
    </view>

    <!-- 底部导航 -->
    <view class="wr-footer">
      <text class="wr-counter">{{currentIndex+1}} / {{total}}</text>
      <button class="wr-btn-next" hover-class="wr-btn-hover" bindtap="onNext"
        disabled="{{currentIndex >= total - 1}}">下一条 →</button>
    </view>
  </block>

  <!-- 加载/空状态 -->
  <xsg-loading text="正在加载世界规则..." wx:if="{{loading}}" />
  <xsg-empty wx:elif="{{!currentRule}}" icon="📜" title="暂无规则" desc="请检查网络后重试" />
</view>
