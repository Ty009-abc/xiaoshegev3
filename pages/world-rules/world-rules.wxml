<!-- world-rules — v4 全面视觉重构 -->
<view class="page page-enter">
  <xsg-navbar title="世界规则库" showBack />
  <xsg-loading text="正在加载世界规则..." wx:if="{{loading}}" />
  <block wx:else>
    <!-- 🎯 胶囊导航栏 -->
    <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
      <view class="cat-bar">
        <view
          class="cat-tag {{activeCat===c ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          data-cat="{{item}}"
          bindtap="filterCat"
        >{{item}}</view>
      </view>
    </scroll-view>

    <!-- 🎯 规则卡片列表 -->
    <view class="rules-list">
      <block wx:for="{{rules}}" wx:for-item="r" wx:key="_id">
        <view wx:if="{{!activeCat || r.category===activeCat}}">
          <!-- rule-card — 独立卡片容器 -->
          <view class="rule-card" data-id="{{r._id}}" bindtap="goDetail" data-id="{{r._id}}">
            <!-- 顶部：编号 + 分类标签 -->
            <view class="rule-card-top">
              <text class="rule-card-num">{{r.num}}</text>
              <text class="rule-card-cat">{{r.category}}</text>
            </view>

            <!-- 核心标题 -->
            <view class="rule-card-title">{{r.title}}</view>

            <!-- 正文内容 — 底层逻辑拆解，完全展开 -->
            <view class="rule-card-summary">{{r.summary}}</view>

            <!-- 反方向推理 -->
            <view class="rule-card-reverse" wx:if="{{r.detail}}">
              <text class="rule-card-reverse-label">🔄 反方向推理</text>
              <text class="rule-card-reverse-text">{{r.detail}}</text>
            </view>

            <!-- 行动建议 -->
            <view class="rule-card-action" wx:if="{{r.action}}">
              <text class="rule-card-action-label">🎯 行动建议</text>
              <text class="rule-card-action-text">{{r.action}}</text>
            </view>

            <!-- 维度标签 -->
            <view class="rule-card-dims" wx:if="{{r.dimension}}">
              <block wx:for="{{r.dimension.split(' × ')}}" wx:for-item="dim" wx:key="*this">
                <text class="rule-card-dim">{{dim}}</text>
              </block>
            </view>

            <!-- 分割线（每张卡片底部） -->
            <view class="rule-card-divider"></view>
          </view>
        </view>
      </block>
    </view>

    <!-- 空态 -->
    <xsg-empty icon="📜" title="暂无规则" desc="世界规则正在收集中..." btnText="查看每日暴击" wx:if="{{!rules.length}}" />
  </block>
</view>
