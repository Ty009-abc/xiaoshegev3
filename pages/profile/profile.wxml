<!-- profile — v3.11 编组卡片化+黄金留白 -->
<view class="container">
  <xsg-navbar title="我的" light />

  <!-- 用户信息卡 -->
  <view class="user-card">
    <view class="user-info-row">
      <image class="user-avatar" src="{{user.avatarUrl}}" wx:if="{{user.avatarUrl}}" mode="aspectFill" />
      <view class="user-avatar placeholder" wx:else><text class="avatar-emoji">🧠</text></view>
      <view class="user-meta">
        <view class="username-line">
          <text class="username">{{user.nickname||'觉醒者'}}</text>
          <text class="level-badge">LV{{user.level||1}} {{profile.mainType||'认知探索者'}}</text>
        </view>
        <text class="user-status">{{isVip?'⭐VIP':'免费用户'}} · {{profile.mainType||'unclassified'}}</text>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stats-item">
        <text class="stats-num">{{user.cv||0}}</text>
        <text class="stats-label">认知值</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{user.streak||0}}</text>
        <text class="stats-label">连续学习(天)</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{(user.cv||0) % 100}}/100</text>
        <text class="stats-label">距下一级</text>
      </view>
    </view>
  </view>

  <!-- 成长面板 -->
  <growth-panel cv="{{user.cv||0}}" level="{{user.level||1}}" streak="{{user.streak||0}}" theme="light" />

  <!-- 勋章 -->
  <view class="badges-card" wx:if="{{badges.length}}">
    <badge-list badges="{{badges}}" />
  </view>

  <!-- ═══ 认知成长 — 编组卡片 ═══ -->
  <view class="menu-section">
    <text class="section-title">认知成长</text>
    <view class="menu-group-card">
      <view class="menu-item" bindtap="goChallenges">
        <text class="menu-icon">🎯</text>
        <text class="menu-text">挑战记录</text>
        <text class="menu-arrow">{{challengeCount}}次  ›</text>
      </view>
      <view class="menu-item" bindtap="goReports">
        <text class="menu-icon">📄</text>
        <text class="menu-text">我的报告</text>
        <text class="menu-arrow">{{reportCount}}份  ›</text>
      </view>
      <view class="menu-item" bindtap="goDaily">
        <text class="menu-icon">📅</text>
        <text class="menu-text">认知暴击记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goRules">
        <text class="menu-icon">📜</text>
        <text class="menu-text">世界规则收藏</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ═══ 高级功能 — 编组卡片 ═══ -->
  <view class="menu-section">
    <text class="section-title">高级功能</text>
    <view class="menu-group-card">
      <view class="menu-item" bindtap="goMembership" wx:if="{{!isVip}}">
        <text class="menu-icon">⭐</text>
        <text class="menu-text">升级会员</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goInvite">
        <text class="menu-icon">🎁</text>
        <text class="menu-text">邀请好友</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goRanking">
        <text class="menu-icon">🏆</text>
        <text class="menu-text">认知排行榜</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- ═══ 记忆档案 — 编组卡片 ═══ -->
  <view class="menu-section">
    <text class="section-title">记忆档案</text>
    <view class="menu-group-card">
      <view class="menu-item" bindtap="goMemoryProfile">
        <text class="menu-icon">🧠</text>
        <text class="menu-text">我的认知档案</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item">
        <text class="menu-icon">💾</text>
        <text class="menu-text">记忆开关</text>
        <switch checked="{{memoryEnabled}}" bindchange="onToggleMemory" color="#7F56D9" />
      </view>
      <view class="menu-item menu-item-danger" bindtap="onClearMemory">
        <text class="menu-icon">🗑️</text>
        <text class="menu-text danger">清除全部记忆</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version-footer" bindtap="onTapVersion">珠澳小事哥 · 认知操作系统 v3.11</view>
  <view style="height:120rpx;"></view>
</view>
