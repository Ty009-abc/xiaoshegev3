@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   pages/profile — v3.11 编组卡片化+黄金留白
   ══════════════════════════════════════ */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  padding: 40rpx 32rpx 240rpx;
  box-sizing: border-box;
}

/* ── 用户信息卡 ── */
.user-card {
  background: #FFFFFF;
  border: 1rpx solid #eaecf0;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  margin-bottom: 48rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.user-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.user-avatar.placeholder {
  background: #F4F3FF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E0D7FE;
}
.avatar-emoji { font-size: 56rpx; }

.user-meta { flex: 1; min-width: 0; }

.username-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.username {
  font-size: 34rpx;
  font-weight: 700;
  color: #101828;
}

.level-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #7F56D9;
  background: #F4F3FF;
  border: 1rpx solid #E0D7FE;
}

.user-status {
  font-size: 24rpx;
  color: #667085;
}

/* ── 指标网格 ── */
.stats-grid {
  display: flex;
  justify-content: space-between;
  text-align: center;
}
.stats-item { flex: 1; }

.stats-num {
  color: #7F56D9;
  font-size: 38rpx;
  font-weight: 700;
  display: block;
}

.stats-label {
  color: #475467;
  font-size: 24rpx;
  margin-top: 8rpx;
  display: block;
}

/* ── 勋章 ── */
.badges-card { margin-top: 24rpx; }

/* ═══════════════════════════════
   编组卡片菜单
   ═══════════════════════════════ */

.menu-section { margin-top: 40rpx; }

.section-title {
  color: #667085;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  display: block;
}

/* 编组大卡片 */
.menu-group-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.015);
  border: 1rpx solid #F2F4F7;
}

/* 内部分隔线 */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  border-bottom: 1rpx solid #F2F4F7;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #F9FAFB; margin: 0 -32rpx; padding: 0 32rpx; }

.menu-icon {
  font-size: 32rpx;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #344054;
  margin-left: 16rpx;
}
.menu-text.danger { color: #FF6B6B; }

.menu-arrow {
  font-size: 28rpx;
  color: #98A2B3;
}

.menu-item-danger:active { background: #FFF5F5; margin: 0 -32rpx; padding: 0 32rpx; }

/* ── 版本 ── */
.version-footer {
  text-align: center;
  padding: 48rpx 0 16rpx;
  font-size: 24rpx;
  color: #D0D5DD;
}
