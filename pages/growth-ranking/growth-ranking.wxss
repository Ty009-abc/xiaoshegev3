/* ══════════════════════════════════════
   pages/growth-ranking — 浅色主题
   ══════════════════════════════════════ */

page { background: #F5F7FB; }

.page {
  min-height: 100vh;
  padding: 0 28rpx 64rpx;
  box-sizing: border-box;
  background: #F5F7FB;
  color: #121827;
  padding-top: calc(24rpx + env(safe-area-inset-top));
}

/* ═══════════ 动画 ═══════════ */
.anim-fade-in { animation: fadeIn .35s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }

/* ═══════════ Tab 导航 ═══════════ */
.tabs {
  display: flex;
  margin: 24rpx 0 28rpx;
  padding: 8rpx;
  background: #EEF0F5;
  border-radius: 24rpx;
}

.tab {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 29rpx;
  border-radius: 18rpx;
  transition: all .25s ease;
}

.tab.active {
  background: #FFFFFF;
  color: #121827;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(20,27,45,.08);
}

/* ═══════════ 我的排名卡 ═══════════ */
.my-rank-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFF9E6, #FFFDF5);
  border: 1rpx solid #F5E6B8;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180,140,50,.08);
}

.mr-icon { font-size: 36rpx; }

.mr-rank {
  font-size: 34rpx;
  font-weight: 800;
  color: #D89A3B;
}

.mr-name {
  flex: 1;
  font-size: 30rpx;
  color: #121827;
}

.mr-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #D89A3B;
}

/* ═══════════ 榜单列表 ═══════════ */
.rank-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(20,27,45,.06);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #F2F3F7;
}

.rank-item:last-child { border-bottom: none; }

.ri-rank {
  width: 64rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #667085;
  text-align: center;
}

.ri-rank.top0 { color: #F0B90B; font-weight: 800; font-size: 34rpx; }
.ri-rank.top1 { color: #9CA3AF; font-weight: 800; font-size: 34rpx; }
.ri-rank.top2 { color: #D4883C; font-weight: 800; font-size: 34rpx; }

.ri-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #EEF0F5;
}

.ri-name {
  flex: 1;
  font-size: 29rpx;
  color: #121827;
}

.ri-val {
  font-size: 28rpx;
  font-weight: 700;
  color: #6B7280;
}

/* ═══════════ 空状态 ═══════════ */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(20,27,45,.06);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #121827;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 27rpx;
  color: #667085;
  text-align: center;
  line-height: 1.7;
}

/* ═══════════ 错误状态 ═══════════ */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(20,27,45,.06);
}

.error-title {
  font-size: 30rpx;
  color: #EF4444;
  margin-bottom: 20rpx;
}

.error-btn {
  padding: 16rpx 48rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #7B55F5, #4E7CFF);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-btn::after { border: none; }
