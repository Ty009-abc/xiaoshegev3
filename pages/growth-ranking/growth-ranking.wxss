@import '../../styles/tokens.wxss';
.page{background:var(--bg-primary);min-height:100vh;padding:var(--sp-24);padding-top:calc(var(--sp-24)+env(safe-area-inset-top));}
.tabs{display:flex;gap:var(--sp-16);margin-bottom:var(--sp-24);}
.tab{padding:var(--sp-12) var(--sp-32);border-radius:var(--radius-tag);font-size:var(--font-caption);color:var(--text-secondary);background:#0f1526;}
.tab.active{background:var(--accent-gold-soft);color:var(--accent-gold);font-weight:600;}
.my-rank{display:flex;align-items:center;gap:var(--sp-12);}
.mr-icon{font-size:32rpx;}
.mr-rank{font-size:var(--font-h3);font-weight:800;color:var(--accent-gold);}
.mr-name{font-size:var(--font-body);color:var(--text-primary);flex:1;}
.mr-val{font-size:var(--font-body);font-weight:700;color:var(--accent-gold);}
.rank-item{display:flex;align-items:center;padding:var(--sp-24);border-bottom:1rpx solid rgba(255,255,255,0.04);}
.ri-rank{width:60rpx;font-size:var(--font-body);font-weight:600;color:var(--text-secondary);}
.ri-rank.top0{color:#FFD700;font-weight:800;}
.ri-rank.top1{color:#C0C0C0;font-weight:800;}
.ri-rank.top2{color:#CD7F32;font-weight:800;}
.ri-name{flex:1;font-size:var(--font-body);color:var(--text-primary);}
.ri-val{font-size:var(--font-body);font-weight:700;color:var(--text-secondary);}
