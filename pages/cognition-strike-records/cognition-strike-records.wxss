/* pages/cognition-strike-records — RC8.8 认知暴击记录（浅科技感） */
.page {
  min-height: 100vh;
  background: #F7F8FC;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(127, 86, 217, 0.10);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}
.record-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.record-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.record-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2939;
  line-height: 1.35;
}

.record-time {
  font-size: 24rpx;
  color: #667085;
}

.record-arrow {
  font-size: 40rpx;
  color: #98A2B3;
  margin-left: 16rpx;
  flex-shrink: 0;
}
