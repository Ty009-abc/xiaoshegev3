<!-- challenge-result — R9 production UI -->
<view class="page">
  <xsg-navbar title="挑战结果" light />
  <xsg-loading text="正在分析你的认知画像..." wx:if="{{loading}}" />
  <block wx:elif="{{result}}">
    <!-- B. 世界模型类型（仅用户可见中文名，绝不显示内部枚举） -->
    <view class="result-hero anim-fade-in">
      <text class="r-type">{{result.mainType||'认知探索者'}}</text>
      <text class="r-sub">你的世界模型初步类型</text>
      <text class="r-summary" wx:if="{{result.summary}}">{{result.summary}}</text>
    </view>

    <!-- C. 九维评分 3x3 -->
    <xsg-card theme="light" class="anim-fade-in">
      <view class="scores-title">九维评分</view>
      <view class="scores-grid">
        <view class="score" wx:for="{{dimKeys}}" wx:for-item="d" wx:key="*this">
          <text class="sc-num">{{result.profile[d]||50}}</text>
          <text class="sc-label">{{dimLabels[d]}}</text>
        </view>
      </view>
    </xsg-card>

    <!-- D. 核心特征（最多 8 个，取高价值标签，不倾倒内部标签池） -->
    <xsg-card theme="light" wx:if="{{result.coreTraits && result.coreTraits.length}}" class="anim-fade-in">
      <view class="scores-title">核心特征</view>
      <view class="tag-row"><xsg-tag wx:for="{{result.coreTraits}}" wx:for-item="t" wx:key="*this" text="{{t}}" type="gold" /></view>
    </xsg-card>

    <!-- F. 主 CTA：报告实体已存在，使用「查看」而非「生成」 -->
    <xsg-button type="ai" text="查看我的世界模型报告" bind:tapbutton="goReport" class="anim-fade-in" />
  </block>
</view>
