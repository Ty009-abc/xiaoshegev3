@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   pages/challenge-result — 灰白质感
   ══════════════════════════════════════ */

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: #f8f9fa;
}

.icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  color: #101828;
  display: block;
  margin-bottom: 12rpx;
}

.sub {
  font-size: 30rpx;
  color: #667085;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.scores {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
  justify-content: center;
}

.score-item {
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #eaecf0;
  text-align: center;
  min-width: 120rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
}

.si-label {
  font-size: 24rpx;
  color: #667085;
  display: block;
}

.si-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #7F56D9;
  display: block;
  margin-top: 4rpx;
}
