@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════════════════════════════
   pages/challenge-result — R9 视觉升级
   浅色毛玻璃 + 紫/粉霓虹 + 未来科技感（Glassmorphism / Neon）
   基调：浅灰白底 + 大面积弥散渐变氛围光；主色 紫#7B61FF 粉#D94BFF 蓝紫#5B8CFF
   ══════════════════════════════════════════════════════════════ */

page { background: #EEF0F7; }

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ── 弥散氛围光 ── */
.ambient {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.55;
}
.orb-1 {
  width: 560rpx; height: 560rpx;
  top: -160rpx; left: -140rpx;
  background: radial-gradient(circle, rgba(123,97,255,0.55), rgba(123,97,255,0));
  animation: drift 14s ease-in-out infinite alternate;
}
.orb-2 {
  width: 480rpx; height: 480rpx;
  top: 120rpx; right: -160rpx;
  background: radial-gradient(circle, rgba(217,75,255,0.42), rgba(217,75,255,0));
  animation: drift 18s ease-in-out infinite alternate-reverse;
}
.orb-3 {
  width: 520rpx; height: 520rpx;
  bottom: -180rpx; left: 30rpx;
  background: radial-gradient(circle, rgba(91,140,255,0.40), rgba(91,140,255,0));
  animation: drift 16s ease-in-out infinite alternate;
}
@keyframes drift {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to   { transform: translate3d(30rpx, 24rpx, 0) scale(1.08); }
}

/* ── 内容层 ── */
.content {
  position: relative;
  z-index: 1;
  padding: 8rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

/* ══════════ A. Hero ══════════ */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx 0 40rpx;
}
.hero-sphere {
  position: relative;
  width: 240rpx; height: 240rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 28rpx;
}
.sphere-core {
  width: 132rpx; height: 132rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #B79CFF, #7B61FF 42%, #D94BFF 100%);
  box-shadow: 0 0 60rpx rgba(123,97,255,0.55), inset 0 0 40rpx rgba(255,255,255,0.25);
}
.sphere-glow {
  position: absolute;
  width: 210rpx; height: 210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(217,75,255,0.35), rgba(217,75,255,0));
  filter: blur(20rpx);
}
.sphere-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(123,97,255,0.35);
  box-sizing: border-box;
}
.ring-1 { width: 200rpx; height: 200rpx; animation: spin 20s linear infinite; border-top-color: rgba(217,75,255,0.65); }
.ring-2 { width: 240rpx; height: 240rpx; animation: spin 32s linear infinite reverse; border-left-color: rgba(91,140,255,0.65); }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.hero-eyebrow {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #7B61FF;
  font-weight: 600;
  text-transform: uppercase;
  opacity: 0.85;
}
.hero-type {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-top: 14rpx;
  background: linear-gradient(120deg, #5B3BE0, #7B61FF 45%, #D94BFF);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub {
  display: block;
  font-size: 28rpx;
  color: #66708A;
  margin-top: 14rpx;
}
.hero-summary {
  margin-top: 26rpx;
  padding: 26rpx 30rpx;
  max-width: 600rpx;
  border-radius: 26rpx;
  background: rgba(255,255,255,0.55);
  border: 1rpx solid rgba(123,97,255,0.18);
  box-shadow: 0 8rpx 30rpx rgba(123,97,255,0.10);
  backdrop-filter: blur(10rpx);
}
.hs-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: #3C4664;
  font-weight: 500;
}

/* ══════════ 通用玻璃卡片 ══════════ */
.glass-card {
  margin-top: 32rpx;
  padding: 36rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.62);
  border: 1rpx solid rgba(123,97,255,0.16);
  box-shadow: 0 12rpx 40rpx rgba(70,80,140,0.10);
  backdrop-filter: blur(14rpx);
}
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1C2440;
}
.card-hint {
  font-size: 22rpx;
  color: #8A93AE;
}

/* ══════════ B. 雷达图 ══════════ */
.radar-wrap {
  position: relative;
  width: 100%;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.radar-canvas {
  width: 480rpx;
  height: 480rpx;
}
.radar-fade {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}
.radar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
  margin-top: 26rpx;
  justify-content: center;
}
.lg-item {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(123,97,255,0.07);
  border: 1rpx solid rgba(123,97,255,0.14);
}
.lg-label { font-size: 23rpx; color: #66708A; }
.lg-val { font-size: 26rpx; font-weight: 800; color: #7B61FF; font-variant-numeric: tabular-nums; }

/* ══════════ C. 核心特征 ══════════ */
.trait-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.trait-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(30,34,60,0.92), rgba(44,38,80,0.92));
  border: 1rpx solid rgba(123,97,255,0.42);
  box-shadow: 0 0 18rpx rgba(123,97,255,0.22), inset 0 0 12rpx rgba(123,97,255,0.10);
  animation: chipIn 0.5s ease-out both;
}
.tc-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #F3E4C4;               /* 暖金白 —— 深色底上高对比 */
  letter-spacing: 0.5rpx;
}
@keyframes chipIn {
  from { opacity: 0; transform: translateY(12rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ══════════ D. 霓虹主 CTA ══════════ */
.cta-wrap {
  display: flex;
  justify-content: center;
  padding: 52rpx 0 20rpx;
}
.neon-cta {
  width: 78%;
  height: 96rpx;
  border: none;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(120deg, #7B61FF 0%, #9E5BFF 50%, #D94BFF 100%);
  box-shadow: 0 14rpx 40rpx rgba(123,97,255,0.42), 0 0 30rpx rgba(217,75,255,0.28);
  animation: breath 3.4s ease-in-out infinite;
  transition: transform 0.15s ease-out;
  padding: 0;
}
.neon-cta::after { border: none; }
.neon-cta-hover { transform: scale(0.965); opacity: 0.94; }
.nc-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}
@keyframes breath {
  0%, 100% { box-shadow: 0 14rpx 40rpx rgba(123,97,255,0.40), 0 0 26rpx rgba(217,75,255,0.22); }
  50%      { box-shadow: 0 16rpx 48rpx rgba(123,97,255,0.55), 0 0 44rpx rgba(217,75,255,0.40); }
}

/* ══════════ 动效 ══════════ */
.anim-fade-up {
  animation: fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.anim-d1 { animation-delay: 0.08s; }
.anim-d2 { animation-delay: 0.16s; }
.anim-d3 { animation-delay: 0.24s; }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 兼容：仍保留 anim-fade-in 别名（历史引用）*/
.anim-fade-in { animation: fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
