@import '../../styles/tokens.wxss';
/* ══════════════════════════════════════
   pages/challenge-result — 亮底灰白质感
   R7: reconcile WXML classes with real definitions + light theme tokens.
   Root cause was class drift (WXML classes undefined → inherited page
   near-black text on dark xsg-card). No hardcoded white masking.
   ══════════════════════════════════════ */

page { background: #f4f5f7; }

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f8f9fa;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: #f8f9fa;
}

/* ── hero / world-model type ── */
.result-hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 0 32rpx;
}
.r-type {
  font-size: 48rpx;
  font-weight: 800;
  color: #101828;            /* dark text on light bg */
  line-height: 1.3;
  display: block;
}
.r-sub {
  font-size: 28rpx;
  color: #667085;
  margin-top: 12rpx;
  display: block;
}

/* ── scores ── */
.scores-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
  text-align: left;
  margin-bottom: 24rpx;
}
.scores-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: space-between;
}
.score {
  width: 30%;
  padding: 20rpx 0;
  border-radius: 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #EAECF0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}
.sc-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #7F56D9;            /* purple accent, readable on light */
  font-variant-numeric: tabular-nums;
  display: block;
}
.sc-label {
  font-size: 24rpx;
  color: #667085;
  margin-top: 4rpx;
  display: block;
}

/* ── tags ── */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* ── share / poster CTA ── */
.share-cta {
  display: flex;
  align-items: center;
  width: 100%;
}
.scta-icon { font-size: 36rpx; margin-right: 16rpx; }
.scta-text {
  flex: 1;
  text-align: left;
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}
.scta-arrow { font-size: 32rpx; color: #7F56D9; }

/* ── legacy aliases kept for safety (harmless) ── */
.icon { font-size: 120rpx; display: block; margin-bottom: 24rpx; }
.title { font-size: 48rpx; font-weight: 800; color: #101828; display: block; margin-bottom: 12rpx; }
.sub { font-size: 30rpx; color: #667085; display: block; margin-bottom: 32rpx; line-height: 1.6; }
.scores { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 32rpx; justify-content: center; }
.score-item { padding: 16rpx 24rpx; border-radius: 32rpx; background: #FFFFFF; border: 1rpx solid #eaecf0; text-align: center; min-width: 120rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03); }
.si-label { font-size: 24rpx; color: #667085; display: block; }
.si-value { font-size: 40rpx; font-weight: 800; color: #7F56D9; display: block; margin-top: 4rpx; }
