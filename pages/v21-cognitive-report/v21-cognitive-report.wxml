<!--
  pages/v21-cognitive-report/v21-cognitive-report.wxml
  RC8.3 Stage1B R3 — V2.1 认知报告渲染（TEST_PREVIEW_ONLY）
  R4.4: 自定义导航安全区 + 展示层本地化 + 多模型状态卡
-->
<view class="page">

  <!-- 自定义导航安全区：避免内容顶到状态栏/胶囊区（仅布局） -->
  <view class="nav-safe" style="height: {{totalNavHeight}}px;"></view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>

  <block wx:else>
    <!-- 标题 -->
    <view class="header">
      <text class="badge">认知测评 · 预览</text>
      <text class="title">认知世界模型报告</text>
      <text class="subtitle">基于 18 题认知测评的确定性诊断</text>
    </view>

    <!-- 核心表达（确定性，条件语言，非预测） -->
    <view class="card">
      <text class="card-title">核心发现</text>
      <text class="expression">{{expression}}</text>
    </view>

    <!-- 多模型状态 / 主要认知风险群（MULTIPLE_SUPPORTED_MODELS） -->
    <view class="card" wx:if="{{multiModel}}">
      <text class="card-title">主要认知风险群</text>
      <text class="reason">系统识别到 {{multiModel.supportedModelCount}} 个相互竞争的认知盲区，因此未武断指定唯一主因：</text>
      <view class="risk-item" wx:for="{{multiModel.models}}" wx:key="label">
        <text class="risk-label">{{item.label}}</text>
        <text class="risk-q">{{item.questionAnswered}}</text>
        <text class="risk-state">{{item.dimensionStateLabel}}</text>
      </view>
    </view>

    <!-- 认知盲区（唯一主因时展示） -->
    <view class="card" wx:if="{{blindSpot}}">
      <text class="card-title">主要认知盲区</text>
      <text class="main">{{blindSpot.label}}</text>
      <text class="reason">{{blindSpot.questionAnswered}}</text>
    </view>

    <view class="card" wx:if="{{verdict && verdict.status === 'NO_PRIMARY_DEFICIT'}}">
      <text class="card-title">结论</text>
      <text class="main">未发现明确的主要认知盲区</text>
    </view>

    <!-- 策略状态 -->
    <view class="card" wx:if="{{strategy}}">
      <text class="card-title">认知升级策略</text>
      <text class="main">{{strategy.label}}</text>
      <text class="reason">{{strategy.mechanism}}</text>
    </view>
    <view class="card" wx:elif="{{multiModel}}">
      <text class="card-title">策略状态</text>
      <text class="reason">暂不生成单一路径策略：多个认知模型仍处于并列支持状态，系统不为其臆造唯一方案。</text>
    </view>

    <!-- 认知原型（描述性，非经济含义） -->
    <view class="card" wx:if="{{archetype}}">
      <text class="card-title">认知原型</text>
      <text class="main">{{archetype.label}}</text>
      <text class="reason">{{archetype.description}}</text>
    </view>

    <!-- 世界模型 9 维度（分类状态，非数值评分） -->
    <view class="card" wx:if="{{worldModel}}">
      <text class="card-title">世界模型维度</text>
      <view class="dim" wx:for="{{worldModel.dimensions}}" wx:key="constructLabel">
        <text class="dim-construct">{{item.constructLabel}}</text>
        <text class="dim-state">{{item.orientationLabel}} · {{item.stateLabel}}</text>
      </view>
    </view>

    <!-- 场景推演（条件语言，非预测） -->
    <view class="card" wx:if="{{scenario && scenario.currentModelScenario}}">
      <text class="card-title">情景推演（条件性，非预测）</text>
      <text class="reason">当前模式下的可能后果：</text>
      <text wx:for="{{scenario.currentModelScenario.possibleConsequences}}" wx:key="*this" class="li">· {{item}}</text>
    </view>

    <button class="back" bindtap="onBack">返回</button>
  </block>

</view>
