.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 40rpx;
  box-sizing: border-box;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: #5a6078;
  font-size: 30rpx;
}

.header {
  margin-bottom: 32rpx;
}

.badge {
  display: inline-block;
  background: #f5f3ff;
  color: #7f56d9;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a90a6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 26rpx;
  color: #7f56d9;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.expression {
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.7;
}

.main {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.reason {
  display: block;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
}

.li {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
  margin-top: 8rpx;
}

.dim {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.dim-construct {
  font-size: 28rpx;
  color: #1a1a2e;
}

.dim-state {
  font-size: 26rpx;
  color: #8a90a6;
}

.back {
  margin-top: 16rpx;
  background: #fff;
  color: #5a6078;
  border-radius: 16rpx;
  font-size: 32rpx;
}
