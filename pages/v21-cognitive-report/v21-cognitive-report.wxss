/* pages/v21-cognitive-report/v21-cognitive-report.wxss
   RC8.3 Stage1C-D1 — North Star report UI */

.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0rpx));
}

/* 自定义导航安全区（仅布局） */
.nav-safe {
  width: 100%;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: #5a6078;
  font-size: 30rpx;
  line-height: 1.6;
}

/* 非 UNIQUE 中性状态块 */
.state-block {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-top: 20rpx;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.state-message {
  display: block;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.retake {
  background: #7f56d9;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

/* ═══ 首屏 hero（核心诊断最高视觉层级）═══ */
.hero {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #7f56d9;
}

.hero-eyebrow {
  display: block;
  font-size: 24rpx;
  color: #7f56d9;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.hero-verdict {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.6;
}

.hero-label {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #8a90a6;
  background: #f5f3ff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* ═══ 通用卡片 ═══ */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 28rpx;
  color: #7f56d9;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.card-body {
  display: block;
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.7;
}

/* ═══ 03 对比卡片（北极星视觉中心）═══ */
.contrast-block {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fafafc;
  margin-bottom: 16rpx;
}

.contrast-world {
  background: #f5f3ff;
}

.contrast-gap {
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.contrast-label {
  display: block;
  font-size: 22rpx;
  color: #8a90a6;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.contrast-text {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.6;
}

.vs-mark {
  text-align: center;
  font-size: 24rpx;
  color: #b0b4c4;
  padding: 8rpx 0;
  letter-spacing: 2rpx;
}

.why-matters {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f1f5;
}

.why-matters-title {
  display: block;
  font-size: 22rpx;
  color: #7f56d9;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.why-matters-text {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
  margin-top: 6rpx;
}

/* ═══ 04 证据卡片 ═══ */
.evidence-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.evidence-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.evidence-q {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.evidence-answer {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.evidence-signal {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.evidence-support {
  display: block;
  font-size: 24rpx;
  color: #7f56d9;
  line-height: 1.5;
}

/* ═══ 07 决策协议 ═══ */
.protocol-trigger {
  padding: 20rpx;
  background: #f5f3ff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.protocol-step {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.protocol-step:last-child {
  border-bottom: none;
}

.protocol-step-num {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: #7f56d9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-bottom: 8rpx;
}

.protocol-step-label {
  display: inline-block;
  font-size: 22rpx;
  color: #7f56d9;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.protocol-step-name {
  display: block;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.protocol-step-text {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
}

/* ═══ 08 场景对比 ═══ */
.scenario-side {
  padding: 20rpx;
  background: #fafafc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.scenario-upgraded {
  background: #f5f3ff;
}

.scenario-side-label {
  display: block;
  font-size: 24rpx;
  color: #1a1a2e;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.scenario-li {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
  margin-top: 6rpx;
}

.scenario-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b0b4c4;
  text-align: center;
}

/* ═══ 09 折叠卡片（完整认知地图）═══ */
.card-collapsible {
  padding: 0;
}

.collapsible-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.collapsible-head .card-title {
  margin-bottom: 0;
}

.collapsible-arrow {
  font-size: 24rpx;
  color: #7f56d9;
}

.collapsible-body {
  padding: 0 32rpx 32rpx;
}

.secondary-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.secondary-block:last-child {
  border-bottom: none;
}

.secondary-label {
  display: block;
  font-size: 22rpx;
  color: #8a90a6;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.secondary-main {
  display: block;
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.secondary-text {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
}

.map-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.map-row:last-child {
  border-bottom: none;
}

.map-dim {
  font-size: 28rpx;
  color: #1a1a2e;
}

.map-state {
  font-size: 24rpx;
  color: #8a90a6;
}

.back {
  margin-top: 16rpx;
  background: #fff;
  color: #5a6078;
  border-radius: 16rpx;
  font-size: 32rpx;
}

/* ═══ F2-M2 Layer-1 影响摘要 ═══ */
.impact-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.impact-section:last-child {
  border-bottom: none;
}

.impact-title {
  display: block;
  font-size: 26rpx;
  color: #7f56d9;
  margin-bottom: 8rpx;
}

.impact-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a2e;
}

.impact-li {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a2e;
  margin-top: 4rpx;
}
