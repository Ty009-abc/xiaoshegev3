.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  /* 底部安全区（全面屏 home indicator） */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0rpx));
}

/* 自定义导航安全区占位：高度由 JS 运行时测量（状态栏+胶囊区），
   仅用于把内容推到胶囊下方，不参与渲染逻辑 */
.nav-safe {
  width: 100%;
  flex-shrink: 0;
  /* 胶囊下方的小额安全视觉间距 */
  margin-bottom: 20rpx;
}

.state {
  padding-top: 160rpx;
  text-align: center;
  color: #5a6078;
  font-size: 30rpx;
}

.header {
  margin-bottom: 32rpx;
}

.badge {
  display: inline-block;
  background: #f5f3ff;
  color: #7f56d9;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a90a6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 26rpx;
  color: #7f56d9;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.expression {
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.7;
}

.main {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.reason {
  display: block;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
}

.li {
  display: block;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.6;
  margin-top: 8rpx;
}

.dim {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.dim-construct {
  font-size: 28rpx;
  color: #1a1a2e;
}

.dim-state {
  font-size: 26rpx;
  color: #8a90a6;
}

/* 主要认知风险群（多模型状态） */
.risk-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.risk-q {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #5a6078;
  line-height: 1.5;
}

.risk-state {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7f56d9;
  background: #f5f3ff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.back {
  margin-top: 16rpx;
  background: #fff;
  color: #5a6078;
  border-radius: 16rpx;
  font-size: 32rpx;
}
