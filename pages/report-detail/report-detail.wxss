/* report-detail — Progressive Reveal 暗黑质感 */

.page {
  background: #121620;
  min-height: 100vh;
  padding: 0 0 60rpx;
}

/* ═══ 报告板块容器 ═══ */
.report-blocks {
  padding: 30rpx 30rpx 0;
}

/* ═══ 板块卡片 ═══ */
.section-card {
  background: #191F2E;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}
.section-card.red-card {
  background: rgba(255, 59, 48, 0.06);
  border: 1rpx solid rgba(255, 59, 48, 0.15);
}

/* ═══ 标题行 ═══ */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-badge {
  background: #7B57FF;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.bg-red { background: #FF3B30 !important; }

.section-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
}
.text-red { color: #FF453A !important; }

/* ═══ 正文 ═══ */
.section-body {
  min-height: 60rpx;
}

.real-text {
  font-size: 26rpx;
  color: #D0D5E0;
  line-height: 1.7;
  display: block;
}
.fatal-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #FF453A !important;
}

/* ═══ 三点跳动加载动画 ═══ */
.loading-typing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}
.typing-text {
  font-size: 26rpx;
  color: #6E758A;
}
.typing-dots {
  display: flex;
  gap: 6rpx;
  align-items: center;
}
.td-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #A78BFA;
  animation: dotBounce 1.2s infinite;
}
.td-dot:nth-child(2) { animation-delay: 0.2s; }
.td-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

/* ═══ 分段揭晓 fade-in ═══ */
.fade-in {
  animation: revealFade 0.5s ease-out;
}
@keyframes revealFade {
  from { opacity: 0; transform: translateY(8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ═══ 合规 ═══ */
.compliance-tips {
  font-size: 22rpx;
  color: #6E758A;
  text-align: center;
  padding: 40rpx 32rpx 20rpx;
}

/* ═══ 底部按钮 ═══ */
.action-row {
  display: flex;
  justify-content: center;
  padding: 16rpx 32rpx 48rpx;
}
.btn-retry {
  width: 320rpx;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #22293D;
  color: #A0A5B5;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-retry::after { border: none; }
