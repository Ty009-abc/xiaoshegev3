<!-- report-detail — V5 Redesign + V3 Legacy -->
<view class="page">

  <!-- ═══ Loading — V5 Cognitive Orbit ═══ -->
  <view class="v5-loading-screen" wx:if="{{loading}}">
    <view class="v5-loading-spacer"></view>
    <view class="v5-loading-body">
      <!-- 认知推演轨道 -->
      <view class="v5-orbit">
        <view class="v5-orbit-ring v5-orbit-outer"></view>
        <view class="v5-orbit-ring v5-orbit-inner"></view>
        <view class="v5-orbit-core">
          <text class="v5-orbit-core-text">翻</text>
        </view>
        <!-- 光点 -->
        <view class="v5-orbit-dot v5-orbit-dot-1"></view>
        <view class="v5-orbit-dot v5-orbit-dot-2"></view>
        <view class="v5-orbit-dot v5-orbit-dot-3"></view>
      </view>

      <!-- 主标题 -->
      <text class="v5-loading-title">小事哥正在推演你的翻身路径</text>

      <!-- 动态副标题 -->
      <text class="v5-loading-sub">{{loadingStepText}}</text>

      <!-- 五阶段进度点 -->
      <view class="v5-loading-steps">
        <block wx:for="{{loadingSteps}}" wx:key="*this">
          <view class="v5-loading-dot {{item.active ? 'v5-loading-dot-on' : ''}}"></view>
          <view class="v5-loading-line" wx:if="{{index < loadingSteps.length - 1}}"></view>
        </block>
      </view>
      <text class="v5-loading-step-text">第 {{loadingStepIndex}} / {{loadingSteps.length}} 步</text>

      <!-- 可信度说明 -->
      <text class="v5-loading-meta">本次推演将综合现金流、能力、时间、执行力与风险承受，\n排除不适合的路径，而非随机生成建议。</text>
    </view>

    <!-- 底部品牌签名 -->
    <view class="v5-loading-footer">
      <text class="v5-loading-brand">珠澳小事哥・认知翻身策略</text>
      <text class="v5-loading-slogan">翻身从来不是拼命，而是看懂规则。</text>
    </view>
  </view>

  <!-- ═══ Error ═══ -->
  <view class="v5-loading-screen" wx:elif="{{error}}">
    <view class="v5-loading-spacer"></view>
    <view class="v5-loading-body">
      <view class="v5-orbit" style="opacity:0.3">
        <view class="v5-orbit-core">
          <text class="v5-orbit-core-text" style="color:#EF4B4B">!</text>
        </view>
      </view>
      <text class="v5-loading-title" style="color:#EF4B4B">推演暂时中断</text>
      <text class="v5-loading-sub">{{error}}</text>
      <button class="v5-loading-retry" bindtap="onRetry">重新尝试</button>
    </view>
    <view class="v5-loading-footer">
      <text class="v5-loading-brand">珠澳小事哥・认知翻身策略</text>
      <text class="v5-loading-slogan">翻身从来不是拼命，而是看懂规则。</text>
    </view>
  </view>

  <!-- ═══════════════════════════════════
       V5 Redesign
       ═══════════════════════════════════ -->
  <block wx:elif="{{reportVersion === 'v4' && viewModel}}">
    <scroll-view class="report-scroll" scroll-y enhanced show-scrollbar="{{false}}">

      <!-- ══════════════════ 01 品牌头部 ══════════════════ -->
      <view class="v5-hero-top" style="padding-top: {{brandHeaderTop}}px;">
        <view class="v5-brand-row">
          <text class="v5-brand-title">珠澳小事哥・认知翻身策略</text>
          <text class="v5-brand-sub">
            <text class="v5-brand-emoji">🧠</text> 认知教练视角已激活
          </text>
        </view>

        <!-- ══════════════════ 02 翻身判决 ══════════════════ -->
        <view class="v5-hero-body">
          <view class="v5-hero-toprow">
            <text class="v5-hero-badge">翻身判决</text>
            <text class="v5-hero-stage">{{viewModel.stageLabel}}</text>
          </view>
          <text class="v5-hero-title">{{viewModel.hero.title}}</text>
          <text class="v5-hero-sub">{{viewModel.hero.subtitle}}</text>
        </view>
      </view>

      <!-- ══════════════════ 03 赚钱人格 ══════════════════ -->
      <view class="v5-card v5-card-identity">
        <view class="v5-card-head">
          <text class="v5-card-num">01</text>
          <text class="v5-card-label">你的赚钱人格</text>
        </view>

        <view class="v5-id-arrows" wx:if="{{viewModel.identity.hasCurrent && viewModel.identity.hasTarget}}">
          <view class="v5-id-from">
            <text class="v5-id-tag-label">当前身份</text>
            <text class="v5-id-tag v5-id-tag-current">{{viewModel.identity.currentTitle}}</text>
            <text class="v5-id-tag-sub" wx:if="{{viewModel.identity.currentSubtitle}}">{{viewModel.identity.currentSubtitle}}</text>
          </view>
          <text class="v5-id-arrow">→</text>
          <view class="v5-id-to">
            <text class="v5-id-tag-label">目标身份</text>
            <text class="v5-id-tag v5-id-tag-target">{{viewModel.identity.targetTitle}}</text>
            <text class="v5-id-tag-sub" wx:if="{{viewModel.identity.targetSubtitle}}">{{viewModel.identity.targetSubtitle}}</text>
          </view>
        </view>

        <view class="v5-id-gap" wx:if="{{viewModel.identity.hasGap}}">
          <text class="v5-id-gap-text">{{viewModel.identity.gap}}</text>
        </view>

        <view class="v5-id-ladder" wx:if="{{viewModel.identity.hasPath}}">
          <text class="v5-id-ladder-title">升级路径</text>
          <view class="v5-id-rungs">
            <block wx:for="{{viewModel.identity.upgradePathSteps}}" wx:key="title" wx:for-item="step">
              <view class="v5-id-rung">
                <view class="v5-id-rung-dot"></view>
                <view class="v5-id-rung-texts">
                  <text class="v5-id-rung-title">{{step.title}}</text>
                  <text class="v5-id-rung-sub" wx:if="{{step.subtitle}}">{{step.subtitle}}</text>
                </view>
              </view>
              <view class="v5-id-rung-line" wx:if="{{index < viewModel.identity.upgradePathSteps.length - 1}}"></view>
            </block>
          </view>
        </view>
      </view>

      <!-- ══════════════════ 04 五维现实底盘 ══════════════════ -->
      <view class="v5-card">
        <view class="v5-card-head">
          <text class="v5-card-num">02</text>
          <text class="v5-card-label">五维现实底盘</text>
        </view>
        <view class="v5-bars">
          <block wx:for="{{viewModel.scoreDimensions}}" wx:key="key">
            <view class="v5-bar">
              <view class="v5-bar-top">
                <text class="v5-bar-name">{{item.label}}</text>
                <text class="v5-bar-grade grade-{{item.grade.level}}">{{item.grade.label}}</text>
                <text class="v5-bar-val">{{item.value}}</text>
              </view>
              <view class="v5-bar-track">
                <view class="v5-bar-fill grade-{{item.grade.level}}" style="width:{{item.value}}%"></view>
              </view>
              <text class="v5-bar-hint">{{item.explanation}}</text>
            </view>
          </block>
        </view>
      </view>

      <!-- ══════════════════ 05 当前困局 ══════════════════ -->
      <view class="v5-card" wx:if="{{viewModel.systemLeaks.length > 0}}">
        <view class="v5-card-head">
          <text class="v5-card-num">03</text>
          <text class="v5-card-label">当前困局</text>
        </view>
        <block wx:for="{{viewModel.systemLeaks}}" wx:key="ruleId" wx:for-item="leak">
          <view class="v5-leak" wx:if="{{index < 3}}">
            <view class="v5-leak-top">
              <text class="v5-leak-idx">{{index + 1}}</text>
              <text class="v5-leak-name">{{leak.title}}</text>
            </view>
            <text class="v5-leak-reason">{{leak.description}}</text>
          </view>
        </block>
      </view>

      <!-- ══════════════════ 06 唯一首选翻身路径 ══════════════════ -->
      <view class="v5-card v5-path-primary" wx:if="{{viewModel.hasPrimaryPath}}">
        <view class="v5-card-head v5-card-head-light">
          <text class="v5-card-num">04</text>
          <text class="v5-card-label">你的首选翻身路径</text>
        </view>

        <view class="v5-pp-hero">
          <text class="v5-pp-name">{{viewModel.primaryWealthPath.name}}</text>
          <view class="v5-pp-meta">
            <view class="v5-pp-badge level-{{viewModel.primaryWealthPath.statusLevel}}">
              <text>{{viewModel.primaryWealthPath.statusIcon}} {{viewModel.primaryWealthPath.statusLabel}}</text>
            </view>
            <text class="v5-pp-score">适配度 {{viewModel.primaryWealthPath.score}}</text>
          </view>
        </view>

        <view class="v5-pp-section" wx:if="{{viewModel.primaryWealthPath.reasons.length > 0}}">
          <text class="v5-pp-sec-label">为什么适合你</text>
          <view class="v5-pp-sec-item" wx:for="{{viewModel.primaryWealthPath.reasons}}" wx:key="*this">
            <text class="v5-pp-sec-icon v5-pp-check">✓</text>
            <text class="v5-pp-sec-text">{{item}}</text>
          </view>
        </view>

        <view class="v5-pp-section" wx:if="{{viewModel.primaryWealthPath.risks.length > 0}}">
          <text class="v5-pp-sec-label v5-pp-label-warn">当前最大缺口</text>
          <view class="v5-pp-sec-item" wx:for="{{viewModel.primaryWealthPath.risks}}" wx:key="*this">
            <text class="v5-pp-sec-icon v5-pp-warn">△</text>
            <text class="v5-pp-sec-text">{{item}}</text>
          </view>
        </view>

        <view class="v5-pp-first-step" wx:if="{{viewModel.primaryWealthPath.description}}">
          <text class="v5-pp-step-label">第一步</text>
          <text class="v5-pp-step-text">{{viewModel.primaryWealthPath.description}}</text>
        </view>
      </view>

      <!-- ══════════════════ 07 其他路径评估 ══════════════════ -->
      <view class="v5-card" wx:if="{{viewModel.otherWealthPaths.length > 0}}">
        <view class="v5-card-head">
          <text class="v5-card-num">05</text>
          <text class="v5-card-label">其他路径评估</text>
        </view>

        <block wx:for="{{viewModel.otherWealthPaths}}" wx:key="key">
          <view class="v5-op {{item.isBlocked ? 'v5-op-blocked' : (item.statusLevel === 'strong' || item.statusLevel === 'recommended' ? 'v5-op-recommended' : '')}}">
            <view class="v5-op-row">
              <text class="v5-op-name">{{item.name}}</text>
              <view class="v5-op-badge level-{{item.statusLevel}}">
                <text>{{item.shortStatusLabel}}</text>
              </view>
              <text class="v5-op-score">{{item.score}}</text>
            </view>
            <text class="v5-op-desc">{{item.description}}</text>
          </view>
        </block>
      </view>

      <!-- ══════════════════ 08 现在不要做什么 ══════════════════ -->
      <view class="v5-card" wx:if="{{viewModel.stopDoing.length > 0}}">
        <view class="v5-card-head">
          <text class="v5-card-num">06</text>
          <text class="v5-card-label">现在不要做什么</text>
        </view>
        <block wx:for="{{viewModel.stopDoing}}" wx:key="*this" wx:for-item="item">
          <view class="v5-stop" wx:if="{{index < 4}}">
            <text class="v5-stop-icon">⛔</text>
            <text class="v5-stop-text">{{item}}</text>
          </view>
        </block>
      </view>

      <!-- ══════════════════ 09 30天行动路线 ══════════════════ -->
      <view class="v5-card">
        <view class="v5-card-head">
          <text class="v5-card-num">07</text>
          <text class="v5-card-label">30天行动路线</text>
        </view>

        <view class="v5-timeline">
          <block wx:for="{{viewModel.actionTimeline}}" wx:key="day">
            <view class="v5-tl-node" wx:if="{{item.goal}}">
              <view class="v5-tl-marker">
                <view class="v5-tl-dot"></view>
              </view>
              <view class="v5-tl-body">
                <text class="v5-tl-day">{{item.day}}</text>
                <text class="v5-tl-goal">{{item.goal}}</text>
                <view class="v5-tl-tasks" wx:if="{{item.tasks.length > 0}}">
                  <text class="v5-tl-task" wx:for="{{item.tasks}}" wx:key="*this" wx:for-item="task">{{task}}</text>
                </view>
                <text class="v5-tl-check" wx:if="{{item.checkpoint}}">✓ {{item.checkpoint}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- ══════════════════ 10 情景改善 ══════════════════ -->
      <view class="v5-card">
        <view class="v5-card-head">
          <text class="v5-card-num">08</text>
          <text class="v5-card-label">情景改善指数</text>
        </view>
        <text class="v5-scene-note">基于当前回答与规则模型的情景推演，不构成收益承诺</text>
        <view class="v5-scene-grid">
          <view class="v5-scene-item">
            <text class="v5-scene-val">{{viewModel.probabilities.today}}</text>
            <text class="v5-scene-label">当前</text>
          </view>
          <view class="v5-scene-item">
            <text class="v5-scene-val">{{viewModel.probabilities.after30}}</text>
            <text class="v5-scene-label">30天</text>
          </view>
          <view class="v5-scene-item">
            <text class="v5-scene-val">{{viewModel.probabilities.after90}}</text>
            <text class="v5-scene-label">90天</text>
          </view>
          <view class="v5-scene-item">
            <text class="v5-scene-val">{{viewModel.probabilities.after365}}</text>
            <text class="v5-scene-label">365天</text>
          </view>
        </view>
      </view>

      <!-- ══════════════════ 11 最后一击 ══════════════════ -->
      <view class="v5-final" wx:if="{{viewModel.finalStrike.sentence}}">
        <text class="v5-final-label">最后一击</text>
        <text class="v5-final-sentence">{{viewModel.finalStrike.sentence}}</text>
        <text class="v5-final-motto">翻身从来不是拼命，而是看懂规则。</text>
      </view>

      <!-- rule_fallback 提示 -->
      <view class="v5-fallback" wx:if="{{renderSource === 'rule_fallback'}}">
        本报告当前使用规则引擎生成，核心判断不受影响。
      </view>

      <!-- ══════════════════ 12 底部操作 ══════════════════ -->
      <view class="v5-bottom">
        <button class="v5-btn-primary" bindtap="generatePoster" loading="{{posterGenerating}}">
          {{posterGenerating ? '正在生成...' : '生成翻身报告海报'}}
        </button>
        <button class="v5-btn-ghost" open-type="share">分享好友</button>
        <view class="v5-bottom-links">
          <text class="v5-bottom-link" bindtap="onRetry">重做诊断</text>
        </view>
        <text class="v5-disclaimer">系统提示：当前页面内容由自动化算法与人工智能推演生成</text>
      </view>

    </scroll-view>
  </block>

  <!-- ═══════════════════════════════════
       V3 Legacy (unchanged)
       ═══════════════════════════════════ -->
  <block wx:elif="{{reportVersion === 'v3' && sections.length > 0}}">
    <view class="report-blocks">
      <block wx:for="{{sections}}" wx:key="key">
        <view class="section-card {{item.key === 'fatal' ? 'red-card' : ''}}">
          <view class="section-header">
            <text class="section-badge {{item.key === 'fatal' ? 'bg-red' : ''}}">{{index + 1}}</text>
            <text class="section-title {{item.key === 'fatal' ? 'text-red' : ''}}">{{item.label}}</text>
          </view>
          <view class="section-body">
            <block wx:if="{{loading}}">
              <view class="loading-typing">
                <text class="typing-text">正在推演你的认知结构</text>
                <view class="typing-dots"><view class="td-dot"></view><view class="td-dot"></view><view class="td-dot"></view></view>
              </view>
            </block>
            <block wx:elif="{{!item.revealed}}">
              <view class="loading-typing">
                <text class="typing-text">推演中…</text>
                <view class="typing-dots"><view class="td-dot"></view><view class="td-dot"></view><view class="td-dot"></view></view>
              </view>
            </block>
            <text wx:else class="real-text {{item.key === 'fatal' ? 'fatal-text' : ''}} fade-in" user-select="true">
              {{item.key === 'fatal' ? '💀 ' : ''}}{{item.text}}
            </text>
          </view>
        </view>
      </block>
    </view>

    <view class="bottom-bar">
      <view class="compliance-tips">系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出！</view>
      <view class="action-buttons">
        <button class="btn-save-poster" bindtap="generatePoster" loading="{{posterGenerating}}">{{posterGenerating ? '淬炼中...' : '保存海报'}}</button>
        <button class="btn-share" open-type="share">分享好友</button>
      </view>
      <button class="btn-retry" bindtap="onRetry">重做诊断</button>
    </view>
  </block>

  <!-- ═══ Canvas 海报 ═══ -->
  <canvas canvas-id="posterCanvas" style="width:750px;height:2200px;position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;"></canvas>
</view>
