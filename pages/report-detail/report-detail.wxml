<!-- report-detail — Progressive Reveal Mode v3.17 -->
<view class="page">
  <xsg-navbar title="认知翻身报告" showBack light />

  <!-- ═══ 5模块标题 + 正文骨架 ═══ -->
  <view class="report-blocks">
    <block wx:for="{{sections}}" wx:key="key">
      <view class="section-card {{item.key === 'fatal' ? 'red-card' : ''}}">
        <view class="section-header">
          <text class="section-badge {{item.key === 'fatal' ? 'bg-red' : ''}}">{{index + 1}}</text>
          <text class="section-title {{item.key === 'fatal' ? 'text-red' : ''}}">{{item.label}}</text>
        </view>

        <!-- 正文区：loading 动画 or 已揭晓内容 -->
        <view class="section-body">
          <block wx:if="{{loading}}">
            <view class="loading-typing">
              <text class="typing-text">正在推演你的认知结构</text>
              <view class="typing-dots">
                <view class="td-dot"></view><view class="td-dot"></view><view class="td-dot"></view>
              </view>
            </view>
          </block>

          <block wx:elif="{{!item.revealed}}">
            <view class="loading-typing">
              <text class="typing-text">推演中…</text>
              <view class="typing-dots">
                <view class="td-dot"></view><view class="td-dot"></view><view class="td-dot"></view>
              </view>
            </view>
          </block>

          <text wx:else class="real-text {{item.key === 'fatal' ? 'fatal-text' : ''}} fade-in" user-select="true">
            {{item.key === 'fatal' ? '💀 ' : ''}}{{item.text}}
          </text>
        </view>
      </view>
    </block>
  </view>

  <!-- ═══ 底部 ═══ -->
  <view class="compliance-tips" wx:if="{{!loading}}">
    系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出！
  </view>

  <view class="action-row" wx:if="{{!loading}}">
    <button class="btn-retry" bindtap="onRetry">重做诊断</button>
  </view>
</view>
