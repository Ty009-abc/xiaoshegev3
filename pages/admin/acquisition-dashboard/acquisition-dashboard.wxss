/* pages/admin/acquisition-dashboard/acquisition-dashboard.wxss */

.dashboard-scroll {
  padding-bottom: 40rpx;
  background: #0a0a14;
  min-height: 100vh;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #12122a;
  padding: 12rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  gap: 0;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, #4a90e2, #a084dc);
  color: #fff;
  font-weight: bold;
}
.tab-content {
  padding: 20rpx 24rpx;
}

/* KPI Grid */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.kpi-card {
  flex: 1 1 calc(33% - 12rpx);
  min-width: 180rpx;
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255,255,255,0.04);
}
.kpi-card.accent-green { border-color: rgba(46, 204, 113, 0.3); }
.kpi-card.accent-gold { border-color: rgba(243, 156, 18, 0.3); }
.kpi-card.accent-red  { border-color: rgba(231, 76, 60, 0.3); }
.kpi-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}
.kpi-label {
  font-size: 20rpx;
  color: #888;
  margin-top: 6rpx;
}

/* Metric Rows */
.metric-row {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #ccc;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.metric-row:last-child { border-bottom: none; }

.metric-row-compare {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #bbb;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.metric-row-compare:last-child { border-bottom: none; }

/* Source */
.source-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.source-name { color: #aaa; font-size: 24rpx; }
.source-count { color: #fff; font-weight: bold; font-size: 24rpx; }

/* Quality */
.quality-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.quality-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 180rpx;
}
.quality-source { color: #fff; font-size: 24rpx; }
.quality-grade { font-weight: bold; font-size: 22rpx; }
.quality-score { color: #aaa; font-size: 22rpx; min-width: 60rpx; text-align: right; }

/* Insight */
.insight-text {
  padding: 20rpx;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4ecdc4;
  margin-bottom: 16rpx;
  line-height: 1.6;
}
.insight-text.highlight {
  background: rgba(243, 156, 18, 0.1);
  color: #f39c12;
  font-weight: bold;
}

/* Content ROI */
.content-roi-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.rank-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  color: #fff;
  background: #333;
}
.rank-1 { background: linear-gradient(135deg, #f39c12, #e74c3c); }
.rank-2 { background: linear-gradient(135deg, #95a5a6, #7f8c8d); }
.rank-3 { background: linear-gradient(135deg, #cd6133, #e67e22); }
.content-meta { display: flex; flex-direction: column; gap: 2rpx; }
.content-id { color: #fff; font-size: 24rpx; }
.content-source { color: #888; font-size: 20rpx; }
.content-count { color: #4ecdc4; font-weight: bold; font-size: 24rpx; margin-left: auto; }
.content-roi-meta {
  margin-left: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 22rpx;
  color: #aaa;
}

/* Health */
.health-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: #bbb;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}

/* Recommendations */
.rec-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.rec-action {
  font-weight: bold;
  font-size: 24rpx;
  min-width: 100rpx;
}
.rec-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.rec-source { color: #fff; font-size: 24rpx; }
.rec-reason { color: #888; font-size: 20rpx; }

/* Segments */
.seg-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 22rpx;
  color: #aaa;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.seg-key { color: #fff; }
