.page{min-height:100vh;background:#0a0a14;padding:24rpx;}
.tabs{display:flex;gap:12rpx;margin-bottom:20rpx;}
.tab{font-size:26rpx;color:#666;background:#141428;padding:12rpx 28rpx;border-radius:14rpx;}
.tab.active{background:#0a84ff;color:#fff;}
.add-btn{width:100%;height:72rpx;line-height:72rpx;background:#0a84ff;color:#fff;font-size:26rpx;border-radius:14rpx;border:none;margin-bottom:16rpx;}
.add-btn::after{border:none;}
.item-row{background:#141428;border-radius:12rpx;padding:20rpx 24rpx;margin-bottom:12rpx;}
.item-row.disabled{opacity:0.4;}
.i-header{display:flex;justify-content:space-between;margin-bottom:8rpx;}
.i-title{font-size:26rpx;color:#ddd;}
.i-status{font-size:20rpx;padding:2rpx 10rpx;border-radius:8rpx;color:#888;background:#13152a;}
.i-status.active{color:#2ecc71;background:rgba(46,204,113,0.1);}
.i-actions{display:flex;gap:24rpx;}
.i-act{font-size:22rpx;color:#0a84ff;}
.modal{position:fixed;top:0;left:0;right:0;bottom:0;z-index:999;}
.modal-mask{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);}
.modal-body{position:absolute;bottom:0;left:0;right:0;background:#141428;border-radius:24rpx 24rpx 0 0;padding:32rpx;}
.form-title{font-size:30rpx;color:#fff;margin-bottom:24rpx;}
.f-input{height:72rpx;background:#1a1a2e;border-radius:12rpx;padding:0 20rpx;font-size:26rpx;color:#ccc;margin-bottom:16rpx;}
.f-textarea{min-height:160rpx;background:#1a1a2e;border-radius:12rpx;padding:16rpx 20rpx;font-size:26rpx;color:#ccc;margin-bottom:24rpx;width:calc(100% - 40rpx);}
.f-btn{width:100%;height:80rpx;line-height:80rpx;background:#0a84ff;color:#fff;border-radius:14rpx;font-size:28rpx;border:none;margin-bottom:12rpx;}
.f-btn::after{border:none;}
.f-btn.cancel{background:#1a1a2e;color:#888;}
.empty{text-align:center;color:var(--text-tertiary);padding:64rpx;font-size:28rpx;}
