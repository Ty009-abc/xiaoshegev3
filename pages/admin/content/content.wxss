@import '../../../styles/admin.wxss';

.adm-row.disabled { opacity: 0.5; }
.i-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.i-actions { display: flex; gap: 32rpx; }
.i-act { font-size: 24rpx; color: #E5484D; }

/* 弹窗 */
.adm-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; }
.adm-modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(16, 24, 40, 0.45); }
.adm-modal-body {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #FFFFFF; border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.adm-modal-title { font-size: 30rpx; font-weight: 600; color: #111827; margin-bottom: 24rpx; }
.f-input { width: 100%; margin-bottom: 16rpx; box-sizing: border-box; }
.f-textarea {
  width: 100%; min-height: 200rpx; background: #FFFFFF;
  border: 1rpx solid rgba(0,0,0,0.08); border-radius: 12rpx;
  padding: 16rpx 20rpx; font-size: 26rpx; color: #111827;
  margin-bottom: 24rpx; box-sizing: border-box;
}
