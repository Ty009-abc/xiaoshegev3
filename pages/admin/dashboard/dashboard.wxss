.page{min-height:100vh;background:#0a0a14;padding:24rpx;}
.header{font-size:36rpx;font-weight:700;color:#fff;padding:32rpx 0 24rpx;}
.stat-grid{display:flex;gap:16rpx;margin-bottom:16rpx;}
.stat-card{flex:1;background:#141428;border-radius:16rpx;padding:28rpx 16rpx;text-align:center;}
.stat-card.wide{flex:2;}
.stat-val{display:block;font-size:36rpx;font-weight:700;color:#0a84ff;margin-bottom:8rpx;}
.stat-label{display:block;font-size:22rpx;color:#666;}
.stat-row{display:flex;gap:16rpx;}
.loading{text-align:center;color:#666;padding:64rpx;font-size:28rpx;}
