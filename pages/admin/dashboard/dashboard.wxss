@import '../../../styles/admin.wxss';

/* ── 用户趋势柱状（占位，RC8.9B 填充数据） ── */
.adm-trend { display: flex; align-items: flex-end; gap: 8rpx; height: 200rpx; padding: 24rpx; background: #FFFFFF; border: 1rpx solid rgba(0,0,0,0.06); border-radius: 16rpx; }
.adm-trend-bar { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; }
.adm-trend-fill { width: 100%; min-height: 4rpx; background: #E5484D; border-radius: 6rpx 6rpx 0 0; }
.adm-trend-label { font-size: 18rpx; color: #98A2B3; margin-top: 8rpx; }

/* RC8.9C R1B — 失败构成脚注 */
.adm-section-foot { margin-top: 12rpx; padding: 0 4rpx; }

/* RC8.9D_R1 — 漏斗完整性警告（数据口径异常时不伪造修正） */
.adm-funnel-warn { margin: 0 0 16rpx; padding: 14rpx 18rpx; background: #FFF4E5; border: 1rpx solid #F5C27A; border-radius: 12rpx; font-size: 22rpx; color: #8A5A00; }
/* RC8.9D_R1 — 付款阶段中性说明（当前 6Q 路径无付款入口） */
.adm-funnel-note { margin-top: 10rpx; font-size: 20rpx; color: #98A2B3; }
