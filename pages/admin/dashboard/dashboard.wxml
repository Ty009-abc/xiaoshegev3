<!-- pages/admin/dashboard — RC8.9 运营后台 · 数据总览 -->
<scroll-view scroll-y class="adm-page">
  <view class="adm-hero">
    <text class="adm-hero-title">Admin Console</text>
    <text class="adm-hero-sub">数据总览 · 只读观察层</text>
  </view>

  <!-- 加载骨架 -->
  <view class="adm-skeleton" wx:if="{{loading && !stats}}">
    <view class="adm-skel-block" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view>
  </view>

  <!-- 错误态 -->
  <view class="adm-error" wx:if="{{error && !loading}}">
    <text>{{error}}</text>
    <view class="adm-error-retry" bindtap="retry">重新加载</view>
  </view>

  <block wx:if="{{stats}}">
    <!-- 今日概览 -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">今日概览</text>
        <text class="adm-section-meta">实时</text>
      </view>
      <view class="adm-kpi-grid">
        <view class="adm-kpi" data-page="users" bindtap="navTo">
          <text class="adm-kpi-val">{{stats.todayNewUsers}}</text>
          <text class="adm-kpi-label">今日新增用户</text>
        </view>
        <view class="adm-kpi adm-kpi--info">
          <text class="adm-kpi-val">{{stats.totalUsers}}</text>
          <text class="adm-kpi-label">用户总数</text>
        </view>
        <view class="adm-kpi adm-kpi--accent">
          <text class="adm-kpi-val">{{stats.todayAiCalls}}</text>
          <text class="adm-kpi-label">今日AI调用</text>
        </view>
        <view class="adm-kpi adm-kpi--ok" data-page="orders" bindtap="navTo">
          <text class="adm-kpi-val">{{stats.paidOrders}}</text>
          <text class="adm-kpi-label">付费订单</text>
        </view>
        <view class="adm-kpi adm-kpi--accent">
          <text class="adm-kpi-val">¥{{stats.todayRevenueYuan}}</text>
          <text class="adm-kpi-label">今日收入</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.paidRate}}</text>
          <text class="adm-kpi-label">付费率</text>
        </view>
      </view>
    </view>

    <!-- 用户趋势（RC8.9B 接入） -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">用户趋势</text>
        <text class="adm-section-meta">DAU / 新增 / 报告</text>
      </view>
      <view class="adm-trend" wx:if="{{stats.trend}}">
        <view class="adm-trend-bar" wx:for="{{stats.trend}}" wx:key="date">
          <view class="adm-trend-fill" style="height:{{item.h}}%"></view>
          <text class="adm-trend-label">{{item.date}}</text>
        </view>
      </view>
      <view class="adm-empty" wx:else>暂无数据</view>
    </view>

    <!-- 核心漏斗（RC8.9B 接入） -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">核心漏斗</text>
        <text class="adm-section-meta">今日</text>
      </view>
      <view class="adm-card" style="padding:24rpx;" wx:if="{{stats.funnel}}">
        <view class="adm-funnel-step" wx:for="{{stats.funnel}}" wx:key="key">
          <view class="adm-funnel-top">
            <text class="adm-funnel-name">{{item.name}}</text>
            <text class="adm-funnel-count">{{item.count}} · {{item.rate}}</text>
          </view>
          <view class="adm-funnel-bar-bg">
            <view class="adm-funnel-bar" style="width:{{item.w}}%"></view>
          </view>
          <text class="adm-funnel-drop" wx:if="{{item.drop}}">流失 {{item.drop}}</text>
        </view>
      </view>
      <view class="adm-empty" wx:else>暂无数据</view>
    </view>

    <!-- AI 运行状态 -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">AI 运行状态</text>
        <text class="adm-section-meta">累计 · {{stats.businessTimezone}}</text>
      </view>
      <view class="adm-kpi-grid">
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.cumulativeAiCalls}}</text>
          <text class="adm-kpi-label">累计AI调用</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.costText}}</text>
          <text class="adm-kpi-label">估算成本{{stats.costNote ? ' (' + stats.costNote + ')' : ''}}</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.errorRateText}}</text>
          <text class="adm-kpi-label">AI错误率</text>
        </view>
        <view class="adm-kpi adm-kpi--warn">
          <text class="adm-kpi-val">{{stats.failuresText}}</text>
          <text class="adm-kpi-label">失败次数</text>
        </view>
        <view class="adm-kpi adm-kpi--warn">
          <text class="adm-kpi-val">{{stats.aiFallbacks}}</text>
          <text class="adm-kpi-label">规则兜底 ({{stats.fallbackRate}})</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.avgLatencyText}}</text>
          <text class="adm-kpi-label">平均延迟</text>
        </view>
      </view>
      <view class="adm-section-foot" wx:if="{{stats.failuresText > 0}}">
        <text class="adm-section-meta">失败构成：供应商 {{stats.breakdown.providerErrors || 0}} · 超时 {{stats.breakdown.timeouts || 0}} · 无效响应 {{stats.breakdown.invalidResponses || 0}} · 校验 {{stats.breakdown.validationErrors || 0}}</text>
      </view>
    </view>

    <!-- 商业（只读） -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">商业</text>
        <text class="adm-section-meta">只读</text>
      </view>
      <view class="adm-kpi-grid">
        <view class="adm-kpi adm-kpi--accent">
          <text class="adm-kpi-val">¥{{stats.totalRevenueYuan}}</text>
          <text class="adm-kpi-label">总收入</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.vipUsers}}</text>
          <text class="adm-kpi-label">会员数</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.paidOrders}}/{{stats.totalOrders}}</text>
          <text class="adm-kpi-label">付费/总订单</text>
        </view>
        <view class="adm-kpi">
          <text class="adm-kpi-val">{{stats.paidRate}}</text>
          <text class="adm-kpi-label">转化率</text>
        </view>
      </view>
    </view>

    <!-- 最近用户（RC8.9B 接入） -->
    <view class="adm-section">
      <view class="adm-section-head">
        <text class="adm-section-title">最近用户</text>
        <text class="adm-section-meta">最新活跃</text>
      </view>
      <block wx:if="{{stats.recentUsers}}">
        <view class="adm-row" wx:for="{{stats.recentUsers}}" wx:key="userId" data-openid="{{item.openid}}" bindtap="navToUser">
          <view style="display:flex;justify-content:space-between;">
            <text class="adm-row-title">{{item.label}}</text>
            <text class="adm-row-meta">{{item.timeText}}</text>
          </view>
          <text class="adm-row-sub">{{item.action}}</text>
        </view>
      </block>
      <view class="adm-empty" wx:else>暂无数据</view>
    </view>
  </block>

  <view class="adm-loading" wx:if="{{loading && stats}}">刷新中…</view>
</scroll-view>
