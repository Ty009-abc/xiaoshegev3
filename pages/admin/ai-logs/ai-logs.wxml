<!-- pages/admin/ai-logs — RC8.9 浅色 -->
<scroll-view scroll-y class="adm-page" bindscrolltolower="loadMore">
  <view class="adm-hero">
    <text class="adm-hero-title">AI 调用</text>
    <text class="adm-hero-sub">运行状态与最近记录</text>
  </view>

  <view class="adm-section" wx:if="{{stats}}">
    <view class="adm-kpi-grid">
      <view class="adm-kpi"><text class="adm-kpi-val">{{stats.totalCalls}}</text><text class="adm-kpi-label">总调用</text></view>
      <view class="adm-kpi adm-kpi--info"><text class="adm-kpi-val">{{stats.totalTokens}}</text><text class="adm-kpi-label">Token</text></view>
      <view class="adm-kpi adm-kpi--accent"><text class="adm-kpi-val">¥{{stats.totalCost}}</text><text class="adm-kpi-label">估算成本</text></view>
      <view class="adm-kpi adm-kpi--warn"><text class="adm-kpi-val">{{stats.errorRate}}</text><text class="adm-kpi-label">错误率</text></view>
    </view>
  </view>

  <view class="adm-section-head" style="padding-top:24rpx;">
    <text class="adm-section-title">最近调用</text>
    <text class="adm-section-meta">共 {{total}} 条</text>
  </view>

  <block wx:if="{{loading && list.length===0}}">
    <view class="adm-skeleton"><view class="adm-skel-block" wx:for="{{[1,2,3,4]}}" wx:key="*this"></view></view>
  </block>

  <view class="adm-row" wx:for="{{list}}" wx:key="_id">
    <view class="l-top">
      <text class="adm-row-title">{{item.action}}</text>
      <text class="adm-row-sub">{{item.tokens}} tokens</text>
    </view>
    <view class="l-bot">
      <text class="adm-row-meta">{{item.createdAt}}</text>
      <text class="adm-badge adm-badge--{{item.success ? 'success' : 'error'}}">{{item.success ? '成功' : '失败'}}</text>
    </view>
  </view>

  <view class="adm-empty" wx:if="{{!loading && list.length===0}}">暂无记录</view>
  <view class="adm-loading" wx:if="{{loading && list.length>0}}">加载中…</view>
</scroll-view>
