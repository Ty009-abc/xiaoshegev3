/* pages/admin/scale-dashboard/scale-dashboard.wxss */

.dashboard-scroll {
  padding-bottom: 40rpx;
  background: #0a0a14;
  min-height: 100vh;
}

/* Tab */
.tab-bar {
  display: flex;
  background: #12122a;
  padding: 12rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.tab-item.active {
  background: linear-gradient(135deg, #f39c12, #e74c3c);
  color: #fff;
  font-weight: bold;
}
.tab-content {
  padding: 20rpx 24rpx;
}

/* Phase */
.phase-badge {
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 16rpx;
}
.progress-label {
  text-align: center;
  font-size: 20rpx;
  color: #888;
  margin-top: 8rpx;
}

/* Timeline */
.timeline-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  position: relative;
}
.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f39c12;
  margin-top: 8rpx;
  flex-shrink: 0;
}
.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.timeline-phase { color: #fff; font-size: 26rpx; font-weight: bold; }
.timeline-duration { color: #f39c12; font-size: 20rpx; }
.timeline-method { color: #aaa; font-size: 20rpx; }

/* Layers */
.layer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
.pipeline-title {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #4ecdc4;
}
.pipeline-step {
  padding: 6rpx 0;
  color: #aaa;
  font-size: 22rpx;
}

/* KPI */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.kpi-card {
  flex: 1 1 calc(33% - 12rpx);
  min-width: 180rpx;
  background: #1a1a2e;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255,255,255,0.04);
}
.kpi-card.accent-green { border-color: rgba(46, 204, 113, 0.3); }
.kpi-card.accent-gold { border-color: rgba(243, 156, 18, 0.3); }
.kpi-card.accent-red  { border-color: rgba(231, 76, 60, 0.3); }
.kpi-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}
.kpi-label {
  font-size: 20rpx;
  color: #888;
  margin-top: 6rpx;
}

.metric-row {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #ccc;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.metric-row:last-child { border-bottom: none; }

.insight-text {
  padding: 20rpx;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4ecdc4;
  margin: 16rpx 0;
  line-height: 1.6;
}
.insight-text.highlight {
  background: rgba(243, 156, 18, 0.1);
  color: #f39c12;
  font-weight: bold;
}

/* Benchmarks */
.bench-row {
  padding: 10rpx 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #bbb;
}

/* Scenarios */
.scenario-card {
  background: #12122a;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.scenario-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.scenario-label { color: #fff; font-size: 26rpx; font-weight: bold; }
.scenario-dau { color: #f39c12; font-size: 28rpx; font-weight: bold; }
.scenario-stats {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #888;
}

.milestone-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #ccc;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}

/* Bottleneck */
.bottleneck-alert {
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-align: center;
}
.bottleneck-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.03);
}
.bn-left { display: flex; align-items: center; gap: 8rpx; }
.bn-type { color: #fff; font-size: 24rpx; }
.bn-right { display: flex; gap: 16rpx; }
.bn-score { color: #f39c12; font-size: 22rpx; }
.bn-weight { color: #888; font-size: 20rpx; }

/* Recommendations */
.rec-card {
  background: #12122a;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.rec-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.rec-priority {
  background: #f39c12;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}
.rec-action-text { color: #fff; font-size: 26rpx; flex: 1; }
.rec-detail { color: #888; font-size: 22rpx; line-height: 1.5; }

.budget-row {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #ccc;
}
.budget-tier { font-size: 20rpx; }

.rule-row {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #ccc;
}
