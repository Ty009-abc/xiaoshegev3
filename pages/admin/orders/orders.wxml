<!-- pages/admin/orders — RC8.9 浅色 -->
<scroll-view scroll-y class="adm-page" bindscrolltolower="loadMore">
  <view class="adm-hero">
    <text class="adm-hero-title">订单管理</text>
    <text class="adm-hero-sub">共 {{total}} 条 · 只读</text>
  </view>

  <view class="adm-tags">
    <view class="adm-tag {{status===''?'adm-tag--active':''}}" data-s="" bindtap="onFilterStatus">全部</view>
    <view class="adm-tag {{status==='paid'?'adm-tag--active':''}}" data-s="paid" bindtap="onFilterStatus">已支付</view>
    <view class="adm-tag {{status==='pending_payment'?'adm-tag--active':''}}" data-s="pending_payment" bindtap="onFilterStatus">待支付</view>
    <view class="adm-tag {{status==='created'?'adm-tag--active':''}}" data-s="created" bindtap="onFilterStatus">已创建</view>
  </view>

  <block wx:if="{{loading && list.length===0}}">
    <view class="adm-skeleton">
      <view class="adm-skel-block" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </view>
  </block>

  <view class="adm-row" wx:for="{{list}}" wx:key="orderId">
    <view class="o-top">
      <text class="adm-row-title">{{item.productName}}</text>
      <text class="o-price">¥{{item.totalAmount / 100}}</text>
    </view>
    <view class="o-mid">
      <text class="adm-row-meta adm-mono">{{item.orderId}}</text>
      <text class="adm-badge adm-badge--{{item.status}}">{{item.status}}</text>
    </view>
    <view class="o-bot">
      <text class="adm-row-meta">{{item.createdAt}}</text>
      <text class="adm-row-meta adm-mono">{{item.maskedOpenid}}</text>
    </view>
  </view>

  <view class="adm-empty" wx:if="{{!loading && list.length===0}}">暂无订单</view>
  <view class="adm-loading" wx:if="{{loading && list.length>0}}">加载中…</view>
</scroll-view>
