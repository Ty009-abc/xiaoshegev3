<!-- pages/admin/settings -->
<scroll-view scroll-y class="page">
  <view class="header">⚙️ 系统配置</view>
  <view class="config-list" wx:if="{{!loading}}">
    <block wx:for="{{configs}}" wx:key="key">
      <view class="cfg-row" wx:if="{{item.type === 'bool'}}">
        <text class="cfg-label">{{item.label}}</text>
        <switch checked="{{config[item.key]}}" data-key="{{item.key}}" bindchange="onToggle" color="#0a84ff" />
      </view>
      <view class="cfg-row" wx:elif="{{item.type === 'number'}}">
        <text class="cfg-label">{{item.label}}</text>
        <input class="cfg-input" type="number" value="{{config[item.key]}}" data-key="{{item.key}}" bindblur="onSaveNumber" />
      </view>
      <view class="cfg-row" wx:elif="{{item.type === 'text'}}">
        <text class="cfg-label">{{item.label}}</text>
        <input class="cfg-input" value="{{config[item.key]}}" data-key="{{item.key}}" bindblur="onSaveText" />
      </view>
    </block>
  </view>
  <view class="refresh" bindtap="fetchConfig">刷新配置</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</scroll-view>
