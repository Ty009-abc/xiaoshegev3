/* challenge.wxss */
.c-page { min-height:100vh; background:#F4F5F7; padding:24rpx 32rpx 48rpx; box-sizing:border-box; }
.c-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:28rpx; }
.c-h-left { flex:1; display:flex; flex-direction:column; gap:10rpx; }
.c-h-day { font-size:26rpx; font-weight:700; color:#344054; }
.c-h-progress { height:8rpx; border-radius:999rpx; background:#E5E7EB; overflow:hidden; max-width:260rpx; }
.c-h-bar { height:100%; border-radius:999rpx; background:linear-gradient(90deg,#7F56D9,#53389E); transition:width .4s; }
.c-h-right { display:flex; align-items:center; gap:12rpx; }
.c-h-cv { font-size:24rpx; font-weight:800; color:#7F56D9; background:#F5F3FF; padding:6rpx 16rpx; border-radius:999rpx; }
.c-h-lv { font-size:22rpx; color:#667085; font-weight:600; }

.c-card { background:#FFFFFF; border-radius:28rpx; padding:32rpx; margin-bottom:20rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,.04); }
.c-cc-day { font-size:22rpx; color:#7F56D9; font-weight:700; margin-bottom:12rpx; background:#F5F3FF; display:inline-block; padding:4rpx 16rpx; border-radius:999rpx; }
.c-cc-title { font-size:36rpx; font-weight:800; color:#101828; line-height:1.4; display:block; margin-bottom:16rpx; }
.c-cc-desc { font-size:28rpx; color:#475467; line-height:1.75; display:block; }

.c-opts { display:flex; flex-direction:column; gap:16rpx; margin-bottom:24rpx; }
.c-opt { padding:28rpx 24rpx; background:#FFFFFF; border-radius:20rpx; border:2rpx solid #E5E7EB; transition:all .2s; }
.c-opt-hv { background:#F9FAFB; border-color:#D0D5DD; }
.c-opt-sel { border-color:#7F56D9; background:#F5F3FF; box-shadow:0 0 0 2rpx rgba(127,86,217,.15); }
.c-opt-text { font-size:30rpx; color:#344054; line-height:1.6; font-weight:500; display:block; }

.c-confirm { width:100%; height:96rpx; line-height:96rpx; border-radius:999rpx; font-size:32rpx; font-weight:700; color:#FFF; background:linear-gradient(135deg,#7F56D9,#53389E); border:none; padding:0; box-shadow:0 6rpx 20rpx rgba(127,86,217,.35); }
.c-confirm::after { border:none; }
.c-confirm[disabled] { background:#D0D5DD; color:#98A2B3; box-shadow:none; }

/* 结算 */
.c-fin { display:flex; flex-direction:column; align-items:center; padding-top:40rpx; gap:16rpx; }
.c-fin-emoji { font-size:80rpx; margin-bottom:8rpx; }
.c-fin-t { font-size:40rpx; font-weight:800; color:#101828; }
.c-fin-s { font-size:26rpx; color:#667085; margin-bottom:16rpx; }
.c-fin-grid { width:100%; background:#FFF; border-radius:28rpx; padding:28rpx; display:flex; flex-direction:column; gap:18rpx; margin-bottom:24rpx; }
.c-fin-i { display:flex; align-items:center; gap:12rpx; }
.c-fin-l { width:60rpx; font-size:22rpx; color:#344054; font-weight:600; text-align:right; flex-shrink:0; }
.c-fin-b { flex:1; height:12rpx; border-radius:999rpx; background:#F2F4F7; overflow:hidden; }
.c-fin-f { height:100%; border-radius:999rpx; transition:width .8s; }
.c-fin-v { width:48rpx; font-size:24rpx; font-weight:700; text-align:left; flex-shrink:0; }
.c-fin-f.hi { background:linear-gradient(90deg,#10B981,#059669); }
.c-fin-f.mi { background:linear-gradient(90deg,#F59E0B,#D97706); }
.c-fin-f.lo { background:linear-gradient(90deg,#FF5A5F,#DC3545); }
.hi { color:#059669; }
.mi { color:#D97706; }
.lo { color:#DC3545; }

.c-btn-2 { width:100%; height:80rpx; line-height:80rpx; border-radius:999rpx; font-size:28rpx; font-weight:700; background:#F2F4F7; color:#344054; border:none; padding:0; margin-top:12rpx; }
.c-btn-2::after { border:none; }
.c-btn-3 { background:transparent; color:#667085; font-size:26rpx; border:none; padding:0; margin-top:8rpx; }
.c-btn-3::after { border:none; }

/* 动画 */
.c-slide-in { animation:si .35s ease-out both; }
.c-slide-out { animation:so .35s ease-in both; }
@keyframes si { from{opacity:0;transform:translateX(60rpx);} to{opacity:1;transform:translateX(0);} }
@keyframes so { from{opacity:1;transform:translateX(0);} to{opacity:0;transform:translateX(-60rpx);} }
