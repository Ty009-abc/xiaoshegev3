<!-- pages/membership-center/membership-center.wxml — RC8_13_P0 真机重建 -->
<view class="mc-page">
  <xsg-navbar title="会员中心" showBack="{{true}}" bind:back="onBack" />

  <view class="mc-body">

    <!-- ═══ 认知会员（身份卡）═══ -->
    <view class="section-label">认知会员</view>
    <view class="id-card">
      <view class="id-row">
        <text class="id-badge">{{memberBadge || '⭐'}}</text>
        <view class="id-main">
          <text class="id-title">认知会员{{memberTypeText ? ' · ' + memberTypeText : ''}}</text>
          <text class="id-sub" wx:if="{{active}}">生效中</text>
          <text class="id-sub" wx:elif="{{memberState === 'expired'}}">已到期</text>
          <text class="id-sub" wx:elif="{{memberState === 'free'}}">未开通</text>
          <text class="id-sub" wx:else>状态同步中</text>
        </view>
        <text class="id-chip {{active ? 'on' : (memberState === 'expired' ? 'expired' : '')}}">{{active ? '生效中' : (memberState === 'expired' ? '已到期' : (memberState === 'unknown' ? '同步中' : '未开通'))}}</text>
      </view>

      <view class="id-expiry" wx:if="{{hasExpiry}}">
        <text class="id-expiry-label">有效期至</text>
        <text class="id-expiry-val">{{memberExpiryFull}}</text>
      </view>
      <view class="id-expiry-idle" wx:elif="{{memberState === 'unknown'}}">
        <text class="id-idle-text">正在同步会员状态…</text>
        <text class="id-link" bindtap="retryMember">重新加载</text>
      </view>
      <view class="id-expiry-idle" wx:elif="{{memberState === 'free'}}">
        <text class="id-idle-text">开通会员，解锁完整认知系统</text>
        <text class="id-link" bindtap="goMembership">查看方案</text>
      </view>
    </view>

    <!-- ═══ 认知成长（独立于会员）═══ -->
    <view class="section-label">认知成长</view>
    <view class="growth-card">
      <view class="growth-top">
        <view class="growth-main">
          <text class="growth-level">LV{{level}} · {{cvLevelTitle}}</text>
          <text class="growth-hint">{{cvNextText}}</text>
        </view>
        <view class="growth-xp">
          <text class="growth-xp-val">{{xpText}}</text>
          <text class="growth-xp-label">CV</text>
        </view>
      </view>
      <view class="growth-bar" wx:if="{{hasCv}}">
        <view class="growth-bar-fill" style="width: {{cvPercent}}%"></view>
      </view>
    </view>

    <!-- ═══ 每日签到（仅权威提供时展示）═══ -->
    <view class="checkin-card" wx:if="{{checkinEnabled && !checkedIn}}" bindtap="doCheckIn">
      <view class="checkin-left">
        <text class="checkin-streak">🔥 连续 {{streak}} 天</text>
        <text class="checkin-sub">点击签到，累计成长</text>
      </view>
      <view class="checkin-btn">签到</view>
    </view>
    <view class="checkin-card checked" wx:if="{{checkinEnabled && checkedIn}}">
      <text class="checkin-done">✅ 今日已签到 · 连续 {{streak}} 天</text>
    </view>

    <!-- ═══ 本周成长报告 ═══ -->
    <view class="section-label">本周成长报告</view>
    <view class="report-card" wx:if="{{weeklyReport}}" bindtap="goReport">
      <view class="report-head">
        <text class="report-title">{{weeklyReport.title || '本周成长报告'}}</text>
        <text class="report-date" wx:if="{{weeklyReport.date || weeklyReport.generatedAt}}">{{weeklyReport.date || weeklyReport.generatedAt}}</text>
      </view>
      <view class="report-body">
        <view class="report-row">
          <text class="report-key">认知值变化</text>
          <text class="report-val">{{weeklyReport.cognitionChange.trend === 'up' ? '↑' : weeklyReport.cognitionChange.trend === 'down' ? '↓' : '→'}} {{weeklyReport.cognitionChange.xpChange >= 0 ? '+' : ''}}{{weeklyReport.cognitionChange.xpChange}}</text>
        </view>
        <view class="report-row">
          <text class="report-key">活动次数</text>
          <text class="report-val">{{weeklyReport.activitySummary.totalActions}} 次</text>
        </view>
        <view class="report-row">
          <text class="report-key">成长趋势</text>
          <text class="report-val">{{weeklyReport.growthTrend.direction === 'accelerating' ? '加速中 🚀' : weeklyReport.growthTrend.direction === 'consistent' ? '稳定 ✅' : '放缓'}}</text>
        </view>
      </view>
      <view class="report-cta" bindtap="goReport">查看完整报告 ›</view>
    </view>
    <view class="report-empty" wx:elif="{{weeklyLoading}}">
      <text class="report-empty-title">正在加载周报…</text>
    </view>
    <view class="report-empty" wx:else>
      <text class="report-empty-title">暂未生成周报</text>
      <text class="report-empty-sub">使用满 7 天后查看阶段总结</text>
    </view>

    <!-- ═══ 我的会员权益 ═══ -->
    <view class="section-label">我的会员权益</view>
    <view class="rights-card">
      <block wx:if="{{rights.length}}">
        <view class="right-item" wx:for="{{rights}}" wx:key="raw">
          <text class="right-dot">✓</text>
          <text class="right-name">{{item.label}}</text>
        </view>
      </block>
      <view class="right-empty" wx:elif="{{active}}">
        <text>权益同步中，请稍后重试</text>
      </view>
      <view class="right-empty" wx:else>
        <text>开通会员解锁完整权益</text>
      </view>
    </view>

    <view class="mc-bottom-space"></view>
  </view>

  <!-- ═══ 底部 CTA（按会员态分流；已付费绝不出现升级/复购）═══ -->
  <view class="cta-bar">
    <block wx:if="{{active}}">
      <view class="cta-text">认知会员生效中</view>
      <view class="cta-btn ghost" bindtap="onViewRights">查看会员权益</view>
    </block>
    <block wx:elif="{{memberState === 'expired'}}">
      <view class="cta-text warn">会员已到期</view>
      <view class="cta-btn" bindtap="goMembership">查看续费选项</view>
    </block>
    <block wx:elif="{{memberState === 'unknown'}}">
      <view class="cta-text">正在同步会员状态</view>
      <view class="cta-btn ghost" bindtap="retryMember">重新加载</view>
    </block>
    <block wx:else>
      <view class="cta-text">解锁完整认知系统</view>
      <view class="cta-btn" bindtap="goMembership">升级会员</view>
    </block>
  </view>
</view>
