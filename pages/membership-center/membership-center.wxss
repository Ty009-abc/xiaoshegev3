/* pages/membership-center/membership-center.wxss — RC8_13_P0 真机重建 */
@import '../../styles/tokens.wxss';

page {
  background: #F5F6FA;
}

.mc-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F6FA;
}

.mc-body {
  flex: 1;
  padding: 16rpx 32rpx 0;
}

/* ── 分组标题 ── */
.section-label {
  display: block;
  margin: 32rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #667085;
  letter-spacing: 0.5rpx;
}

/* ── 身份卡（认知会员）—— 浅底深字，杜绝白上白 ── */
.id-card {
  background: #151C30;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(21,28,48,0.18);
}
.id-row {
  display: flex;
  align-items: center;
}
.id-badge {
  font-size: 52rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.id-main {
  flex: 1;
  min-width: 0;
}
.id-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.4;
}
.id-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #AEB6C9;
}
.id-chip {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #C7CBE0;
  background: rgba(255,255,255,0.10);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}
.id-chip.on { color: #FFFFFF; background: #8056DF; }
.id-chip.expired { color: #FDE7C8; background: rgba(245,158,11,0.28); }

.id-expiry {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
  flex-wrap: wrap;
}
.id-expiry-label {
  font-size: 24rpx;
  color: #AEB6C9;
  margin-right: 14rpx;
}
.id-expiry-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #C6B1FF;
}
.id-expiry-idle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}
.id-idle-text { font-size: 24rpx; color: #AEB6C9; flex: 1; min-width: 0; }
.id-link { font-size: 24rpx; font-weight: 600; color: #C6B1FF; margin-left: 16rpx; flex-shrink: 0; }

/* ── 成长卡 ── */
.growth-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E9F0;
  border-radius: 24rpx;
  padding: 32rpx;
}
.growth-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.growth-main { flex: 1; min-width: 0; }
.growth-level {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #192234;
}
.growth-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #667085;
  line-height: 1.5;
}
.growth-xp {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
}
.growth-xp-val { font-size: 40rpx; font-weight: 800; color: #8056DF; }
.growth-xp-label { font-size: 20rpx; color: #98A2B3; }
.growth-bar {
  margin-top: 24rpx;
  height: 12rpx;
  background: #EEF0F6;
  border-radius: 6rpx;
  overflow: hidden;
}
.growth-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #8056DF;
  transition: width 0.5s ease;
}

/* ── 签到卡 ── */
.checkin-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7E9F0;
  border-radius: 24rpx;
}
.checkin-card.checked { justify-content: center; }
.checkin-left { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.checkin-streak { font-size: 30rpx; font-weight: 700; color: #192234; }
.checkin-sub { margin-top: 6rpx; font-size: 22rpx; color: #667085; }
.checkin-btn {
  flex-shrink: 0;
  min-width: 148rpx;
  padding: 18rpx 0;
  margin-left: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #22C55E;
  border-radius: 16rpx;
  white-space: nowrap;
}
.checkin-done { font-size: 28rpx; color: #22C55E; }

/* ── 周报卡 ── */
.report-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E9F0;
  border-radius: 24rpx;
  padding: 32rpx;
}
.report-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.report-title { font-size: 30rpx; font-weight: 700; color: #192234; }
.report-date { font-size: 22rpx; color: #98A2B3; }
.report-body { margin-top: 8rpx; }
.report-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}
.report-row:not(:last-child) { border-bottom: 1rpx solid #F0F1F5; }
.report-key { font-size: 26rpx; color: #667085; }
.report-val { font-size: 26rpx; font-weight: 600; color: #192234; }
.report-cta {
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F1F5;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #8056DF;
}
.report-empty {
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border: 1rpx dashed #DCE0EA;
  border-radius: 24rpx;
  text-align: center;
}
.report-empty-title { display: block; font-size: 26rpx; color: #667085; }
.report-empty-sub { display: block; margin-top: 10rpx; font-size: 22rpx; color: #98A2B3; }

/* ── 权益卡 ── */
.rights-card {
  background: #FFFFFF;
  border: 1rpx solid #E7E9F0;
  border-radius: 24rpx;
  padding: 12rpx 32rpx;
}
.right-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}
.right-item:not(:last-child) { border-bottom: 1rpx solid #F0F1F5; }
.right-dot {
  width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  margin-right: 16rpx; flex-shrink: 0;
  font-size: 22rpx; font-weight: 700; color: #FFFFFF;
  background: #8056DF; border-radius: 50%;
}
.right-name { flex: 1; min-width: 0; font-size: 28rpx; color: #192234; }
.right-empty { padding: 40rpx 0; text-align: center; font-size: 26rpx; color: #98A2B3; }

/* ── 底部安全区留白（避免被 CTA 覆盖）── */
.mc-bottom-space { height: calc(200rpx + env(safe-area-inset-bottom)); }

/* ── 底部 CTA ── */
.cta-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EAECF2;
  box-shadow: 0 -6rpx 24rpx rgba(16,24,40,0.06);
}
.cta-text { flex: 1; min-width: 0; font-size: 26rpx; color: #667085; }
.cta-text.warn { color: #F59E0B; font-weight: 600; }
.cta-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #8056DF;
  border-radius: 999rpx;
  white-space: nowrap;
}
.cta-btn.ghost {
  color: #8056DF;
  background: rgba(128,86,223,0.10);
  border: 1rpx solid rgba(128,86,223,0.35);
}
