@import '../../styles/tokens.wxss';

.page-container{min-height:100vh;padding-bottom:60px;}

/* ── 等级卡片 ── */
.level-card{margin:30px 30px 20px;padding:36px;background:#141B2D;border-radius:var(--radius-card);border:1rpx solid rgba(139,92,246,0.25);box-shadow:0 0 28rpx rgba(139,92,246,0.08);}
.level-header{display:flex;align-items:center;gap:20px;}
.level-badge{font-size:56px;}
.level-info{flex:1;}
.level-name{font-size:36px;font-weight:700;color:#FFFFFF;display:block;}
.level-sub{font-size:24px;color:var(--text-secondary);margin-top:4px;}
.level-xp-chip{display:flex;flex-direction:column;align-items:center;padding:12px 24px;background:#181f33;border-radius:16px;}
.xp-value{font-size:40px;font-weight:800;color:#C6B1FF;}
.xp-label{font-size:20px;color:var(--text-tertiary);}

/* ── XP 进度条 ── */
.xp-bar-wrap{margin-top:28px;}
.xp-bar-bg{height:10px;background:#181f33;border-radius:5px;overflow:hidden;}
.xp-bar-fill{height:100%;border-radius:5px;transition:width 0.6s ease;}
.xp-next{font-size:22px;color:var(--text-tertiary);display:block;margin-top:10px;}

/* ── 到期提醒 ── */
.expiry-chip{margin-top:24px;padding:16px 20px;background:rgba(245,158,11,0.1);border:1rpx solid rgba(245,158,11,0.3);border-radius:14px;display:flex;align-items:center;gap:12px;}
.expiry-icon{font-size:28px;}
.expiry-chip text:last-child{font-size:24px;color:var(--xsg-orange);}

/* ── 签到卡片 ── */
.checkin-card{margin:0 30px 20px;padding:28px 32px;background:rgba(34,197,94,0.08);border-radius:20px;display:flex;align-items:center;justify-content:space-between;}
.checkin-card.checked{background:rgba(34,197,94,0.04);justify-content:center;}
.checkin-left{display:flex;flex-direction:column;}
.checkin-streak{font-size:32px;font-weight:700;color:#22C55E;}
.checkin-sub{font-size:22px;color:var(--text-tertiary);margin-top:4px;}
.checkin-btn{padding:16px 36px;border-radius:16px;background:linear-gradient(135deg,#22C55E,#16A34A);color:#fff;font-size:28px;font-weight:600;}
.checkin-btn.disabled{background:#181f33;color:var(--text-tertiary);}
.checkin-done{font-size:28px;color:#22C55E;}

.milestone-bar{display:flex;align-items:center;justify-content:space-between;padding:24px 0;}
.milestone{display:flex;flex-direction:column;align-items:center;gap:6px;}
.milestone.done{opacity:1;}
.milestone:not(.done){opacity:0.4;}
.ms-icon{font-size:36px;}
.ms-label{font-size:22px;color:var(--text-secondary);}
.ms-reward{font-size:18px;color:#C6B1FF;}
.milestone-line{flex:1;height:2px;background:#1a2235;margin:0 4px 20px;}
.milestone-line.active{background:#22C55E;}

.report-card{margin-top:12px;padding:28px;background:#0f1526;border-radius:18px;border:1rpx solid rgba(255,255,255,0.05);}
.report-row{display:flex;justify-content:space-between;padding:12px 0;}
.report-row:not(:last-child){border-bottom:1rpx solid rgba(255,255,255,0.05);}
.report-key{font-size:26px;color:var(--text-secondary);}
.report-val{font-size:26px;color:#FFFFFF;font-weight:500;}
.report-val.green{color:#22C55E;}
.report-empty{padding:40px 0;text-align:center;}
.report-empty text{display:block;font-size:26px;color:var(--text-tertiary);}
.report-empty-sub{font-size:22px;margin-top:8px;color:var(--text-muted);}

.perks-list{margin-top:12px;}
.perk-item{display:flex;align-items:center;gap:14px;padding:20px 24px;background:#0f1526;border-radius:14px;margin-bottom:8px;}
.perk-icon{font-size:32px;}
.perk-name{flex:1;font-size:26px;color:#FFFFFF;}
.perk-exclusive{font-size:18px;color:#F59E0B;background:rgba(245,158,11,0.1);padding:4px 12px;border-radius:8px;}
.perk-empty{padding:30px;text-align:center;font-size:24px;color:var(--text-tertiary);}

.upgrade-bar{position:fixed;bottom:0;left:0;right:0;padding:24px 32px calc(24px + env(safe-area-inset-bottom));background:#060817;display:flex;align-items:center;justify-content:space-between;}
.upgrade-text{font-size:28px;color:#C6B1FF;font-weight:600;}
.upgrade-arrow{font-size:32px;color:#C6B1FF;}

.section{margin:0 30px 28px;}
.section-header{display:flex;justify-content:space-between;align-items:center;}
.section-title{font-size:28px;font-weight:700;color:#FFFFFF;display:block;}
