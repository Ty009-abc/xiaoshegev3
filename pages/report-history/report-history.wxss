/* pages/report-history — RC8.8 我的报告（浅科技感） */
.page {
  min-height: 100vh;
  background: #F7F8FC;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(127, 86, 217, 0.10);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}
.report-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.report-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.report-date {
  font-size: 24rpx;
  color: #667085;
}

.report-persona {
  font-size: 22rpx;
  font-weight: 500;
  color: #6B4EE6;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(127, 86, 217, 0.10);
}

.report-preview {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2939;
  line-height: 1.4;
}

.report-summary {
  font-size: 24rpx;
  color: #98A2B3;
}
