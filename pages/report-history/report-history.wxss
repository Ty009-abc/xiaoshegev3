/* pages/report-history — RC8.8 我的报告（浅科技感） */
.page {
  min-height: 100vh;
  background: #F7F8FC;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(127, 86, 217, 0.10);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}
.report-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.report-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.report-date {
  font-size: 24rpx;
  color: #667085;
}

.report-persona {
  font-size: 22rpx;
  font-weight: 500;
  color: #6B4EE6;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(127, 86, 217, 0.10);
}

.report-preview {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2939;
  line-height: 1.4;
}

.report-summary {
  font-size: 24rpx;
  color: #98A2B3;
}

/* ── 列表状态（RC8.13_P0_HISTORY_LIST_SERVER_AUTHORITY_FIX）── */
.state-hint {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #667085;
}
.state-hint.state-error {
  color: #f43f5e;
}
.state-error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 80rpx 0;
}
.state-error {
  font-size: 28rpx;
  color: #f43f5e;
}
.state-retry {
  margin: 0;
  padding: 0 48rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: #7F56D9;
  border-radius: 999rpx;
}
.state-retry::after { border: none; }
.local-notice {
  margin: 0 0 20rpx;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(127, 86, 217, 0.08);
  color: #6B4EE6;
  font-size: 22rpx;
  line-height: 1.5;
}
.report-local-tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #667085;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(52, 64, 84, 0.06);
}
