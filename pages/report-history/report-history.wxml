<!-- pages/report-history — 我的报告列表（服务端权威） -->
<view class="page">
  <xsg-navbar title="我的报告" light />

  <view class="content">
    <!-- LOADING -->
    <view wx:if="{{status === 'loading'}}" class="state-hint">正在加载报告…</view>

    <!-- UNAUTHORIZED -->
    <view wx:elif="{{status === 'unauthorized'}}" class="state-hint state-error">身份验证失败，请重新进入</view>

    <!-- ERROR（可重试；绝不回退本地） -->
    <view wx:elif="{{status === 'error'}}" class="state-error-wrap">
      <text class="state-error">加载失败，请重试</text>
      <button class="state-retry" bindtap="onRetry">重试</button>
    </view>

    <!-- SUCCESS / 服务端确认零时的本地补充 -->
    <block wx:elif="{{reports.length}}">
      <view wx:if="{{localOnly}}" class="local-notice">服务端暂无报告，以下为**本机记录**（非服务端权益，仅供本地查看）</view>
      <view class="report-list">
        <view
          class="report-card"
          wx:for="{{reports}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapReport"
          hover-class="report-card-hover"
          hover-stay-time="80"
        >
          <view class="report-head">
            <text class="report-date">{{item.dateText}}</text>
            <text class="report-persona" wx:if="{{item.title}}">{{item.title}}</text>
            <text class="report-local-tag" wx:if="{{item.local}}">本机</text>
          </view>
          <text class="report-preview">{{item.preview || '认知翻身报告'}}</text>
          <text class="report-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
        </view>
      </view>
    </block>

    <!-- EMPTY（仅服务端确认 total===0 且无本地记录） -->
    <xsg-empty
      wx:elif="{{status === 'empty'}}"
      icon="📄"
      title="暂无报告"
      desc="完成一次认知诊断后会出现在这里"
    />
  </view>
</view>
