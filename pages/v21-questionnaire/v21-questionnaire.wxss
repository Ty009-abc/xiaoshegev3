.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  /* 底部安全区（全面屏 home indicator） */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0rpx));
}

/* 自定义导航安全区占位：高度由 JS 运行时测量（状态栏+胶囊区），
   仅用于把内容推到胶囊下方，不参与答题逻辑 */
.nav-safe {
  width: 100%;
  flex-shrink: 0;
  /* 胶囊下方的小额安全视觉间距 */
  margin-bottom: 20rpx;
}

.intro, .result {
  padding-top: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.desc {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
}

.btn-primary {
  margin-top: 48rpx;
  background: #7f56d9;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.btn-ghost {
  margin-top: 24rpx;
  background: #fff;
  color: #5a6078;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.progress-wrap {
  margin-bottom: 40rpx;
}

.progress-label {
  font-size: 26rpx;
  color: #5a6078;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 12rpx;
  background: #e5e7ef;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #7f56d9;
  border-radius: 8rpx;
  transition: width 0.25s ease;
}

.q-prompt {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option {
  background: #fff;
  border: 2rpx solid #e5e7ef;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  color: #1a1a2e;
}

.option-selected {
  border-color: #7f56d9;
  background: #f5f3ff;
}

.option-text {
  line-height: 1.5;
}

.nav {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.nav button {
  flex: 1;
}

/* 上一题禁用态：明确可辨（仅视觉，不改导航逻辑） */
.nav button[disabled] {
  background: #eceef3;
  color: #b5b9c5;
  opacity: 1;
}

.result-error {
  margin-top: 24rpx;
  color: #d9534f;
  font-size: 28rpx;
}

.hint {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5a6078;
}
