/* pages/challenge-records — RC8.8 挑战记录（浅科技感） */
.page {
  min-height: 100vh;
  background: #F7F8FC;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(127, 86, 217, 0.10);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.04);
  transition: transform 160ms ease-out, opacity 160ms ease-out;
}
.record-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.record-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.record-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2939;
}

.record-status {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #667085;
  background: rgba(52, 64, 84, 0.06);
}
.status-processing {
  color: #6B4EE6;
  background: rgba(127, 86, 217, 0.10);
}
.status-finished {
  color: #12A150;
  background: rgba(18, 161, 80, 0.10);
}

.record-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.record-day {
  font-size: 26rpx;
  color: #475467;
}

.record-type {
  font-size: 26rpx;
  color: #98A2B3;
}
