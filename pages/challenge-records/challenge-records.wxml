<!-- pages/challenge-records — 挑战记录列表 -->
<view class="page">
  <xsg-navbar title="挑战记录" light />

  <view class="content">
    <!-- LOADING -->
    <view wx:if="{{status === 'loading'}}" class="state-hint">正在加载挑战记录…</view>

    <!-- UNAUTHORIZED -->
    <view wx:elif="{{status === 'unauthorized'}}" class="state-hint state-error">身份验证失败，请重新进入</view>

    <!-- ERROR（可重试） -->
    <view wx:elif="{{status === 'error'}}" class="state-error-wrap">
      <text class="state-error">加载失败，请重试</text>
      <button class="state-retry" bindtap="onRetry">重试</button>
    </view>

    <!-- SUCCESS -->
    <block wx:elif="{{status === 'success' && records.length}}">
      <view class="record-list">
        <view
          class="record-card"
          wx:for="{{records}}"
          wx:key="recordId"
          data-id="{{item.recordId}}"
          data-status="{{item.status}}"
          bindtap="onTapRecord"
          hover-class="record-card-hover"
          hover-stay-time="80"
        >
          <view class="record-top">
            <text class="record-date">{{item.dateText}}</text>
            <text class="record-status {{item.statusCls}}">{{item.statusText}}</text>
          </view>
          <view class="record-bottom">
            <text class="record-day" wx:if="{{item.dayText}}">{{item.dayText}}</text>
            <text class="record-type" wx:if="{{item.typeText}}">· {{item.typeText}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- EMPTY（仅服务端确认 total===0） -->
    <xsg-empty
      wx:elif="{{status === 'empty'}}"
      icon="🎯"
      title="暂无挑战记录"
      desc="完成一次认知挑战后会出现在这里"
    />
  </view>
</view>
