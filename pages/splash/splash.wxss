@import '../../styles/tokens.wxss';
/* ═══════════════════════════════════
   pages/splash — 启动页沉浸修正
   ═══════════════════════════════════ */

.splash {
  width: 100%;
  height: 100vh; 
  max-width: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0d0b1d;
}

.logo-area {
  animation: fadeSlideUp 1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 0 40rpx rgba(124,92,255,0.3));
}

.title {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #C6B1FF;
  font-weight: 400;
  letter-spacing: 16rpx;
}

.tagline {
  font-size: 26rpx;
  color: #8890A8;
  margin-bottom: 80rpx;
  animation: fadeSlideUp 1.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.fade-hint {
  font-size: 24rpx;
  color: #5A6078;
  animation: shimmer 2s infinite;
}

/* ── keyframes ── */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes shimmer {
  0%, 100% { opacity: 0.28; }
  50%      { opacity: 1; }
}
