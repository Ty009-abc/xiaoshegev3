/* pages/ai-analysis/ai-analysis.wxss */
/* v3.7.4 流式重构：骨架屏 + 5 大板块卡片 + 字体 28-30rpx / 行高 1.6 */

.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 24rpx;
  box-sizing: border-box;
}

/* === 空态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 48rpx;
  text-align: center;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; font-weight: 700; color: #101828; margin-bottom: 16rpx; }
.empty-desc { font-size: 28rpx; color: #5A6078; line-height: 1.7; letter-spacing: 1rpx; margin-bottom: 36rpx; max-width: 500rpx; }
.cta-btn {
  background: linear-gradient(135deg, #7F56D9, #0a84ff);
  color: #fff; font-size: 28rpx; font-weight: 600;
  padding: 20rpx 64rpx; border-radius: 48rpx; border: none;
}

/* === 报告头部 === */
.report-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  margin-bottom: 28rpx;
}
.report-badge {
  display: inline-block;
  background: rgba(127,86,217,0.2);
  color: #a78bfa;
  font-size: 24rpx; padding: 10rpx 32rpx;
  border-radius: 32rpx; margin-bottom: 24rpx;
  letter-spacing: 0.5rpx;
}
.report-title {
  font-size: 38rpx; font-weight: 700; color: #fff; margin-bottom: 14rpx;
  line-height: 1.4; letter-spacing: 1rpx;
}
.report-meta {
  font-size: 24rpx; color: rgba(255,255,255,0.65);
  line-height: 1.5;
}

/* AI 状态指示条 */
.ai-status-bar {
  display: flex; align-items: center; justify-content: center;
  gap: 14rpx; margin-top: 28rpx;
  padding: 16rpx 28rpx;
  background: rgba(127,86,217,0.18);
  border-radius: 40rpx;
}
.ai-pulse {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  background: #a78bfa;
  animation: pulse-glow 1.2s ease-in-out infinite;
}
.ai-status-text {
  font-size: 26rpx; color: #c4b5fd;
  letter-spacing: 0.5rpx;
}
@keyframes pulse-glow {
  0%, 100% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

/* === 人物画像 === */
.persona-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #7F56D9;
}
.persona-label {
  font-size: 28rpx; color: #7F56D9; font-weight: 700;
  margin-bottom: 14rpx; letter-spacing: 0.5rpx;
}
.persona-text {
  font-size: 30rpx; color: #101828;
  line-height: 1.6; letter-spacing: 0.5rpx;
}

/* ══════════════════════════════════════════ */
/* ★ 5 大板块卡片                          */
/* ══════════════════════════════════════════ */
.sections-wrap {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.section-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: box-shadow 0.3s;
}

/* 板块标题（固定区） */
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx 16rpx 28rpx;
}
.section-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

/* 正文（有内容） */
.section-body {
  padding: 0 28rpx 28rpx 28rpx;
}
.section-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

/* 骨架屏 */
.section-skeleton {
  padding: 0 28rpx 28rpx 28rpx;
  position: relative;
}
.skeleton-shimmer {
  width: 100%;
  height: 80rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.6s ease-in-out infinite;
  margin-bottom: 18rpx;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.skeleton-text {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.5;
  display: block;
  margin-bottom: 14rpx;
}
.skeleton-dots {
  display: flex;
  gap: 10rpx;
}
.sk-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
  background: #d1d5db;
  animation: dot-bounce 1.2s ease-in-out infinite;
}
.sk-dot:nth-child(2) { animation-delay: 0.2s; }
.sk-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* === 核心评分 === */
.score-card {
  background: #fff; border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.score-label {
  font-size: 28rpx; color: #5A6078;
  margin-bottom: 14rpx; letter-spacing: 0.5rpx;
}
.score-value {
  font-size: 72rpx; font-weight: 800; color: #7F56D9;
  line-height: 1; margin-bottom: 18rpx;
}
.score-scale {
  display: flex; align-items: center; gap: 12rpx;
}
.scale-lo, .scale-hi { font-size: 22rpx; color: #9CA3AF; }
.scale-bar {
  flex: 1; height: 8rpx;
  background: #e5e7eb; border-radius: 4rpx; overflow: hidden;
}
.scale-fill {
  height: 100%;
  background: linear-gradient(90deg, #ef4444, #f5c16c, #0a84ff);
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

/* === 九维雷达 === */
.radar-section {
  background: #fff; border-radius: 16rpx;
  padding: 28rpx; margin-bottom: 28rpx;
}
.radar-header {
  font-size: 30rpx; font-weight: 700; color: #101828;
  margin-bottom: 22rpx; letter-spacing: 0.5rpx;
}
.radar-grid { display: flex; flex-direction: column; gap: 18rpx; }
.radar-dim { display: flex; align-items: center; gap: 14rpx; }
.radar-dim-name {
  font-size: 26rpx; color: #374151;
  width: 130rpx; flex-shrink: 0;
}
.radar-dim-bar { flex: 1; height: 14rpx; background: #f3f4f6; border-radius: 7rpx; overflow: hidden; }
.radar-dim-fill { height: 100%; border-radius: 7rpx; transition: width 0.6s ease; }
.radar-dim-val {
  font-size: 26rpx; font-weight: 600; color: #101828;
  width: 48rpx; text-align: right;
}

/* === 按钮 === */
.action-row {
  display: flex; gap: 16rpx; margin-bottom: 16rpx;
}
.action-row-bottom { text-align: center; }
.action-btn {
  flex: 1; font-size: 30rpx; font-weight: 600;
  padding: 26rpx 0; border-radius: 48rpx; border: none;
}
.action-btn.primary {
  background: linear-gradient(135deg, #7F56D9, #0a84ff);
  color: #fff;
}
.action-btn.secondary {
  background: #fff; color: #7F56D9;
  border: 2rpx solid #7F56D9;
}
.action-btn.ghost {
  background: transparent; color: #5A6078;
  font-size: 28rpx; padding: 18rpx 0;
}

/* ── 合规免责声明 ── */
.compliance-tips {
  font-size: 22rpx !important;
  color: #8890A8 !important;
  line-height: 1.4 !important;
  margin-top: 20rpx !important;
  padding-top: 16rpx !important;
  border-top: 1rpx dashed #E0E5ED;
  text-align: left !important;
}
