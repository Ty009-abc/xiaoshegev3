/* membership — 挑战解锁专用页 · 浅色主题 */

page {
  background: #F5F7FB;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
}

/* ═══════════ 头部 ═══════════ */
.hero {
  text-align: center;
  padding: 48rpx 0 24rpx;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
  line-height: 1.6;
}

/* ═══════════ 权益卡 ═══════════ */
.perks-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.perks-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
  margin-bottom: 20rpx;
}

.perk-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.perk {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #4B5563;
  padding: 4rpx 0;
}

.perk text:first-child {
  font-size: 22rpx;
}

/* ═══════════ 商品卡 ═══════════ */
.product-card {
  background: linear-gradient(135deg, #F3EEFF, #FFFFFF);
  border: 2rpx solid #C6B1FF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.product-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 20rpx 8rpx 24rpx;
  background: linear-gradient(90deg, #7C4DFF, #4E7BFF);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 0 28rpx 0 20rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 8rpx;
  margin-top: 4rpx;
}

.product-desc {
  font-size: 26rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 48rpx;
  font-weight: 800;
  color: #7C4DFF;
}

.product-original {
  font-size: 28rpx;
  color: #9CA3AF;
  text-decoration: line-through;
}

.product-tag {
  font-size: 22rpx;
  color: #7C4DFF;
  font-weight: 500;
}

/* ═══════════ 支付区 ═══════════ */
.pay-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 0 32rpx;
}

/* ═══════════ 取消按钮 ═══════════ */
.cancel-unlock-btn {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: #667085;
  font-size: 30rpx;
  font-weight: 500;
}

.cancel-unlock-btn::after { border: none; }

.cancel-unlock-btn[disabled] {
  color: #B8BEC9;
  opacity: 1;
}

.cancel-press {
  opacity: .65;
}

.safe-hint {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ═══════════ 错误态 ═══════════ */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 80rpx 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: #EF4444;
  text-align: center;
}
