<!-- membership — 认知会员购买页（RC8_11 会员权威） -->
<view class="page">
  <xsg-navbar title="开通认知会员" light />

  <xsg-loading text="加载方案..." wx:if="{{loading}}" />

  <block wx:elif="{{loadError}}">
    <view class="error-card">
      <text class="error-text">{{loadError}}</text>
      <xsg-button type="primary" text="重试" bind:tapbutton="onRetry" />
    </view>
  </block>

  <block wx:else>
    <!-- RC8_13_P0_MEMBER_ENTRY — 已付费会员详情态（服务端 getMembership 权威；不自动购买） -->
    <view class="member-detail" wx:if="{{mode !== 'member' && active}}">
      <view class="md-head">
        <text class="md-title">认知会员 · {{memberLevelText}}</text>
        <text class="md-status">生效中</text>
      </view>
      <text class="md-sub">有效期至 {{memberExpiryText || '—'}}</text>
      <view class="md-rights" wx:if="{{memberRights.length}}">
        <text class="md-rights-label">当前权益</text>
        <view class="md-rights-list">
          <text class="md-right-chip" wx:for="{{memberRights}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="md-actions">
        <view class="md-btn primary" bindtap="openMemberDetails">查看会员详情</view>
      </view>
    </view>

    <!-- 会员态未知 / 同步失败：绝不误示为免费用户 -->
    <view class="member-detail member-unknown" wx:elif="{{mode !== 'member' && memberLoading}}">
      <text class="md-title">我的会员</text>
      <text class="md-sub">正在同步会员状态…</text>
    </view>
    <view class="member-detail member-unknown" wx:elif="{{mode !== 'member' && memberLoadError}}">
      <text class="md-title">我的会员</text>
      <text class="md-sub">会员状态同步失败，请重试</text>
      <view class="md-btn" bindtap="refreshMemberState">重新同步</view>
    </view>

    <!-- 购买区：仅免费用户 or 显式购买入口(mode=member)；已付费会员不展示强制复购 -->
    <block wx:if="{{mode === 'member' || !active}}">
    <!-- 头部 -->
    <view class="hero">
      <text class="hero-icon">🧠</text>
      <text class="hero-title">认知会员</text>
      <text class="hero-desc">解锁完整认知系统 · 持续进化的认知操作系统</text>
    </view>

    <!-- 权益说明 -->
    <view class="perks-card">
      <text class="perks-title">会员权益：</text>
      <view class="perk-list">
        <view class="perk"><text>🤖</text><text>AI问小事哥</text></view>
        <view class="perk"><text>🎯</text><text>6个个性化场景</text></view>
        <view class="perk"><text>🧬</text><text>长期记忆</text></view>
        <view class="perk"><text>🏆</text><text>30天认知挑战</text></view>
        <view class="perk"><text>📄</text><text>完整世界模型报告</text></view>
        <view class="perk"><text>📚</text><text>历史报告与复盘</text></view>
      </view>
      <text class="perks-note" wx:if="{{plan === 'annual'}}">年卡另含：硬核真相模式 · 进阶报告 · 优先模型</text>
    </view>

    <!-- 方案选择 -->
    <view class="plans">
      <view class="plan-card {{plan === 'monthly' ? 'active' : ''}}" data-plan="monthly" bindtap="onSelectPlan">
        <view class="plan-badge" wx:if="{{monthly.hasOriginalPrice}}">限时优惠</view>
        <text class="plan-name">{{monthly.name || '认知会员月卡'}}</text>
        <view class="plan-price-row">
          <text class="plan-price">¥{{monthly.priceDisplay || '39.90'}}</text>
          <text class="plan-original" wx:if="{{monthly.hasOriginalPrice}}">¥{{monthly.originalPriceDisplay}}</text>
        </view>
        <text class="plan-unit">/ 月</text>
      </view>

      <view class="plan-card {{plan === 'annual' ? 'active' : ''}}" data-plan="annual" bindtap="onSelectPlan" wx:if="{{annual}}">
        <view class="plan-badge year">超值年卡</view>
        <text class="plan-name">{{annual.name || '认知会员年卡'}}</text>
        <view class="plan-price-row">
          <text class="plan-price">¥{{annual.priceDisplay || '299.00'}}</text>
          <text class="plan-original" wx:if="{{annual.hasOriginalPrice}}">¥{{annual.originalPriceDisplay}}</text>
        </view>
        <text class="plan-unit" wx:if="{{annual.perMonth}}">约 ¥{{annual.perMonth}} / 月</text>
        <text class="plan-unit" wx:else>/ 年</text>
      </view>
    </view>

    <!-- 支付按钮 -->
    <view class="pay-section">
      <xsg-button type="primary" text="{{paying ? '正在唤起微信支付...' : '微信支付 ¥' + (priceDisplay || '')}}" loading="{{paying}}" disabled="{{paying || !product}}" bind:tapbutton="onPay" />

      <button class="cancel-unlock-btn" bindtap="onCancelUnlock" disabled="{{paying}}" hover-class="cancel-press">暂不开通</button>

      <text class="safe-hint">🔒 支付由微信安全保障</text>
    </view>

    </block>

    <view style="height:80rpx;"></view>
  </block>
</view>
