/* world-rule-detail v3.1 — 浅色主题 */

.page {
  background: #F5F7FB;
  color: #111827;
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 所有卡片在浅色主题下保持一致 */
.card-light {
  background: #FFFFFF !important;
  border: 1rpx solid #E8ECF2 !important;
  border-radius: 28rpx !important;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04) !important;
  padding: 32rpx !important;
  margin-bottom: 24rpx !important;
}

/* 主标题 */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
}

/* 标签行 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-chip {
  font-size: 22rpx;
  color: #6D4AFF;
  background: #F4F0FF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 锁定提示 */
.locked-notice {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: #FFFBF0;
  border: 1rpx solid rgba(245, 193, 76, 0.35);
  border-radius: 14rpx;
}

.locked-text {
  font-size: 24rpx;
  color: #B45309;
}

/* section 标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #111827;
  margin-bottom: 14rpx;
}

/* 反向逻辑 — 淡紫卡片 */
.card-reverse {
  background: #F7F5FF !important;
  border-color: #EDE9FE !important;
}

.section-title-reverse {
  color: #6D4AFF;
}

/* 行动建议 — 暖黄卡片 */
.card-action-block {
  background: #FFF9EE !important;
  border-color: #FDE68A !important;
}

.section-title-action {
  color: #D97706;
}

/* 正文 */
.body {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.95;
  white-space: pre-line;
  word-break: break-all;
}
