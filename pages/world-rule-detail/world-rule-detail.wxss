@import '../../styles/tokens.wxss';
.page{background:var(--bg-primary);padding:var(--sp-24);padding-top:calc(var(--sp-24)+env(safe-area-inset-top));min-height:100vh;}
.title{font-size:var(--font-h2);font-weight:700;color:var(--text-primary);line-height:1.4;}
.oneliner{font-size:var(--font-body);color:var(--accent-gold);font-style:italic;}
.section-title{font-size:var(--font-h3);font-weight:600;color:var(--text-primary);margin-bottom:var(--sp-12);}
.body{font-size:var(--font-body);color:var(--text-secondary);line-height:1.9;white-space:pre-line;}
