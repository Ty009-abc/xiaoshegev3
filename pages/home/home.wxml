<!-- home — v3.7 视觉重构：修复底部空白 + 板块色差 + 强化引导箭头 -->
<view class="container">

  <!-- 1️⃣ Hero Section — 顶部暗色区域 -->
  <view class="hero-section">
    <view class="page-title">珠澳小事哥</view>
    <view class="brand-name">珠澳小事哥</view>
    <view class="tag-badge">认知拆解 · 系统分析</view>
    <view class="hero-title">看清你为什么翻不了身</view>
    <view class="hero-subtitle">用底层逻辑探索你的认知密码</view>
    <view class="hero-btns">
      <button class="btn-main" bindtap="goStrategy" loading="{{strategyLoading}}">开始翻身策略</button>
      <button class="btn-sub" bindtap="goAIChat">
        <text class="icon-chat">💬</text> 直接问小事哥
      </button>
      <view class="btn-tips">约6个问题 · 2分钟</view>
    </view>
  </view>

  <!-- 2️⃣ 白色大圆角卡片底座 -->
  <view class="white-card-base">

    <!-- 特性列表 -->
    <view class="feature-list">
      <view class="feature-item">
        <view class="feature-icon-wrapper" style="background:#F5F3FF;"><text class="feature-icon-emoji">🎯</text></view>
        <view class="feature-info">
          <text class="feature-title">深度场景化拆解</text>
          <text class="feature-desc">结合年龄、职业、收入，精准定位困境</text>
        </view>
      </view>
      <view class="feature-divider"></view>
      <view class="feature-item">
        <view class="feature-icon-wrapper" style="background:#EFF6FF;"><text class="feature-icon-emoji">⚡</text></view>
        <view class="feature-info">
          <text class="feature-title">直击底层逻辑</text>
          <text class="feature-desc">跳出表面现象，发现隐藏的规律</text>
        </view>
      </view>
      <view class="feature-divider"></view>
      <view class="feature-item">
        <view class="feature-icon-wrapper" style="background:#FDF2F8;"><text class="feature-icon-emoji">💼</text></view>
        <view class="feature-info">
          <text class="feature-title">破局方向指引</text>
          <text class="feature-desc">提供可执行的操作方案</text>
        </view>
      </view>
    </view>

    <!-- 场景标签 -->
    <view class="scene-section">
      <view class="scene-tips">点击场景，提前探索你的可能</view>
      <view class="scene-grid">
        <view class="scene-chip chip-purple" data-q="职场困境" bindtap="onQuickAsk">🏢 职场困境</view>
        <view class="scene-chip chip-blue"   data-q="副业方向" bindtap="onQuickAsk">🚀 副业方向</view>
        <view class="scene-chip chip-green"  data-q="AI赛道"   bindtap="onQuickAsk">🤖 AI赛道</view>
        <view class="scene-chip chip-amber"  data-q="搞钱逻辑" bindtap="onQuickAsk">💰 搞钱逻辑</view>
        <view class="scene-chip chip-indigo" data-q="认知升级" bindtap="onQuickAsk">🧠 认知升级</view>
        <view class="scene-chip chip-pink"   data-q="流量密码" bindtap="onQuickAsk">📱 流量密码</view>
      </view>
    </view>

    <!-- 统计区 -->
    <view class="stats-section" wx:if="{{user}}">
      <view class="stats-grid">
        <view class="sg-item" bindtap="goProfile">
          <text class="sg-num">{{user.cv||0}}</text>
          <text class="sg-label">CV</text>
        </view>
        <view class="sg-item" bindtap="goProfile">
          <text class="sg-num">Lv.{{user.level||1}}</text>
          <text class="sg-label">等级</text>
        </view>
        <view class="sg-item">
          <text class="sg-num">🔥{{streak}}天</text>
          <text class="sg-label">连续</text>
        </view>
        <view class="sg-item" bindtap="goMembership">
          <text class="sg-num">{{user.membershipLevel==='free'?'觉醒':'VIP'}}</text>
          <text class="sg-label">身份</text>
        </view>
      </view>
      <xsg-progress value="{{cvPercent}}" max="100" label="认知进度" color="ai" />
    </view>

    <!-- 每日认知暴击 -->
    <view class="daily-section">
      <view class="home-card ai-card" bindtap="onStrikeTap">
        <view class="home-card-header">
          <text class="home-card-badge-icon">⚡</text>
          <text class="home-card-badge-text">今日认知暴击</text>
        </view>
        <text class="home-card-title">一句话，击穿一个认知盲区</text>
        <text class="home-card-sub">每日更新 · 4层递进展开 · 认知拆解</text>
        <text class="home-card-arrow">›</text>
      </view>
    </view>

    <!-- 功能入口 — 带色差卡片 + 右对齐大箭头 -->
    <view class="action-section">

      <!-- 30天挑战 → 浅紫色 -->
      <view class="home-card challenge-card" bindtap="goChallenge">
        <view class="home-card-icon icon-purple">
          <text class="home-card-emoji">🎯</text>
        </view>
        <view class="home-card-body">
          <text class="home-card-title">30天认知翻身挑战</text>
          <text class="home-card-sub">每天一道决策题 · 诊断认知层级 · 免费3题</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>

      <!-- 世界运行规则 → 蓝底icon -->
      <view class="home-card" bindtap="goWorldRules">
        <view class="home-card-icon icon-blue">
          <text class="home-card-emoji">📜</text>
        </view>
        <view class="home-card-body">
          <text class="home-card-title">世界运行规则</text>
          <text class="home-card-sub">15条底层逻辑</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>

      <!-- 邀请好友 → 浅金色底 -->
      <view class="home-card invite-card" bindtap="goInvite">
        <view class="home-card-icon icon-amber">
          <text class="home-card-emoji">🎁</text>
        </view>
        <view class="home-card-body">
          <text class="home-card-title">邀请好友升级世界模型</text>
          <text class="home-card-sub">+20CV · 解锁VIP规则 · 免费报告</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>

      <!-- 排行榜 -->
      <view class="home-card" bindtap="goRanking">
        <view class="home-card-icon icon-teal">
          <text class="home-card-emoji">🏆</text>
        </view>
        <view class="home-card-body">
          <text class="home-card-title">认知成长排行榜</text>
          <text class="home-card-sub">看看谁在快速升级世界模型</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>

      <!-- 9.9元解锁报告 → 浅金橙色底 -->
      <view class="home-card value-card" bindtap="goReports" wx:if="{{showFreeValue}}">
        <view class="home-card-icon">
          <text class="home-card-emoji">🧬</text>
        </view>
        <view class="home-card-body">
          <text class="home-card-title">9.9元 · 解锁完整世界模型</text>
          <text class="home-card-sub">AI深度诊断 · 翻身概率 · 30天计划</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>

      <!-- Growth Panel -->
      <growth-panel cv="{{user.cv||0}}" level="{{user.level||1}}" streak="{{streak}}" theme="light" />

      <!-- 开通会员 -->
      <view class="home-card member-card" bindtap="goMembership" wx:if="{{showFreeValue}}">
        <view class="home-card-emoji" style="font-size:36rpx;flex-shrink:0;">⭐</view>
        <view class="home-card-body">
          <text class="home-card-title">开通会员 · 解锁全部认知系统 · 年卡299</text>
        </view>
        <text class="home-card-arrow">›</text>
      </view>
    </view>

    <view class="version" bindtap="onTapVersion">v3.7 · 认知操作系统</view>
  </view>

</view>
