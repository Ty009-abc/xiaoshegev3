<!--
  pages/turnaround-v6-report/turnaround-v6-report.wxml
  RC8.4 V6 — 生产五卡翻身策略报告（纯展示层）
  只渲染后端权威报告；不重诊断、不改写、不编造分数/百分比。

  R38 — ONE FINAL PRESENTATION AUTHORITY per card（每个语义只渲染一次）：
    01 致命一句话 : title + oneLiner
    02 核心问题   : title + body
    03 系统困局   : title + loopNodes + finalInsight（不渲染重复段落）
    04 翻身路径   : title + from → to + worldRule（不渲染重复 FROM/TO）
    05 现在就做   : title + primaryAction + target/timebox + signal + decision
                    （不渲染遗留 productivity checks / 聚合 text）
-->
<view class="page">

  <view class="nav-safe" style="height: {{totalNavHeight}}px;"></view>

  <view wx:if="{{loading}}" class="state">加载中…</view>

  <!-- R48 §5 — EVIDENCE_CONFLICT：专用轻量冲突态（不展示五卡/不展示“暂时无法生成”） -->
  <view wx:elif="{{uiState === 'EVIDENCE_CONFLICT'}}" class="conflict-block">
    <view class="conflict-title">{{title}}</view>
    <view class="conflict-body">{{message}}</view>
    <button wx:for="{{ctas}}" wx:key="id"
      class="{{item.primary ? 'btn-primary' : 'btn-ghost'}}"
      data-cta="{{item.id}}"
      bindtap="onConflictCta">{{item.label}}</button>
  </view>

  <!-- 无报告 / 不可用 / 错误：中性文案 + 重试/重测，绝不暴露工程信息 -->
  <view wx:elif="{{!hasReport}}" class="state-block">
    <view class="state-title">翻身策略</view>
    <view class="state-message">{{message}}</view>
    <button wx:if="{{retake}}" class="btn-primary" bindtap="onRetake">重新测评</button>
    <button class="btn-ghost" bindtap="onRetry">刷新</button>
    <button class="btn-ghost" bindtap="onBack">返回</button>
  </view>

  <block wx:else>
    <view class="report-head">
      <view class="report-title">你的翻身策略</view>
      <!-- R84-B §6 — opening kept extremely short: one orientation line. -->
      <view class="report-sub">下面不是建议，是你当前最值得看清的一件事。</view>
    </view>

    <!-- 五张卡：顺序固定 01→05，每卡单一展示权威 -->
    <view class="card {{item.key === 'fatalInsight' ? 'card-hero' : ''}}" wx:for="{{cards}}" wx:key="key" wx:for-index="cardIndex">
      <view class="card-head">
        <view class="card-num">0{{cardIndex + 1}}</view>
        <view class="card-title">{{item.title}}</view>
      </view>

      <!-- 01 致命一句话：VERDICT / HERO，一句到底，独占视觉焦点 -->
      <view wx:if="{{item.oneLiner}}" class="card-body card-oneliner">{{item.oneLiner}}</view>

      <!-- 02 核心问题：身份标签（第一句）与解释分离；拼接后与正文逐字一致 -->
      <block wx:if="{{item.body}}">
        <view wx:if="{{item.identity}}" class="card-identity">{{item.identity}}</view>
        <view wx:if="{{item.explanation}}" class="card-body card-explanation">{{item.explanation}}</view>
        <view wx:if="{{!item.identity && !item.explanation}}" class="card-body">{{item.body}}</view>
      </block>

      <!-- 03 系统困局：纵向可扫读的机制链（step ↓ step）+ 一句结论 -->
      <view wx:if="{{item.loopNodes && item.loopNodes.length}}" class="card-steps">
        <view class="card-step" wx:for="{{item.loopNodes}}" wx:for-item="node" wx:for-index="ni" wx:key="*this">
          <view class="card-step-idx">{{ni + 1}}</view>
          <view class="card-step-text">{{node}}</view>
        </view>
      </view>
      <view wx:if="{{item.finalInsight}}" class="card-conclusion">
        <text class="card-conclusion-tag">结论</text>
        <text class="card-conclusion-text">{{item.finalInsight}}</text>
      </view>

      <!-- 04 翻身路径：FROM → TO 迁移一眼可见；TO 权威强于 FROM；世界规则次之 -->
      <view wx:if="{{item.from || item.to}}" class="path-block">
        <view class="path-row">
          <view class="path-label">{{item.fromLabel || '现在'}}</view>
          <view class="path-text">{{item.from}}</view>
        </view>
        <view class="path-arrow">{{item.arrow || '→'}}</view>
        <view class="path-row path-row-to">
          <view class="path-label path-label-to">{{item.toLabel || '接下来'}}</view>
          <view class="path-text">{{item.to}}</view>
        </view>
      </view>
      <view wx:if="{{item.worldRule}}" class="card-rule">
        <text class="card-rule-tag">{{item.worldRuleLabel || '世界规则'}}</text>
        <text class="card-rule-text">{{item.worldRule}}</text>
      </view>
      <view wx:if="{{item.specificity}}" class="card-specificity">{{item.specificity}}</view>

      <!-- 05 现在就做：本次目标 + 中文微标题行动（行动1/2/3）+ 验证标准 -->
      <view wx:if="{{item.goal}}" class="action-block">
        <view class="action-goal">
          <text class="action-goal-label">{{item.goalLabel || '本次目标'}}</text>
          <text class="action-goal-text">{{item.goal}}</text>
        </view>
        <!-- R84-A — 中文微标题（定产品/找买家/跑复购）；无微标题时回退到中性序号 -->
        <view wx:if="{{item.actionItems && item.actionItems.length}}" class="action-steps">
          <view class="action-step" wx:for="{{item.actionItems}}" wx:for-item="act" wx:for-index="ai" wx:key="ai">
            <view class="action-step-head">
              <text class="action-step-idx">{{act.label || ('行动' + (ai + 1))}}</text>
              <text wx:if="{{act.title}}" class="action-step-title">{{act.title}}</text>
            </view>
            <text class="action-step-text">{{act.text}}</text>
          </view>
        </view>
        <view wx:elif="{{item.actions && item.actions.length}}" class="action-steps">
          <view class="action-step" wx:for="{{item.actions}}" wx:for-item="act" wx:for-index="ai" wx:key="*this">
            <view class="action-step-head">
              <text class="action-step-idx">行动 {{ai + 1}}</text>
            </view>
            <text class="action-step-text">{{act}}</text>
          </view>
        </view>
        <view wx:if="{{item.acceptance}}" class="action-accept">
          <text class="action-accept-label">{{item.acceptLabel || '验证标准'}}</text>
          <text class="action-accept-text">{{item.acceptance}}</text>
        </view>
      </view>

      <!-- 05 现在就做（遗留确定性布局：一个动作 + 找谁/多久 + 看什么 + 怎么判断） -->
      <view wx:elif="{{item.primaryAction}}" class="action-block">
        <view class="action-main">{{item.primaryAction}}</view>
        <view wx:if="{{item.target || item.timebox}}" class="action-line">
          <text wx:if="{{item.target}}">找谁：{{item.target}}</text>
          <text wx:if="{{item.timebox}}">　多久：{{item.timebox}}</text>
        </view>
        <view wx:if="{{item.signal}}" class="action-line">看什么：{{item.signal}}</view>
        <view wx:if="{{item.decision}}" class="action-line">怎么判断：{{item.decision}}</view>
        <view wx:if="{{item.specificity}}" class="action-line action-specificity">{{item.specificity}}</view>
      </view>
    </view>

    <!-- R84-B §18/§19 — closing: reality experiment -> return to Cognitive OS.
         后续个性化内容基于 R77–R79（Cognitive Profile + 个性化推荐）已有能力，不做超出其的承诺。 -->
    <view class="report-closing">
      <view class="report-closing-line report-closing-strong">完成这场现实实验，再回到认知系统。</view>
      <view class="report-closing-line">之后的认知内容会根据这次诊断继续推荐。</view>
    </view>

    <!-- R84-B §20 — 归宿路径（消除断头路，不新增架构，只复用已有路由） -->
    <view class="report-home">
      <view class="report-home-title">接下来去哪儿</view>
      <view class="report-home-grid">
        <view class="home-chip" bindtap="onGoWorldRules">世界规则</view>
        <view class="home-chip" bindtap="onGoDaily">每日认知</view>
        <view class="home-chip" bindtap="onGoAIChat">直接问小事哥</view>
      </view>
    </view>

    <view class="report-actions">
      <button class="btn-primary" bindtap="onGoHome">返回首页</button>
      <button class="btn-ghost" bindtap="onRetake">重新测评</button>
    </view>
  </block>

</view>
