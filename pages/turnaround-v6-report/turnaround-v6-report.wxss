.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom, 0rpx));
}

.nav-safe {
  width: 100%;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.state {
  padding-top: 80rpx;
  text-align: center;
  color: #5a6078;
  font-size: 28rpx;
}

.state-block {
  padding-top: 80rpx;
}

.state-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.state-message {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
}

.report-head {
  padding: 24rpx 0 8rpx;
}

.report-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.report-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a90a3;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-top: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 20, 40, 0.04);
  overflow: hidden;
}

/* R84-B §7 — CARD01 is a VERDICT / HERO: more presence, one dominant line. */
.card-hero {
  padding: 44rpx 32rpx 40rpx;
  border-left: 8rpx solid #7f56d9;
  box-shadow: 0 8rpx 28rpx rgba(127, 86, 217, 0.14);
}

.card-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.card-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #7f56d9;
  letter-spacing: 2rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.card-body {
  font-size: 30rpx;
  color: #2b2f42;
  line-height: 1.7;
  word-break: break-word;
}

/* 01 致命一句话：VERDICT / HERO — 一句到底，独占焦点 */
.card-oneliner {
  font-size: 40rpx;
  color: #1a1a2e;
  font-weight: 700;
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

/* 02 核心问题：身份标签显著高于解释 */
.card-identity {
  font-size: 36rpx;
  color: #7f56d9;
  font-weight: 700;
  line-height: 1.6;
  word-break: break-word;
}
.card-explanation {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #2b2f42;
  font-weight: 400;
}

/* ── 03 系统困局：纵向机制链 step ↓ step ── */
.card-steps {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.card-step {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 14rpx 0;
  position: relative;
}

/* vertical causal connector between steps (not after the last) */
.card-step::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 52rpx;
  bottom: -14rpx;
  width: 2rpx;
  background: #e6e2f3;
}
.card-step:last-child::after { display: none; }

.card-step-idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f0eafb;
  color: #7f56d9;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.card-step-text {
  font-size: 30rpx;
  color: #2b2f42;
  line-height: 1.7;
  word-break: break-word;
  flex: 1;
}

/* legacy dot retained for compatibility (no longer rendered) */
.card-step-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7f56d9;
  margin-top: 14rpx;
  flex-shrink: 0;
}

/* 03 系统困局：拔高结论 — 视觉独立但简短；紫色仅用于此结论 */
.card-insight { margin-top: 8rpx; }
.card-insight-line {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-word;
}
.card-conclusion {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-left: 6rpx solid #7f56d9;
  background: #faf8ff;
  border-radius: 0 12rpx 12rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.card-conclusion-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: #7f56d9;
  letter-spacing: 2rpx;
}
.card-conclusion-text {
  font-size: 30rpx;
  color: #4a3b7a;
  font-weight: 700;
  line-height: 1.7;
  word-break: break-word;
}

/* ── 04 翻身路径：FROM → TO，TO 权威 > FROM；世界规则次之 ── */
.path-block { margin-top: 8rpx; }
.path-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.path-label {
  font-size: 24rpx;
  color: #8a90a3;
  flex-shrink: 0;
  padding-top: 4rpx;
  width: 90rpx;
}
.path-text {
  font-size: 30rpx;
  color: #5a6078;
  line-height: 1.7;
  word-break: break-word;
  flex: 1;
}
.path-arrow {
  color: #7f56d9;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  margin: 8rpx 0 8rpx 106rpx;
}
/* TO 权重强于 FROM：紫色 + 加粗 + 略大 */
.path-row-to .path-label-to { color: #7f56d9; font-weight: 700; }
.path-row-to .path-text {
  color: #7f56d9;
  font-weight: 700;
  font-size: 32rpx;
}

/* 04 世界规则：次要（非紫），带小标签；不用紫色长段 */
.card-rule {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.card-rule-tag {
  font-size: 24rpx;
  font-weight: 700;
  color: #8a90a3;
  letter-spacing: 2rpx;
}
.card-rule-text {
  font-size: 29rpx;
  color: #2b2f42;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-word;
}

.action-block {
  margin-top: 8rpx;
}

/* R75 §12 — 紫色仅用于：关键结论 / TO 状态 / 90天目标 / 验收标准。 */
.action-goal {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #f6f2fd;
  border-radius: 14rpx;
}

.action-goal-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #7f56d9;
  letter-spacing: 2rpx;
}

.action-goal-text {
  font-size: 30rpx;
  color: #7f56d9;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-word;
}

.action-steps {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* R84-B §11 — each action is a distinct execution unit */
.action-step {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  background: #f7f7fb;
  border-radius: 14rpx;
}

.action-step-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-step-idx {
  font-size: 24rpx;
  font-weight: 700;
  color: #7f56d9;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.action-step-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* legacy numeric label retained for compatibility (no longer primary) */
.action-step-num {
  font-size: 22rpx;
  font-weight: 700;
  color: #8a90a3;
  letter-spacing: 1rpx;
  flex-shrink: 0;
  padding-top: 6rpx;
  min-width: 116rpx;
}

.action-step-text {
  font-size: 30rpx;
  color: #2b2f42;
  line-height: 1.7;
  word-break: break-word;
}

.action-accept {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 24rpx;
  border-left: 6rpx solid #7f56d9;
  background: #faf8ff;
  border-radius: 0 12rpx 12rpx 0;
}

.action-accept-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #7f56d9;
  letter-spacing: 2rpx;
}

.action-accept-text {
  font-size: 29rpx;
  color: #4a3b7a;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-word;
}

/* legacy action styles retained for compatibility (no longer rendered) */
.action-main {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-word;
}

.action-checks {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-line {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
  word-break: break-word;
}

.action-check {
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.6;
}

.report-actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* R84-B §18/§19 — report closing */
.report-closing {
  margin-top: 48rpx;
  padding: 28rpx 32rpx;
  background: #f6f2fd;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.report-closing-line {
  font-size: 28rpx;
  color: #5a6078;
  line-height: 1.7;
}
.report-closing-strong {
  font-size: 30rpx;
  color: #4a3b7a;
  font-weight: 700;
}

/* R84-B §20 — home return path (reuses existing routes) */
.report-home {
  margin-top: 32rpx;
}
.report-home-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #8a90a3;
  letter-spacing: 2rpx;
}
.report-home-grid {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.home-chip {
  flex: 1 1 auto;
  min-width: 180rpx;
  text-align: center;
  padding: 22rpx 16rpx;
  background: #fff;
  border: 2rpx solid #eceef3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2b2f42;
  font-weight: 600;
}

.btn-primary {
  background: #7f56d9;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
}

.btn-ghost {
  margin-top: 24rpx;
  background: #fff;
  color: #5a6078;
  border-radius: 16rpx;
  font-size: 32rpx;
}

/* ── R44: 资产/现实特异化补充（Hybrid 10Q 路径） ─────────── */
.card-specificity {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #3d3d3d;
}
.action-specificity { color: #6a6a6a; }

/* ── R48 §5: EVIDENCE_CONFLICT 专用轻量冲突态 ─────────────── */
.conflict-block {
  margin: 120rpx 48rpx 0;
  display: flex;
  flex-direction: column;
}
.conflict-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2b2b2b;
  text-align: center;
}
.conflict-body {
  margin-top: 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #4a4a4a;
  white-space: pre-line;
}
.conflict-block .btn-primary { margin-top: 56rpx; }
