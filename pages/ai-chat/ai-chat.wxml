<!-- ai-chat — v3.14 100题推荐 -->
<view class="page">
  <xsg-navbar title="直接问小事哥" showBack="{{false}}" light />

  <!-- 消息列表 -->
  <scroll-view scroll-y class="msg-list" scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}">
    <view class="msg {{item.role}}" wx:for="{{messages}}" wx:key="index">
      <view class="msg-avatar">{{item.role === 'assistant' ? '🧠' : '👤'}}</view>
      <view class="msg-bubble">
        <text>{{item.content}}</text>
        <view class="compliance-tips" wx:if="{{item.role === 'assistant'}}">系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出</view>
      </view>
    </view>
    <view class="typing" wx:if="{{sending}}">
      <view class="typing-dot"></view><view class="typing-dot"></view><view class="typing-dot"></view>
    </view>
    <view style="height:200rpx;"></view>
  </scroll-view>

  <!-- 推荐问题 — 100题池 -->
  <view class="quick-section" wx:if="{{messages.length <= 1}}">
    <view class="quick-header">
      <text class="quick-title">你可以从这里开始</text>
      <text class="quick-subtitle">100个高质量问题，每次随机推荐6个</text>
      <button class="quick-refresh-btn" bindtap="onRefreshQuestions">换一批</button>
    </view>

    <view class="quick-list">
      <view class="quick-card" wx:for="{{displayQuestions}}" wx:key="text" data-q="{{item.text}}" bindtap="onQuickAsk">
        <view class="qc-left">
          <text class="qc-icon">{{item.icon}}</text>
          <text class="qc-text">{{item.text}}</text>
        </view>
        <text class="qc-arrow">→</text>
      </view>
    </view>

    <view class="quick-error" wx:if="{{loadError && displayQuestions.length === 0}}">
      <text>{{loadError}}</text>
      <button class="quick-refresh-btn" bindtap="onRefreshQuestions">重试</button>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input class="chat-input" placeholder="直接问小事哥..." placeholder-style="color:#98A2B3;" value="{{inputValue}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="onSend"><text>↑</text></view>
  </view>
</view>
