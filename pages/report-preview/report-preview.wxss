@import '../../styles/tokens.wxss';

/* ══════════════════════════════════════
   report-preview — v3.14 5板块骨架屏
   ══════════════════════════════════════ */

.page {
  background: #F4F5F7;
  min-height: 100vh;
  padding: 0 0 48rpx;
}

/* ── 全局加载条 ── */
.global-loading-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: #F9F5FF;
  margin: 16rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EDE9FE;
}
.loading-text {
  font-size: 26rpx;
  color: #7F56D9;
  font-weight: 600;
}
.loading-dots {
  display: flex;
  gap: 6rpx;
}
.ld-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7F56D9;
  animation: dotBounce 1.2s infinite;
}
.ld-dot:nth-child(2) { animation-delay: 0.2s; }
.ld-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

/* ═══════════════════════════════
   5大板块即时框架
   ═══════════════════════════════ */
.report-blocks {
  padding: 0 32rpx;
}

.section-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

/* 致命一句话特殊底色 */
.section-card-hero {
  background: linear-gradient(135deg, #FFF1F1, #FFFBEB);
  border: 2rpx solid rgba(220, 53, 69, 0.12);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-badge {
  background: #7B57FF;
  color: #FFFFFF;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.section-title {
  font-weight: 700;
  font-size: 28rpx;
  color: #1A1F26;
}

.section-body {
  min-height: 40rpx;
}

/* ── 骨架屏闪烁动画 ── */
@keyframes pulse {
  0%   { opacity: 0.4; background-color: #E8E9EC; }
  50%  { opacity: 0.8; background-color: #DDE0E5; }
  100% { opacity: 0.4; background-color: #E8E9EC; }
}

.skeleton-line {
  animation: pulse 1.5s infinite ease-in-out;
  height: 28rpx;
  border-radius: 6rpx;
  margin-bottom: 14rpx;
  background-color: #E8E9EC;
}

/* ── 真实文本内容 ── */
.real-text {
  font-size: 28rpx;
  color: #344054;
  line-height: 1.8;
  flex: 1;
}
.real-text-bold {
  font-weight: 600;
  color: #101828;
}

/* 致命一句话文本 */
.fatal-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #DC3545;
  line-height: 1.5;
  text-shadow: 0 0 20rpx rgba(220, 53, 69, 0.08);
}

/* ── 行动建议数字列表 ── */
.da-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.da-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.da-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7F56D9, #53389E);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.da-text {
  font-size: 27rpx;
  color: #344054;
  line-height: 1.65;
  flex: 1;
}

/* ── 人格条 ── */
.personality-bar {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}
.dp-badge {
  font-size: 24rpx;
  color: #7F56D9;
  background: #F5F3FF;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* ── 合规免责 ── */
.compliance-tips {
  font-size: 22rpx !important;
  color: #8890A8 !important;
  line-height: 1.4 !important;
  margin: 24rpx 32rpx;
  padding-top: 16rpx !important;
  border-top: 1rpx dashed #E0E5ED;
  text-align: left !important;
}

/* ── 底部操作按钮 ── */
.diag-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx 48rpx;
}
.da-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.da-btn::after { border: none; }
.da-btn-retry {
  background: #F2F4F7;
  color: #667085;
}
.da-btn-share {
  background: linear-gradient(135deg, #7F56D9, #53389E);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(127, 86, 217, 0.3);
}

/* ═══════════════════════════════
   challenge_final 收费链路（不变）
   ═══════════════════════════════ */
.main-title {
  font-size: var(--font-h3);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.6;
}
.sub-title {
  font-size: var(--font-body);
  color: var(--accent-ai);
  font-weight: 600;
}

.upgrade-mask {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upgrade-modal {
  background: var(--bg-secondary);
  border-radius: var(--radius-modal);
  padding: var(--sp-48) var(--sp-32) var(--sp-32);
  width: 85vw;
  max-width: 560rpx;
  text-align: center;
  border: 1rpx solid var(--accent-gold-border);
}
.um-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: var(--sp-16);
}
.um-title {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--sp-24);
}
.um-benefits {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
  margin-bottom: var(--sp-24);
  text-align: left;
  padding: 0 var(--sp-16);
}
.umb {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.8;
}
.um-price {
  font-size: var(--font-caption);
  color: var(--accent-gold);
  display: block;
  margin-bottom: var(--sp-24);
}
.um-skip {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  background: transparent;
  border: none;
  padding: var(--sp-16);
  margin-top: var(--sp-8);
}
.um-skip::after { border: none; }
