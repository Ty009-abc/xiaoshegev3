@import '../../styles/tokens.wxss';

/* ══════════════════════════════════════
   report-preview — v3.15 全暗色主题
   统帅最终指令：深色黑客质感
   ══════════════════════════════════════ */

.page {
  background: #121620;
  min-height: 100vh;
  padding: 0 0 calc(40rpx + env(safe-area-inset-bottom)) 0;
  box-sizing: border-box;
}

/* ── R10 报告头（PAGE_TITLE + SMALL_BADGE + CORE_CONCLUSION + ONE_LINE_INTERPRETATION） ── */
.report-hero {
  padding: 36rpx 40rpx 12rpx;
  background: linear-gradient(180deg, rgba(124,92,255,0.14), rgba(18,22,32,0));
}
.rh-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #C6B1FF;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(124,92,255,0.16);
  border: 1rpx solid rgba(124,92,255,0.34);
  margin-bottom: 18rpx;
}
.rh-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  line-height: 1.25;
}
.rh-conclusion {
  display: block;
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.45;
  color: #A78BFA;
  letter-spacing: 0.5rpx;
}
.rh-sub {
  display: block;
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.75;
  color: #9AA3B8;
  font-weight: 500;
}

/* ── 全局加载条（暗色适配） ── */
.global-loading-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  background: rgba(123, 87, 255, 0.08);
  margin: 16rpx 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(123, 87, 255, 0.15);
}
.loading-text {
  font-size: 26rpx;
  color: #A78BFA;
  font-weight: 600;
}
.loading-dots {
  display: flex;
  gap: 6rpx;
}
.ld-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #A78BFA;
  animation: dotBounce 1.2s infinite;
}
.ld-dot:nth-child(2) { animation-delay: 0.2s; }
.ld-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-12rpx); opacity: 1; }
}

/* ═══════════════════════════════
   报告容器
   ═══════════════════════════════ */
.report-container {
  min-height: 100vh;
  background-color: #121620 !important;
  padding: 30rpx 30rpx 180rpx 30rpx;
  box-sizing: border-box;
}

.report-blocks {
  padding: 32rpx 32rpx calc(280rpx + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════
   R10.1 底部动作区（主：生成认知海报 / 次：重新挑战一次）
   文档正常流：位于 CARD_05 之后 · 不悬浮 / 不吸附 / 不遮挡报告内容
   ═══════════════════════════════ */
.action-bar {
  position: static;
  width: 100%;
  box-sizing: border-box;
  margin-top: 56rpx;
  padding-left: 36rpx;
  padding-right: 36rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  background: transparent;
  border-top: none;
}

/* 安全区占位（文档流内，随页面滚动） */
.safe-area-spacer {
  width: 100%;
  height: 16rpx;
}

.act-primary {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
  border: none;
  background: linear-gradient(120deg, #7C5CFF 0%, #9E5BFF 50%, #D64BFF 100%);
  box-shadow: 0 10rpx 34rpx rgba(124,92,255,0.42), 0 0 26rpx rgba(214,75,255,0.28);
}
.act-primary::after { border: none; }
.act-primary-hover { transform: scale(0.975); opacity: 0.94; }

.act-secondary {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  margin-top: 22rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 28rpx;
  color: #B7BECD;
  border: 1rpx solid rgba(148,163,184,0.32);
  background: rgba(30,41,59,0.42);
}
.act-secondary::after { border: none; }
.act-secondary-hover { opacity: 0.88; }

/* ═══════════════════════════════
   R10 海报预览
   ═══════════════════════════════ */
.poster-mask {
  position: fixed;
  inset: 0;
  z-index: 2500;
  background: rgba(4,7,14,0.86);
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-preview {
  width: 84vw;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.poster-img {
  width: 100%;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124,92,255,0.30);
}
.poster-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  width: 100%;
}
.poster-save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  border: none;
  background: linear-gradient(120deg, #7C5CFF, #D64BFF);
}
.poster-save::after { border: none; }
.poster-close {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #B7BECD;
  background: rgba(30,41,59,0.6);
  border: 1rpx solid rgba(148,163,184,0.32);
}
.poster-close::after { border: none; }

/* ═══════════════════════════════
   板块卡片 — 暗色玻璃质感
   ═══════════════════════════════ */
.section-card {
  margin-bottom: 28rpx;
  background: #191F2E;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}

/* 致命一句话特殊底色 */
.section-card-hero {
  background: rgba(255, 59, 48, 0.06) !important;
  border: 1rpx solid rgba(255, 59, 48, 0.15) !important;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

/* ── 红色板块header ── */
.red-header .section-title { color: #FF453A !important; }
.text-red { color: #FF453A !important; }
.bg-red { background: #FF3B30 !important; }

.section-badge {
  background: #7B57FF;
  color: #FFFFFF;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.section-title {
  font-weight: bold;
  font-size: 30rpx;
  color: #FFFFFF;
  animation: fadeInTitle 0.6s ease-out forwards;
}

/* ── 标题淡入动画 ── */
@keyframes fadeInTitle {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── 内容文本丝滑渐显 ── */
.fade-in {
  opacity: 1;
  transition: opacity 0.5s ease-in-out;
}
.hidden-status {
  opacity: 0;
}

.section-body {
  min-height: 40rpx;
}

/* ── 骨架屏动画（暗色适配） ── */
@keyframes pulse {
  0%   { opacity: 0.3; background-color: #22293D; }
  50%  { opacity: 0.6; background-color: #2D3548; }
  100% { opacity: 0.3; background-color: #22293D; }
}

.skeleton-line {
  animation: pulse 1.5s infinite ease-in-out;
  height: 28rpx;
  border-radius: 6rpx;
  margin-bottom: 14rpx;
  background-color: #22293D;
}

/* ── 真实文本内容 ── */
.real-text-content {
  font-size: 28rpx;
  color: #E4E8F2;
  line-height: 1.8;
  display: block;
}

/* 致命一句话文本 */
.text-red-content {
  color: #FF6B60 !important;
  font-weight: bold;
  font-size: 30rpx;
}

/* ── 行动建议数字列表（暗色） ── */
.da-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.da-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.da-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7B57FF, #5335BF);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.da-text {
  font-size: 26rpx;
  color: #D0D5E0;
  line-height: 1.6;
  flex: 1;
}

/* ── 人格条（暗色） ── */
.personality-bar {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 8rpx;
}
.dp-badge {
  font-size: 24rpx;
  color: #A78BFA;
  background: rgba(123, 87, 255, 0.10);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* ── 合规免责（暗色） ── */
.compliance-tips {
  font-size: 22rpx;
  color: #6E758A;
  text-align: center;
  margin-top: 40rpx;
  padding: 20rpx 32rpx 0;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.1);
}

/* ═══════════════════════════════
   底部按钮 — 固定吸底
   ═══════════════════════════════ */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #121620;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom)) 40rpx;
  display: flex;
  justify-content: space-between;
  z-index: 100;
  gap: 16rpx;
}

.btn-secondary {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  background: #22293D;
  color: #A0A5B5;
  border-radius: 45rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn-secondary::after { border: none; }

.btn-primary {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #7B57FF 0%, #5335BF 100%);
  color: #FFFFFF;
  border-radius: 45rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(123, 87, 255, 0.3);
  text-align: center;
}
.btn-primary::after { border: none; }
.btn-primary:active { transform: scale(0.97); opacity: 0.9; }

/* ═══════════════════════════════
   challenge_final 收费链路（保持不变）
   ═══════════════════════════════ */
.main-title {
  font-size: var(--font-h3);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.6;
}
.sub-title {
  font-size: var(--font-body);
  color: var(--accent-ai);
  font-weight: 600;
}

.upgrade-mask {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.upgrade-modal {
  background: var(--bg-secondary);
  border-radius: var(--radius-modal);
  padding: var(--sp-48) var(--sp-32) var(--sp-32);
  width: 85vw;
  max-width: 560rpx;
  text-align: center;
  border: 1rpx solid var(--accent-gold-border);
}
.um-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: var(--sp-16);
}
.um-title {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--sp-24);
}
.um-benefits {
  display: flex;
  flex-direction: column;
  gap: var(--sp-12);
  margin-bottom: var(--sp-24);
  text-align: left;
  padding: 0 var(--sp-16);
}
.umb {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.8;
}
.um-price {
  font-size: var(--font-caption);
  color: var(--accent-gold);
  display: block;
  margin-bottom: var(--sp-24);
}
.um-skip {
  font-size: var(--font-caption);
  color: var(--text-tertiary);
  background: transparent;
  border: none;
  padding: var(--sp-16);
  margin-top: var(--sp-8);
}
.um-skip::after { border: none; }
