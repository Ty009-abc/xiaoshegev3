<!-- report-preview — v3.16 统帅指令：red-card + reportData统一绑定 -->
<view class="page">

  <!-- ═══════ diagnostic 5字段报告 ═══════ -->
  <block wx:if="{{reportType==='diagnostic'}}">
    <xsg-navbar title="翻身策略报告" showBack light />

    <!-- 🚀 顶部加载条（loading先显示骨架） -->
    <view class="global-loading-bar" wx:if="{{loading}}">
      <text class="loading-text">正在加载报告...</text>
      <view class="loading-dots">
        <view class="ld-dot"></view><view class="ld-dot"></view><view class="ld-dot"></view>
      </view>
    </view>

    <!-- 5大经典翻身板块区 -->
    <view class="report-blocks">

      <!-- 01 致命一句话 ⚠️ 红色板块 -->
      <view class="section-card red-card" wx:if="{{!loading}}">
        <view class="section-header">
          <text class="section-badge bg-red">01</text>
          <text class="section-title text-red">致命一句话</text>
        </view>
        <text class="real-text-content text-red-content {{contentVisible ? 'fade-in' : 'hidden-status'}}" user-select="true">💀 {{reportData.basicInsight || '暂无数据'}}</text>
      </view>

      <!-- 02 核心问题 -->
      <view class="section-card" wx:if="{{!loading}}">
        <view class="section-header">
          <text class="section-badge">02</text>
          <text class="section-title">核心问题</text>
        </view>
        <text class="real-text-content {{contentVisible ? 'fade-in' : 'hidden-status'}}" user-select="true">{{reportData.mechanism || '暂无数据'}}</text>
      </view>

      <!-- 03 系统困局 -->
      <view class="section-card" wx:if="{{!loading}}">
        <view class="section-header">
          <text class="section-badge">03</text>
          <text class="section-title">系统困局</text>
        </view>
        <text class="real-text-content {{contentVisible ? 'fade-in' : 'hidden-status'}}" user-select="true">{{reportData.reverseReasoning || '暂无数据'}}</text>
      </view>

      <!-- 04 翻身路径 -->
      <view class="section-card" wx:if="{{!loading}}">
        <view class="section-header">
          <text class="section-badge">04</text>
          <text class="section-title">翻身路径</text>
        </view>
        <text class="real-text-content {{contentVisible ? 'fade-in' : 'hidden-status'}}" user-select="true">{{reportData.biasCorrection || '暂无数据'}}</text>
      </view>

      <!-- 05 行动建议 -->
      <view class="section-card" wx:if="{{!loading}}">
        <view class="section-header">
          <text class="section-badge">05</text>
          <text class="section-title">行动建议</text>
        </view>
        <text class="real-text-content {{contentVisible ? 'fade-in' : 'hidden-status'}}" user-select="true">{{reportData.actionPlan || '暂无数据'}}</text>
      </view>

    </view>

    <!-- 人格标识 + 合规 + 底部按钮 -->
    <block wx:if="{{!loading}}">
      <view class="personality-bar" wx:if="{{report && report.personality}}">
        <text class="dp-badge">{{report.personality.emoji}} {{report.personality.name}}视角已激活</text>
      </view>

      <view class="compliance-tips">
        系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出！
      </view>

      <view class="action-buttons">
        <button class="btn-secondary" bindtap="onRetryDiagnostic">再一次诊断</button>
        <button class="btn-primary" bindtap="generatePoster" loading="{{posterGenerating}}">
          {{posterGenerating ? '生成中...' : '生成翻身海报'}}
        </button>
      </view>
    </block>

    <xsg-empty icon="📄" title="报告加载失败" desc="请返回首页重新开始诊断" wx:elif="{{!loading && !report}}" />

    <!-- 🛠 隐藏 Canvas 2D 画布 -->
    <canvas canvas-id="posterCanvas" style="position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;overflow:hidden;"></canvas>
  </block>

  <!-- ═══════ challenge_final 报告（Stage5B：服务端权威状态机） ═══════ -->
  <block wx:else>
    <xsg-navbar title="世界模型报告" showBack />

    <!-- loading -->
    <xsg-loading text="正在加载报告..." wx:if="{{cfState==='loading'}}" />

    <!-- generating：生成中，有界重查 -->
    <block wx:elif="{{cfState==='generating'}}">
      <xsg-card type="ai" class="anim-fade-in">
        <view class="main-title mt-16">报告正在生成中…</view>
        <view class="sub-title mt-8">小事哥正在拆解你的世界模型，请稍候</view>
      </xsg-card>
      <xsg-loading text="正在生成，已查询 {{cfPollCount}}/{{cfMaxPolls}} 次…" />
    </block>

    <!-- failed：明确失败 + 受控重试 -->
    <block wx:elif="{{cfState==='failed'}}">
      <xsg-empty icon="⚠️" title="报告生成失败" desc="{{cfMsg||'请重试'}}" btnText="重试" bind:action="onRetryReport" />
    </block>

    <!-- error：缺少记录ID等 -->
    <block wx:elif="{{cfState==='error'}}">
      <xsg-empty icon="📄" title="无法加载报告" desc="{{cfMsg||'先完成一次认知挑战'}}" btnText="去挑战" bind:action="onGoChallenge" />
    </block>

    <!-- ready：服务端已确认。paid → 直接全量阅读；unpaid → 摘要 + 唯一解锁 CTA -->
    <block wx:elif="{{cfState==='ready'}}">
      <!-- 报告头（用户可见名 = 世界模型报告；副标题取自报告数据） -->
      <view class="report-hero anim-fade-in">
        <text class="rh-title">世界模型报告</text>
        <text class="rh-sub" wx:if="{{cfSummaryText}}">{{cfSummaryText}}</text>
      </view>

      <!-- UNPAID：摘要预览 + 唯一解锁 CTA（无二级入口） -->
      <block wx:if="{{locked}}">
        <report-lock-card wx:if="{{locked}}" title="完整世界模型报告已生成"
          benefits="{{['九维能力深度评分','翻身概率预测','最大认知漏洞分析','未来3年风险预警','30天定制行动建议','小事哥的最终认知暴击']}}"
          btnText="解锁完整世界模型报告 ¥9.90"
          bind:unlock="onGenerate" />
      </block>

      <!-- PAID / UNLOCKED：直接渲染完整内容，无任何购买/升级 UI -->
      <block wx:if="{{!locked}}">
        <view class="report-blocks">
          <view class="section-card red-card">
            <view class="section-header">
              <text class="section-badge bg-red">01</text>
              <text class="section-title text-red">致命一句话</text>
            </view>
            <text class="real-text-content text-red-content" user-select="true">{{reportData.basicInsight || '暂无数据'}}</text>
          </view>
          <view class="section-card">
            <view class="section-header">
              <text class="section-badge">02</text>
              <text class="section-title">核心问题</text>
            </view>
            <text class="real-text-content" user-select="true">{{reportData.mechanism || '暂无数据'}}</text>
          </view>
          <view class="section-card">
            <view class="section-header">
              <text class="section-badge">03</text>
              <text class="section-title">系统困局</text>
            </view>
            <text class="real-text-content" user-select="true">{{reportData.reverseReasoning || '暂无数据'}}</text>
          </view>
          <view class="section-card">
            <view class="section-header">
              <text class="section-badge">04</text>
              <text class="section-title">翻身路径</text>
            </view>
            <text class="real-text-content" user-select="true">{{reportData.biasCorrection || '暂无数据'}}</text>
          </view>
          <view class="section-card">
            <view class="section-header">
              <text class="section-badge">05</text>
              <text class="section-title">行动建议</text>
            </view>
            <text class="real-text-content" user-select="true">{{reportData.actionPlan || '暂无数据'}}</text>
          </view>
        </view>
      </block>
    </block>

    <!-- 升级弹窗仅在未解锁时出现。已购（locked=false）绝不再显示升级 CTA。 -->
    <view class="upgrade-mask" wx:if="{{showUpgradeModal && locked}}">
      <view class="upgrade-modal anim-fade-in">
        <text class="um-icon">🧬</text>
        <text class="um-title">你的完整世界模型已生成</text>
        <view class="um-benefits">
          <text class="umb">🧠 无限AI认知分析</text>
          <text class="umb">📄 历史认知报告库</text>
          <text class="umb">🎯 30天挑战完整解锁</text>
          <text class="umb">📜 世界规则库全权限</text>
        </view>
        <text class="um-price">升级为认知系统会员</text>
        <xsg-button type="primary" text="立即升级" bind:tapbutton="onUpgrade" />
        <button class="um-skip" bindtap="onCloseUpgrade">先看报告 →</button>
      </view>
    </view>
  </block>
</view>
