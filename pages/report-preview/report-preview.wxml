<!-- report-preview — v3.14 5板块即时骨架屏
     type=diagnostic: 框架秒跳 + 内容动态生长
     type=challenge_final: 原有收费链路 -->
<view class="page">

  <!-- ═══════ diagnostic 5字段报告（骨架屏即时渲染） ═══════ -->
  <block wx:if="{{reportType==='diagnostic'}}">
    <xsg-navbar title="翻身策略报告" showBack light />

    <!-- 🚀 顶级加载条 -->
    <view class="global-loading-bar" wx:if="{{loading}}">
      <text class="loading-text">正在加载报告...</text>
      <view class="loading-dots">
        <view class="ld-dot"></view>
        <view class="ld-dot"></view>
        <view class="ld-dot"></view>
      </view>
    </view>

    <!-- 🚀 5 大经典板块即时框架（不论 loading，立即渲染） -->
    <view class="report-blocks">

      <!-- 01 现状基本盘认知诊断 -->
      <view class="section-card">
        <view class="section-header">
          <text class="section-badge">01</text>
          <text class="section-title">现状基本盘认知诊断</text>
        </view>
        <view class="section-body">
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:92%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:100%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:68%;"></view>
          <view wx:else class="real-text">{{report.system_trap}}</view>
        </view>
      </view>

      <!-- 02 核心底层因果机理 -->
      <view class="section-card">
        <view class="section-header">
          <text class="section-badge">02</text>
          <text class="section-title">核心底层因果机理</text>
        </view>
        <view class="section-body">
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:88%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:95%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:72%;"></view>
          <view wx:else class="real-text">{{report.core_problem}}</view>
        </view>
      </view>

      <!-- 03 致命一句话（保留原 hero 样式） -->
      <view class="section-card section-card-hero">
        <view class="section-header">
          <text class="section-badge">03</text>
          <text class="section-title">致命一句话</text>
        </view>
        <view class="section-body">
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:80%;height:56rpx;"></view>
          <view wx:else class="fatal-text">{{report.fatal_sentence}}</view>
        </view>
      </view>

      <!-- 04 翻身策略路径 -->
      <view class="section-card">
        <view class="section-header">
          <text class="section-badge">04</text>
          <text class="section-title">翻身策略路径</text>
        </view>
        <view class="section-body">
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:90%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:100%;"></view>
          <view wx:if="{{loading}}" class="skeleton-line pulse-animation" style="width:75%;"></view>
          <view wx:else class="real-text real-text-bold">{{report.strategy_path}}</view>
        </view>
      </view>

      <!-- 05 行动建议 -->
      <view class="section-card">
        <view class="section-header">
          <text class="section-badge">05</text>
          <text class="section-title">行动建议</text>
        </view>
        <view class="section-body">
          <block wx:if="{{loading}}">
            <view class="skeleton-line pulse-animation" style="width:96%;"></view>
            <view class="skeleton-line pulse-animation" style="width:85%;"></view>
            <view class="skeleton-line pulse-animation" style="width:70%;"></view>
          </block>
          <view wx:else class="da-list">
            <view class="da-item" wx:for="{{report.advice}}" wx:key="*this">
              <text class="da-num">{{index+1}}</text>
              <text class="da-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

    </view>

    <!-- 报告加载完成后的内容区（非loading态才显示） -->
    <block wx:if="{{!loading && report}}">
      <!-- 人格标识 -->
      <view class="personality-bar">
        <text class="dp-badge">{{report.personality.emoji}} {{report.personality.name}}视角已激活</text>
      </view>

      <!-- 合规免责 -->
      <view class="compliance-tips">系统提示：当前页面呈现的内容由自动化算法与人工智能生成技术推演得出</view>

      <!-- 底部操作 -->
      <view class="diag-actions">
        <button class="da-btn da-btn-retry" bindtap="onRetryDiagnostic">再来一次诊断</button>
        <button class="da-btn da-btn-share" open-type="share">分享翻身策略</button>
      </view>
    </block>

    <xsg-empty icon="📄" title="报告加载失败" desc="请返回首页重新开始诊断" wx:elif="{{!loading && !report}}" />
  </block>

  <!-- ═══════ challenge_final 报告（原有收费链路，不变） ═══════ -->
  <block wx:else>
    <xsg-navbar title="AI诊断报告" showBack />
    <xsg-loading text="正在加载报告..." wx:if="{{loading}}" />

    <block wx:elif="{{report}}">
      <xsg-card type="ai" class="anim-fade-in">
        <xsg-tag text="AI诊断" type="ai" />
        <view class="main-title mt-16">{{report.summary||report.oneSentence||'你的认知画像已生成'}}</view>
        <view class="sub-title mt-8" wx:if="{{report.type}}">{{report.type}}</view>
      </xsg-card>

      <report-lock-card wx:if="{{locked}}" title="完整AI诊断报告已生成"
        benefits="{{['世界模型深度评分','翻身概率预测','最大认知漏洞分析','未来3年风险预警','30天定制行动建议','小事哥的最终认知暴击']}}"
        bind:unlock="onUnlock" />

      <xsg-button wx:if="{{locked}}" type="ai" text="9.9元生成完整报告" bind:tapbutton="onGenerate" class="anim-fade-in anim-delay-2" />
      <xsg-button wx:if="{{!locked}}" type="gold" text="查看完整报告" bind:tapbutton="goFull" class="anim-fade-in" />
    </block>

    <xsg-empty icon="📄" title="暂无报告" desc="先完成一次认知挑战" btnText="去挑战" wx:elif="{{!loading&&!report}}" />

    <ai-generating id="aiGen" visible="{{showGenerating}}" bind:done="onGenerateDone" />

    <view class="upgrade-mask" wx:if="{{showUpgradeModal}}">
      <view class="upgrade-modal anim-fade-in">
        <text class="um-icon">🧬</text>
        <text class="um-title">你的完整世界模型已生成</text>
        <view class="um-benefits">
          <text class="umb">🧠 无限AI认知分析</text>
          <text class="umb">📄 历史认知报告库</text>
          <text class="umb">🎯 30天挑战完整解锁</text>
          <text class="umb">📜 世界规则库全权限</text>
        </view>
        <text class="um-price">升级为认知系统会员</text>
        <xsg-button type="primary" text="立即升级" bind:tapbutton="onUpgrade" />
        <button class="um-skip" bindtap="onCloseUpgrade">先看报告 →</button>
      </view>
    </view>
  </block>
</view>
