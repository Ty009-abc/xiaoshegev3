/* pages/v21-questionnaire-test/v21-questionnaire-test.wxss */
.page {
  min-height: 100vh;
  background: #f4f5f7;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  color: #1a1d26;
}

/* ── intro ── */
.intro { padding: 40rpx 0; }
.badge {
  display: inline-block;
  background: #7f56d9;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  letter-spacing: 2rpx;
}
.title { font-size: 40rpx; font-weight: 700; margin: 24rpx 0 16rpx; }
.desc { font-size: 28rpx; color: #5a6078; line-height: 1.6; margin-bottom: 24rpx; }
.notice {
  font-size: 26rpx; color: #b54708; background: #fef3e2;
  padding: 16rpx 20rpx; border-radius: 8rpx; margin-bottom: 40rpx;
}

/* ── quiz ── */
.progress-wrap { margin-bottom: 32rpx; }
.progress-label { font-size: 24rpx; color: #5a6078; margin-bottom: 12rpx; }
.progress-bar { height: 12rpx; background: #e6e8ef; border-radius: 6rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #7f56d9; border-radius: 6rpx; transition: width 0.2s; }

.q-prompt { font-size: 32rpx; font-weight: 600; line-height: 1.5; margin-bottom: 32rpx; }

.options { display: flex; flex-direction: column; gap: 20rpx; }
.option {
  display: flex; align-items: flex-start; gap: 20rpx;
  background: #fff; border: 2rpx solid #e6e8ef; border-radius: 16rpx;
  padding: 24rpx; transition: all 0.15s;
}
.option-selected { border-color: #7f56d9; background: #f6f2ff; }
.option-id {
  flex-shrink: 0; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #eef0f6; color: #5a6078; font-size: 26rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.option-selected .option-id { background: #7f56d9; color: #fff; }
.option-text { font-size: 28rpx; line-height: 1.5; }

.nav { display: flex; gap: 20rpx; margin-top: 48rpx; }

/* ── result ── */
.result { padding: 40rpx 0; }
.result-error { color: #d92d20; font-size: 28rpx; margin-bottom: 24rpx; }
.result-row { display: flex; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e6e8ef; font-size: 28rpx; }
.result-row .k { color: #5a6078; width: 220rpx; flex-shrink: 0; }
.result-row .v { word-break: break-all; }
.hint { font-size: 24rpx; color: #98a2b3; margin: 24rpx 0; }

/* ── buttons ── */
.btn-primary {
  flex: 1; background: #7f56d9; color: #fff; border-radius: 12rpx;
  font-size: 30rpx; padding: 20rpx 0; border: none;
}
.btn-primary[disabled] { background: #c4c7d0; color: #fff; }
.btn-ghost {
  flex: 1; background: #fff; color: #5a6078; border: 2rpx solid #e6e8ef;
  border-radius: 12rpx; font-size: 30rpx; padding: 20rpx 0;
}
.btn-ghost[disabled] { color: #c4c7d0; }

.intro .btn-primary, .result .btn-ghost { margin-top: 16rpx; flex: none; width: 100%; }
