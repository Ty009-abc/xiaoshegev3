.dpp-page { padding: 24rpx; }
.dpp-warn { background: #fff3cd; border: 2rpx solid #ffcc00; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx; }
.dpp-warn-title { display: block; color: #8a6d00; font-weight: 700; font-size: 28rpx; margin-bottom: 10rpx; }
.dpp-warn-text { display: block; color: #6b5500; font-size: 24rpx; line-height: 1.5; }
.dpp-body { padding: 8rpx; }
.dpp-btn { background: #1a73e8; color: #fff; border-radius: 10rpx; font-size: 30rpx; }
.dpp-btn2 { margin-top: 20rpx; background: #eee; color: #333; border-radius: 10rpx; font-size: 28rpx; }
.dpp-state { margin-top: 20rpx; color: #666; font-size: 26rpx; }
.dpp-err { margin-top: 20rpx; color: #d93025; font-size: 26rpx; }
.dpp-card { margin-top: 24rpx; background: #f7f7f7; border-radius: 12rpx; padding: 16rpx 20rpx; }
.dpp-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #e5e5e5; }
.dpp-k { color: #888; font-size: 24rpx; }
.dpp-v { color: #222; font-size: 24rpx; max-width: 60%; word-break: break-all; text-align: right; }
.dpp-note { margin-top: 20rpx; color: #0b8043; font-size: 26rpx; font-weight: 600; }
.dpp-raw { display: block; margin-top: 20rpx; color: #555; font-size: 22rpx; white-space: pre-wrap; word-break: break-all; }
